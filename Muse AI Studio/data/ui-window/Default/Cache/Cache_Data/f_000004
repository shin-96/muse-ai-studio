/* User-written 4–30 scene storyboard batches with horizontal left-image / right-prompt layout, 1->N continuity, and theatrical postproduction. */
(() => {
  'use strict';
  const $id = (id) => document.getElementById(id);
  const MIN_SCENES = 4;
  const MAX_SCENES = 30;
  const LANGS = [
    ['vi', 'Tiếng Việt'],
    ['en', 'English (Tiếng Anh Quốc tế)'],
    ['en-US', 'English - US (Tiếng Anh Mỹ)'],
    ['en-GB', 'English - UK (Tiếng Anh Anh Quốc)'],
    ['en-AU', 'English - Australia (Tiếng Anh Úc)'],
    ['en-CA', 'English - Canada (Tiếng Anh Canada)'],
    ['fr-CA', 'Français - Canada (Tiếng Pháp Canada)'],
    ['ja', '日本語 (Tiếng Nhật)'],
    ['ko', '한국어 (Tiếng Hàn)'],
    ['es', 'Español (Tiếng Tây Ban Nha)'],
    ['de', 'Deutsch (Tiếng Đức)'],
    ['fr', 'Français (Tiếng Pháp)'],
    ['it', 'Italiano (Tiếng Ý)'],
    ['nl', 'Nederlands (Tiếng Hà Lan)'],
    ['sv', 'Svenska (Tiếng Thụy Điển)'],
    ['no', 'Norsk (Tiếng Na Uy)'],
    ['da', 'Dansk (Tiếng Đan Mạch)'],
    ['fi', 'Suomi (Tiếng Phần Lan)'],
    ['de-CH', 'Deutsch - Schweiz (Thụy Sĩ)'],
    ['en-SG', 'English - Singapore (Singapore)'],
    ['ar-AE', 'العربية - الإمارات (UAE)'],
    ['zh-TW', '繁體中文 (Đài Loan / Hồng Kông)'],
    ['zh', '中文 (Tiếng Trung phổ thông)'],
    ['pt', 'Português (Bồ Đào Nha – Brazil)'],
    ['th', 'ภาษาไทย (Tiếng Thái)'],
    ['id', 'Bahasa Indonesia'],
    ['ru', 'Русский (Tiếng Nga)'],
    ['tr', 'Türkçe (Thổ Nhĩ Kỳ)'],
    ['hi', 'हिन्दी (Tiếng Hindi)'],
    ['ar', 'العربية (Tiếng Ả Rập)'],
  ];
  const MOODS = [
    ['auto', 'Tự động theo mạch phim'],
    ['cinematic', 'Điện ảnh ngoài rạp'],
    ['action', 'Hành động sống động'],
    ['emotional', 'Cảm xúc sâu lắng'],
    ['tension', 'Kịch tính hồi hộp'],
    ['climax', 'Cao trào bùng nổ'],
    ['warm', 'Ấm áp trong trẻo'],
    ['mystery', 'Bí ẩn cuốn hút'],
  ];
  const sceneId = () => 'scene_' + Math.random().toString(36).slice(2, 11);
  const blankScene = (characters = ['character_1'], index = 1) => ({
    id: sceneId(),
    prompt: '',
    character_ids: [...characters],
    storyboard_file: '',
    storyboard_name: '',
    storyboard_label: `Storyboard cảnh ${String(index).padStart(2, '0')}`,
    storyboard_url: '',
    continuity_prev: '',
    continuity_next: '',
    mood: 'auto',
  });
  const defaults = {
    title: '',
    ratio: '16:9',
    lang: 'vi',
    accent: 'north',
    parallel: 10,
    same_character: true,
    same_voice: true,
    continuity_lock: true,
    auto_postproduce: true,
    reference_images: [],
    characters: [
      {
        id: 'character_1',
        name: 'Nhân vật 1',
        description: 'Giữ đồng nhất 100% khuôn mặt, kiểu tóc, trang phục và thần thái theo ảnh tham chiếu xuyên suốt mọi phân cảnh.',
        voice: 'Giọng trưởng thành, rõ chữ, tốc độ vừa, âm sắc ấm và giàu cảm xúc điện ảnh; giữ nguyên đồng nhất ở mọi phân cảnh.',
        reference_file: '',
      },
    ],
    scenes: Array.from({ length: 10 }, (_, idx) => blankScene(['character_1'], idx + 1)),
  };
  const restored = store.get('sceneBatchDraft', null);
  const clampScenes = (list, chars) => {
    const arr = Array.isArray(list) ? list.slice(0, MAX_SCENES) : [];
    while (arr.length < MIN_SCENES) arr.push(blankScene(chars, arr.length + 1));
    return arr.map((s, idx) => ({ ...blankScene(chars, idx + 1), ...s }));
  };
  const initialDraft = restored && Array.isArray(restored.scenes)
    ? { ...defaults, ...restored, scenes: clampScenes(restored.scenes, (restored.characters || defaults.characters).map((c) => c.id)) }
    : defaults;
  const B = {
    draft: initialDraft,
    projects: [],
    detail: null,
    current: store.get('sceneBatchCurrent', null),
    creating: true,
    loading: false,
    busy: false,
    uploading: 0,
    timer: null,
    error: '',
    capacity: null,
    editView: null,
    edit: null,
    editDirty: false,
    music: null,
    targetSceneUploadIndex: null,
  };
  const root = $id('sceneBatchWorkspace'), page = $id('page-reference-film');
  const active = () => S.page === 'reference-film' && window.ReferenceWorkspaceMode === 'scenes';
  const phase = (v) => ({
    draft: 'Chưa chạy', queued: 'Đang chờ', pending: 'Đang chờ', running: 'Đang chạy', processing: 'Đang xử lý',
    done: 'Hoàn thành', completed: 'Hoàn thành', success: 'Hoàn thành', failed: 'Lỗi', error: 'Lỗi',
    stopped: 'Đã dừng', cancelled: 'Đã dừng', partial: 'Có cảnh cần xử lý', rendering: 'Đang dựng phim',
    idle: 'Chưa dựng', interrupted: 'Đã gián đoạn', cancelling: 'Đang dừng',
  }[v] || v || 'Chưa chạy');
  const opt = (values, selected) => values.map(([id, label]) => `<option value="${esc(id)}" ${String(id) === String(selected) ? 'selected' : ''}>${esc(label)}</option>`).join('');
  const fileUrl = (file) => '/files?p=' + encodeURIComponent(file);
  const refUrl = (r) => r?.local || r?.url || '';
  const isBusy = (d) => ['running', 'queued', 'processing', 'rendering'].includes(d?.status);
  const notify = (error) => toast(error.message || String(error), 'error', 7000);

  function findImageUrl(fileId) {
    if (!fileId) return '';
    const shared = B.draft.reference_images.find((r) => r.file === fileId);
    if (shared) return refUrl(shared);
    const fromScene = B.draft.scenes.find((s) => s.storyboard_file === fileId && s.storyboard_url);
    return fromScene ? fromScene.storyboard_url : '';
  }

  function collect() {
    if (!$id('sbTitle')) return B.draft;
    const d = {
      ...B.draft,
      title: $id('sbTitle').value.trim(),
      ratio: $id('sbRatio').value,
      lang: $id('sbLang').value,
      accent: $id('sbAccent').value,
      parallel: Number($id('sbParallel').value) || 10,
      same_character: $id('sbSameCharacter').checked,
      same_voice: $id('sbSameVoice').checked,
      continuity_lock: $id('sbContinuityLock') ? $id('sbContinuityLock').checked : true,
      auto_postproduce: $id('sbAutoPostproduce') ? $id('sbAutoPostproduce').checked : true,
    };
    d.characters = [...root.querySelectorAll('[data-sb-character]')].map((el) => ({
      id: el.dataset.sbCharacter,
      name: el.querySelector('[data-char-name]').value.trim(),
      description: el.querySelector('[data-char-description]').value.trim(),
      voice: el.querySelector('[data-char-voice]').value.trim(),
      reference_file: el.querySelector('[data-char-ref]').value,
    }));
    d.scenes = [...root.querySelectorAll('[data-sb-scene]')].map((el, idx) => {
      const prev = B.draft.scenes[idx] || {};
      const sbFile = el.querySelector('[data-scene-sb-file]')?.value || prev.storyboard_file || '';
      const sbLabel = el.querySelector('[data-scene-sb-label]')?.value.trim() || prev.storyboard_label || `Storyboard cảnh ${String(idx + 1).padStart(2, '0')}`;
      return {
        id: el.dataset.sbScene,
        prompt: el.querySelector('[data-scene-prompt]') ? el.querySelector('[data-scene-prompt]').value.trim() : el.querySelector('textarea').value.trim(),
        character_ids: [...el.querySelectorAll('[data-scene-cast]:checked')].map((input) => input.value),
        storyboard_file: sbFile,
        storyboard_name: prev.storyboard_name || sbFile,
        storyboard_label: sbLabel,
        storyboard_url: findImageUrl(sbFile) || prev.storyboard_url || '',
        continuity_prev: el.querySelector('[data-scene-cont-prev]')?.value.trim() || '',
        continuity_next: el.querySelector('[data-scene-cont-next]')?.value.trim() || '',
        mood: el.querySelector('[data-scene-mood]')?.value || prev.mood || 'auto',
      };
    });
    d.reference_images = B.draft.reference_images;
    return d;
  }

  function saveDraft() {
    B.draft = collect();
    store.set('sceneBatchDraft', B.draft);
    refreshDraftCapacity();
  }

  function errorBox(message) {
    const box = $id('sbError');
    if (box) {
      box.hidden = !message;
      box.textContent = message;
    }
  }

  function shell() {
    if (!$id('sbMain')) {
      root.innerHTML = '<div class="sb-wrap"><aside class="sb-list card" id="sbList" aria-label="Dự án phân cảnh"></aside><main class="sb-main" id="sbMain"></main></div>';
    }
  }

  function list() {
    const el = $id('sbList');
    if (!el) return;
    el.innerHTML = `<button type="button" class="sv-item ${B.creating ? 'on' : ''}" data-sb-new>${ic('plus')}<b>Dàn phân cảnh mới</b><small>${MIN_SCENES}–${MAX_SCENES} phân cảnh · Storyboard &amp; Phim</small></button><span class="rf-list-label">Dự án · ${B.projects.length}</span>${B.error ? `<div class="rf-list-status rf-list-error">${esc(B.error)}</div>` : ''}${B.projects.map((p) => `<button type="button" class="sv-item ${!B.creating && String(B.current) === String(p.id) ? 'on' : ''}" data-sb-project="${esc(p.id)}"><b>${esc(p.title || 'Dàn phân cảnh')}</b><small>${p.scene_count ?? p.scenes?.length ?? p.counts?.total ?? ''} cảnh · ${esc(phase(p.status))}</small></button>`).join('')}${!B.projects.length ? '<p class="rf-list-status">Chọn từ 4 đến 30 phân cảnh: bên trái là ảnh tham chiếu Storyboard, bên phải là câu lệnh từng phân cảnh khớp liền mạch như phim.</p>' : ''}`;
  }

  function sceneCountOptions(selectedCount) {
    const counts = [];
    for (let c = MIN_SCENES; c <= MAX_SCENES; c++) counts.push([String(c), `${c} phân cảnh`]);
    return opt(counts, String(selectedCount));
  }

  function createView() {
    const d = B.draft;
    const countPresets = [4, 6, 8, 10, 12, 15, 20, 24, 30];
    $id('sbMain').innerHTML = `<div class="sb-create">
      <section class="card">
        <div class="sb-head">
          <div>
            <h2>Làm Phim Bằng Ảnh Tham Chiếu Storyboard (${MIN_SCENES}–${MAX_SCENES} Phân Cảnh)</h2>
            <p>Dàn hàng ngang trực quan: <b>Bên trái là ảnh tham chiếu Storyboard của từng phân cảnh</b> — <b>Bên phải là Prompt câu lệnh phân cảnh đó</b>. Cảnh cuối của phân cảnh 1 tự động khớp làm mở đầu của phân cảnh 2 và nối mượt đến phân cảnh thứ N, đồng nhất nhân vật &amp; giọng nói, ghép nhạc nền điện ảnh ngoài rạp và phụ đề đa ngôn ngữ.</p>
          </div>
          ${ic('clapper')}
        </div>
        <div class="sb-flow">
          <span><b>1</b>Chọn ${MIN_SCENES}–${MAX_SCENES} phân cảnh</span><i>→</i>
          <span><b>2</b>Trái: Ảnh Storyboard · Phải: Prompt</span><i>→</i>
          <span><b>3</b>Khớp mượt Cảnh 1 → Cảnh N</span><i>→</i>
          <span><b>4</b>Nối phim, Nhạc rạp &amp; Phụ đề Đa Quốc Gia</span>
        </div>
      </section>

      <section class="card">
        <div class="sb-section-head">
          <h3>${ic('users')}Đồng nhất nhân vật, giọng nói &amp; Ảnh gốc tham chiếu</h3>
          <button type="button" class="btn ghost xs" id="sbAddCharacter">${ic('plus')}Thêm nhân vật</button>
        </div>
        <div class="sb-checks">
          <label class="chk"><input type="checkbox" id="sbSameCharacter" ${d.same_character ? 'checked' : ''}><span>Đồng nhất ngoại hình nhân vật trong mọi phân cảnh</span></label>
          <label class="chk"><input type="checkbox" id="sbSameVoice" ${d.same_voice ? 'checked' : ''}><span>Đồng nhất giọng nói cố định trong mọi phân cảnh</span></label>
          <label class="chk"><input type="checkbox" id="sbContinuityLock" ${d.continuity_lock !== false ? 'checked' : ''}><span>Khóa mạch nối: Cảnh cuối phân cảnh trước = Mở đầu phân cảnh sau (1 → N)</span></label>
          <label class="chk"><input type="checkbox" id="sbAutoPostproduce" ${d.auto_postproduce !== false ? 'checked' : ''}><span>Chuẩn bị hậu kỳ rạp: nối mượt, nhạc nền theo cảnh &amp; phụ đề đa ngôn ngữ</span></label>
        </div>
        <input type="file" id="sbRefFiles" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" multiple hidden>
        <div class="rf-drop" id="sbRefDrop" role="button" tabindex="0" aria-label="Chọn ảnh tham chiếu gốc nhân vật hoặc bối cảnh" style="margin-top:12px">
          ${ic('upload-cloud')}
          <div>
            <strong>Tải ảnh gốc nhân vật / bối cảnh chung (1–4 ảnh) hoặc tải ảnh Storyboard riêng ở từng phân cảnh bên dưới</strong>
            <p>PNG, JPG, WebP · tối đa 20 MB/ảnh · Giữ nguyên khuôn mặt, trang phục và phong cách xuyên suốt bộ phim</p>
          </div>
          <span class="btn ghost sm">Chọn ảnh gốc</span>
        </div>
        <div class="sb-ref-grid">${d.reference_images.map((r, i) => `<div class="sb-ref"><img src="${esc(refUrl(r))}" alt="Ảnh tham chiếu ${i + 1}"><div><input class="input" data-sb-ref-label="${i}" aria-label="Tên ảnh ${i + 1}" value="${esc(r.label || '')}" placeholder="Tên nhân vật / bối cảnh"><select class="input select" data-sb-ref-role="${i}" aria-label="Vai trò ảnh ${i + 1}">${opt([['character', 'Nhân vật'], ['location', 'Bối cảnh'], ['prop', 'Đạo cụ / sản phẩm'], ['style', 'Storyboard / Phong cách']], r.role || 'character')}</select><small>${esc(r.name || r.file)}</small></div><button type="button" class="icon-btn" data-sb-remove-ref="${i}" aria-label="Bỏ ảnh ${i + 1}">${ic('x')}</button></div>`).join('')}</div>
        <p class="hint" id="sbUploadStatus">${B.uploading ? 'Đang tải ảnh lên tool…' : 'Mỗi nhân vật được khóa hồ sơ ngoại hình và giọng nói cố định xuyên suốt từ phân cảnh 1 đến phân cảnh thứ N.'}</p>
        <div class="sb-profile-list">${d.characters.map((c) => `<article class="sb-profile" data-sb-character="${esc(c.id)}"><label>Tên nhân vật<input class="input" data-char-name value="${esc(c.name)}" placeholder="Ví dụ: Mai"></label><label>Ngoại hình cố định xuyên suốt<textarea class="input" data-char-description rows="2" placeholder="Khuôn mặt, kiểu tóc, trang phục…">${esc(c.description || '')}</textarea></label><label>Giọng nói đồng nhất xuyên suốt<textarea class="input" data-char-voice rows="2" placeholder="Nam / nữ, tuổi giọng, âm sắc, cảm xúc thoại…">${esc(c.voice || '')}</textarea></label><label>Ảnh nhân vật<select class="input select" data-char-ref><option value="">Theo mô tả / Storyboard</option>${d.reference_images.map((r, i) => `<option value="${esc(r.file)}" ${r.file === c.reference_file ? 'selected' : ''}>${esc(r.label || r.name || 'Ảnh ' + (i + 1))}</option>`).join('')}</select></label><button type="button" class="icon-btn" data-sb-remove-character="${esc(c.id)}" aria-label="Bỏ nhân vật ${esc(c.name)}">${ic('x')}</button></article>`).join('')}</div>
      </section>

      <section class="card">
        <div class="sb-section-head">
          <h3>${ic('sliders')}Cài đặt bộ phim &amp; Ngôn ngữ</h3>
          <small>Hỗ trợ Tiếng Việt, Anh, Anh Mỹ, Nhật, Hàn, Tây Ban Nha, Úc, Canada &amp; các nước thu nhập cao</small>
        </div>
        <div class="sb-grid">
          <label class="field sb-span-two"><span>Tên bộ phim / dự án phân cảnh</span><input class="input" id="sbTitle" value="${esc(d.title || '')}" placeholder="Ví dụ: Hành Trình Dưới Ánh Hoàng Hôn"></label>
          <label class="field"><span>Tỷ lệ khung hình</span><select class="input select" id="sbRatio">${opt([['16:9', '16:9 · Phim Rạp / YouTube'], ['9:16', '9:16 · Shorts / Reels / TikTok'], ['1:1', '1:1 · Vuông']], d.ratio)}</select></label>
          <label class="field"><span>Ngôn ngữ thoại chính</span><select class="input select" id="sbLang">${opt(LANGS, d.lang)}</select></label>
          <label class="field"><span>Giọng vùng (Tiếng Việt)</span><select class="input select" id="sbAccent">${opt([['north', 'Bắc · Hà Nội'], ['south', 'Nam · Sài Gòn'], ['central', 'Trung · Huế']], d.accent)}</select></label>
          <label class="field"><span>Số luồng chạy đồng thời</span><select class="input select" id="sbParallel">${[4, 6, 8, 10, 15, 20, 25, 30].map((n) => `<option value="${n}" ${Number(d.parallel) === n ? 'selected' : ''}>${n} phân cảnh</option>`).join('')}</select></label>
        </div>
        <p class="hint" id="sbCapacity" style="margin-top:10px">${esc(draftCapacityText(B.capacity, d.parallel))}</p>
      </section>

      <section class="card">
        <div class="sb-section-head">
          <h3>${ic('list-ordered')}Dàn Hàng Ngang Storyboard &amp; Prompt Từng Phân Cảnh (${d.scenes.length} phân cảnh · Chọn từ ${MIN_SCENES} đến ${MAX_SCENES})</h3>
          <small>Bên trái: Ảnh tham chiếu Storyboard · Bên phải: Câu lệnh phân cảnh &amp; Khớp nối cảnh 1 → N</small>
        </div>
        <div class="sb-scene-toolbar">
          <label>Chọn số phân cảnh (4–30)
            <select class="input select" id="sbSceneCountSelect" aria-label="Chọn nhanh số phân cảnh">${sceneCountOptions(d.scenes.length)}</select>
          </label>
          <label>Hoặc nhập số
            <input class="input" id="sbSceneCount" type="number" min="${MIN_SCENES}" max="${MAX_SCENES}" value="${d.scenes.length}">
          </label>
          <button type="button" class="btn ghost xs" id="sbResizeScenes">Áp dụng</button>
          <button type="button" class="btn primary-alt xs" id="sbUploadStoryboards">${ic('image')}Chọn loạt ảnh Storyboard (Cảnh 1 → ${d.scenes.length})</button>
          <button type="button" class="btn ghost xs" id="sbAutoContinuity">${ic('sparkles')}Tự khớp mạch nối Cảnh 1 → ${d.scenes.length}</button>
          <button type="button" class="btn ghost xs" id="sbPasteScenes">${ic('copy')}Dán nhiều câu lệnh</button>
          <button type="button" class="btn ghost xs" id="sbImportScenes">${ic('upload')}Nhập .txt</button>
          <input type="file" id="sbScenesFile" accept=".txt,text/plain" hidden>
          <input type="file" id="sbStoryboardBatchFiles" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" multiple hidden>
          <input type="file" id="sbSingleSceneStoryboardFile" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" hidden>
        </div>
        <div class="sb-preset-pills" role="group" aria-label="Chọn nhanh số lượng phân cảnh">
          <span>Chọn nhanh:</span>
          ${countPresets.map((n) => `<button type="button" class="btn ghost xs ${d.scenes.length === n ? 'on' : ''}" data-sb-preset-count="${n}">${n} cảnh</button>`).join('')}
        </div>
        <p class="hint">Mỗi hàng ngang gồm: <b>Cột Trái</b> là ảnh Storyboard tham chiếu của đúng phân cảnh đó; <b>Cột Phải</b> là Prompt câu lệnh, thoại và khóa nối cảnh (cảnh cuối của phân cảnh trước là mở đầu của phân cảnh tiếp theo, liền mạch như 1 bộ phim).</p>
        <div class="sb-scenes sb-scenes-horizontal">${sceneCards(d)}</div>
        <div class="sb-actions" style="margin-top:16px">
          <button type="button" class="btn primary-alt" id="sbStart">${ic('play')}Tạo ${d.scenes.length} phân cảnh phim</button>
          <button type="button" class="btn ghost" id="sbSave">${ic('check')}Lưu dự án, chạy sau</button>
          <span class="hint">Tổng thời lượng dự kiến: ${formatSeconds(d.scenes.length * 15)} (${d.scenes.length} phân cảnh liên hoàn)</span>
        </div>
        <div class="sb-alert sb-error" id="sbError" role="alert" hidden style="margin-top:12px"></div>
      </section>
    </div>`;
    lockCreate();
    bindDrop();
  }

  function resolveScenePreview(d, s, i) {
    if (s.storyboard_url) return s.storyboard_url;
    if (s.storyboard_file) {
      const found = findImageUrl(s.storyboard_file);
      if (found) return found;
    }
    if (d.reference_images && d.reference_images.length) {
      const fallback = d.reference_images[i % d.reference_images.length];
      return refUrl(fallback);
    }
    return '';
  }

  function continuityBadgeText(i, total) {
    const num = String(i + 1).padStart(2, '0');
    const prev = String(i).padStart(2, '0');
    const next = String(i + 2).padStart(2, '0');
    if (i === 0 && total > 1) return `Mở đầu Phim (Cảnh 01) → Cảnh cuối khớp sang Mở đầu Cảnh 02`;
    if (i === total - 1 && total > 1) return `Khớp từ Cảnh cuối Cảnh ${prev} → Mở đầu Cảnh ${num} (Kết phim hoàn chỉnh)`;
    return `Cảnh cuối Cảnh ${prev} = Mở đầu Cảnh ${num} → Cảnh cuối khớp sang Cảnh ${next}`;
  }

