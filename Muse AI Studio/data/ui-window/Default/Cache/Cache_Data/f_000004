  function autoLinkContinuity() {
    saveDraft();
    const scenes = B.draft.scenes;
    for (let i = 0; i < scenes.length; i++) {
      const cur = scenes[i];
      const prev = i > 0 ? scenes[i - 1] : null;
      const next = i < scenes.length - 1 ? scenes[i + 1] : null;
      if (prev) {
        const prevText = (prev.prompt || `Phân cảnh ${i}`).trim();
        const lastSentence = prevText.split(/(?<=[.!?…。])\s+/).filter(Boolean).pop() || prevText;
        cur.continuity_prev = `Tiếp nối trực tiếp khung hình cuối của Phân cảnh ${String(i).padStart(2, '0')} (${lastSentence.slice(0, 120)}), giữ nguyên vị trí nhân vật, ánh sáng và cảm xúc.`;
      } else {
        cur.continuity_prev = `Mở đầu bộ phim từ khung hình ảnh Storyboard Phân cảnh 01, thiết lập không gian và thần thái nhân vật đồng nhất.`;
      }
      if (next) {
        const nextText = (next.prompt || `Phân cảnh ${i + 2}`).trim();
        const firstSentence = nextText.split(/(?<=[.!?…。])\s+/).filter(Boolean)[0] || nextText;
        cur.continuity_next = `Khung hình cuối Phân cảnh ${String(i + 1).padStart(2, '0')} chuyển mượt làm cảnh mở đầu Phân cảnh ${String(i + 2).padStart(2, '0')} (${firstSentence.slice(0, 120)}).`;
      } else {
        cur.continuity_next = `Khép lại trọn vẹn dòng chảy cảm xúc của bộ phim ở cuối Phân cảnh ${String(i + 1).padStart(2, '0')}.`;
      }
    }
    store.set('sceneBatchDraft', B.draft);
    createView();
    toast(`Đã tự động khớp mạch nối liên hoàn từ Phân cảnh 01 đến Phân cảnh ${String(scenes.length).padStart(2, '0')}.`, 'success');
  }

  function capacityText(c) {
    if (!c) return 'Tool sẽ kiểm tra năng lực tài khoản và luồng video khi bắt đầu.';
    const values = [];
    for (const [key, label] of [['requested', 'Yêu cầu'], ['effective_cap', 'Có thể chạy tối đa'], ['ready_video_slots', 'Luồng video sẵn sàng'], ['global_total_threads', 'Luồng tổng']]) {
      if (c[key] != null) values.push(label + ': ' + c[key]);
    }
    return values.join(' · ') || c.note || 'Số cảnh chạy thực tế theo tài khoản và cài đặt luồng.';
  }

  function draftCapacityText(c, requested) {
    const values = ['Yêu cầu: ' + (Number(requested) || 10)];
    if (!c) return values.join('') + ' · Tool sẽ kiểm tra năng lực tài khoản khi bắt đầu.';
    const current = Math.min(Number(c.global_total_threads) || 0, Number(c.ready_video_slots) || 0);
    values.push('Hiện có thể chạy tối đa: ' + current);
    if (c.ready_video_slots != null) values.push('Luồng video sẵn sàng: ' + c.ready_video_slots);
    if (c.global_total_threads != null) values.push('Luồng tổng hiện tại: ' + c.global_total_threads);
    return values.join(' · ');
  }

  function refreshDraftCapacity() {
    const el = $id('sbCapacity');
    if (B.creating && el) el.textContent = draftCapacityText(B.capacity, B.draft.parallel);
  }

  function formatSeconds(n) {
    n = Math.max(0, Number(n) || 0);
    return `${Math.floor(n / 60)} phút ${Math.round(n % 60)} giây`;
  }

  function lockCreate() {
    if (!$id('sbTitle')) return;
    root.querySelectorAll('#sbMain input,#sbMain textarea,#sbMain select,#sbMain button').forEach((el) => {
      el.disabled = B.busy;
    });
    for (const id of ['sbStart', 'sbSave']) {
      if ($id(id)) $id(id).disabled = B.busy || B.uploading > 0;
    }
  }

  function bindDrop() {
    const el = $id('sbRefDrop');
    if (!el) return;
    el.addEventListener('click', () => { if (!B.busy) $id('sbRefFiles').click(); });
    el.addEventListener('keydown', (e) => {
      if (['Enter', ' '].includes(e.key)) {
        e.preventDefault();
        if (!B.busy) $id('sbRefFiles').click();
      }
    });
    for (const type of ['dragenter', 'dragover']) {
      el.addEventListener(type, (e) => { e.preventDefault(); el.classList.add('dragover'); });
    }
    for (const type of ['dragleave', 'drop']) {
      el.addEventListener(type, (e) => { e.preventDefault(); el.classList.remove('dragover'); });
    }
    el.addEventListener('drop', (e) => addRefs(e.dataTransfer.files));
  }

  async function uploadSingleRefFile(f) {
    if (!/\.(png|jpe?g|webp)$/i.test(f.name) || f.size > 20 * 1024 * 1024) {
      throw new Error('Ảnh phải là PNG/JPG/WebP và không quá 20 MB.');
    }
    const result = await api('POST', '/api/refs?name=' + encodeURIComponent(f.name), undefined, f);
    if (!result.file) throw new Error('Tool chưa trả về mã ảnh đã tải.');
    return {
      file: result.file,
      name: f.name,
      url: result.url || fileUrl(result.file),
      role: 'character',
      label: f.name.replace(/\.[^.]+$/, ''),
      description: '',
    };
  }

  async function addRefs(files) {
    if (B.busy || B.uploading) return;
    saveDraft();
    const incoming = [...files];
    if (incoming.length + B.draft.reference_images.length > 4) {
      return toast('Bộ ảnh gốc dùng chung tối đa 4 ảnh. Để tải 4–30 ảnh cho từng phân cảnh, bấm "Chọn loạt ảnh Storyboard (Cảnh 1 → N)".', 'warn');
    }
    B.uploading = incoming.length;
    lockCreate();
    if ($id('sbUploadStatus')) $id('sbUploadStatus').textContent = 'Đang tải ảnh…';
    try {
      for (const f of incoming) {
        const r = await uploadSingleRefFile(f);
        B.draft.reference_images.push(r);
        if (B.draft.reference_images.length === 1 && B.draft.characters[0] && !B.draft.characters[0].reference_file) {
          B.draft.characters[0].reference_file = r.file;
        }
      }
      store.set('sceneBatchDraft', B.draft);
    } catch (e) {
      notify(e);
    } finally {
      B.uploading = 0;
      createView();
    }
  }

  async function addSceneStoryboards(files, startSceneIndex = null) {
    if (B.busy || B.uploading || !files?.length) return;
    saveDraft();
    const incoming = [...files];
    if (startSceneIndex === null && incoming.length >= MIN_SCENES && incoming.length <= MAX_SCENES && incoming.length !== B.draft.scenes.length) {
      while (B.draft.scenes.length < incoming.length) {
        B.draft.scenes.push(blankScene(B.draft.characters.map((c) => c.id), B.draft.scenes.length + 1));
      }
      if (incoming.length < B.draft.scenes.length && !B.draft.scenes.slice(incoming.length).some((s) => s.prompt)) {
        B.draft.scenes = B.draft.scenes.slice(0, incoming.length);
      }
    }
    B.uploading = incoming.length;
    lockCreate();
    try {
      for (let k = 0; k < incoming.length; k++) {
        const targetIdx = startSceneIndex !== null ? startSceneIndex + k : k;
        if (targetIdx >= B.draft.scenes.length) break;
        const uploaded = await uploadSingleRefFile(incoming[k]);
        const scene = B.draft.scenes[targetIdx];
        scene.storyboard_file = uploaded.file;
        scene.storyboard_name = uploaded.name;
        scene.storyboard_url = uploaded.url;
        if (!scene.storyboard_label || /^Storyboard cảnh \d+$/i.test(scene.storyboard_label)) {
          scene.storyboard_label = `Storyboard cảnh ${String(targetIdx + 1).padStart(2, '0')} · ${uploaded.label}`;
        }
        if (B.draft.reference_images.length < 4 && !B.draft.reference_images.some((r) => r.file === uploaded.file)) {
          B.draft.reference_images.push({ ...uploaded, role: B.draft.reference_images.length === 0 ? 'character' : 'style' });
        }
        if (B.draft.characters[0] && !B.draft.characters[0].reference_file) {
          B.draft.characters[0].reference_file = uploaded.file;
        }
      }
      store.set('sceneBatchDraft', B.draft);
      toast(`Đã gắn ảnh Storyboard cho ${Math.min(incoming.length, B.draft.scenes.length)} phân cảnh bên cột trái.`, 'success');
    } catch (e) {
      notify(e);
    } finally {
      B.uploading = 0;
      B.targetSceneUploadIndex = null;
      createView();
    }
  }

  function resizeScenesTo(n) {
    saveDraft();
    if (!Number.isInteger(n) || n < MIN_SCENES || n > MAX_SCENES) {
      return toast(`Chọn từ ${MIN_SCENES} đến ${MAX_SCENES} phân cảnh.`, 'warn');
    }
    B.draft.scenes = B.draft.scenes.slice(0, n);
    while (B.draft.scenes.length < n) {
      B.draft.scenes.push(blankScene(B.draft.characters.map((c) => c.id), B.draft.scenes.length + 1));
    }
    store.set('sceneBatchDraft', B.draft);
    createView();
  }

  function validate(d) {
    if (B.uploading) throw new Error('Đợi tải xong ảnh tham chiếu.');
    const hasAnyRef = (d.reference_images && d.reference_images.length > 0) || (d.scenes && d.scenes.some((s) => s.storyboard_file));
    if (!hasAnyRef) throw new Error('Chọn ít nhất một ảnh tham chiếu hoặc ảnh Storyboard cho phân cảnh.');
    if (!Array.isArray(d.scenes) || d.scenes.length < MIN_SCENES || d.scenes.length > MAX_SCENES) {
      throw new Error(`Một dàn cần từ ${MIN_SCENES} đến ${MAX_SCENES} phân cảnh.`);
    }
    const blank = d.scenes.findIndex((s) => !s.prompt);
    if (blank >= 0) throw new Error(`Nhập câu lệnh cho phân cảnh ${blank + 1}.`);
    if (d.scenes.some((s) => s.prompt.length < 5)) throw new Error('Mỗi câu lệnh cần ít nhất 5 ký tự.');
    if ((d.same_character || d.same_voice) && !d.characters.length) throw new Error('Thêm hồ sơ nhân vật hoặc bỏ chọn đồng nhất.');
    for (const c of d.characters) {
      if (!c.name) throw new Error('Mỗi hồ sơ nhân vật cần có tên.');
      if (d.same_character && !c.description && !c.reference_file) throw new Error(`Chọn ảnh hoặc mô tả ngoại hình của ${c.name}.`);
      if (d.same_voice && !c.voice) throw new Error(`Nhập mô tả giọng cố định cho ${c.name}.`);
    }
  }

  async function submit(run) {
    if (B.busy) return;
    saveDraft();
    errorBox('');
    try {
      validate(B.draft);
    } catch (e) {
      errorBox(e.message);
      return;
    }
    B.busy = true;
    lockCreate();
    try {
      const result = await api('POST', '/api/scene-batches', { ...B.draft, run });
      B.current = result.id;
      B.detail = result;
      B.creating = false;
      B.edit = null;
      B.editView = null;
      store.set('sceneBatchCurrent', B.current);
      toast(run ? 'Đã gửi dàn phân cảnh Storyboard vào bộ điều phối.' : 'Đã lưu dự án phân cảnh Storyboard.', 'success');
      await refresh();
    } catch (e) {
      errorBox(e.message);
      notify(e);
    } finally {
      B.busy = false;
      lockCreate();
    }
  }

  function importLines(text) {
    const lines = String(text).replace(/^\uFEFF/, '').split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
    if (lines.length < MIN_SCENES || lines.length > MAX_SCENES) {
      throw new Error(`Cần từ ${MIN_SCENES} đến ${MAX_SCENES} dòng câu lệnh, mỗi dòng là một phân cảnh.`);
    }
    saveDraft();
    const castIds = B.draft.characters.map((c) => c.id);
    B.draft.scenes = lines.map((prompt, idx) => {
      const old = B.draft.scenes[idx] || {};
      return {
        ...blankScene(castIds, idx + 1),
        ...old,
        id: old.id || sceneId(),
        prompt,
        character_ids: old.character_ids?.length ? old.character_ids : [...castIds],
      };
    });
    store.set('sceneBatchDraft', B.draft);
    createView();
  }

