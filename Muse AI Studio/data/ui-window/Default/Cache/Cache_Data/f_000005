    </div>` : '';
  const props = (d.props || []).map((x) => `
    <div class="sv-char fm-prop" data-cid="${esc(x.id)}">
      <div class="sv-char-img">${x.ref_url ? `<img src="${esc(x.ref_url)}" alt="" data-zoom="${esc(x.ref_url)}">`
        : `<span>${x.ref_status === 'running' || x.ref_status === 'queued' ? 'Đang tạo…' : 'Đạo cụ'}</span>`}</div>
      <div class="sv-char-body">
        <input class="input xs" data-cf="name" value="${esc(x.name)}">
        <small>Đạo cụ — giữ đúng 1 kiểu trong mọi cảnh</small>
        <textarea class="input xs" data-cf="look" rows="2" title="Mô tả cố định (tiếng Anh) — chép vào mọi ảnh có đạo cụ này">${esc(x.look || '')}</textarea>
