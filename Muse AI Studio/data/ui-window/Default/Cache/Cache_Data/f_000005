/* ==================================================================== CODEX AI */
const CODEX_STATUS_LABEL = { queued: 'Đang xếp hàng', running: 'Đang lập kế hoạch', done: 'Hoàn thành', error: 'Lỗi', canceled: 'Đã dừng', cancelled: 'Đã dừng' };
function codexStatusLabel(status) { return CODEX_STATUS_LABEL[String(status || '').toLowerCase()] || String(status || 'Chưa chạy'); }
function codexJobId(job) { return String(job?.id || job?.job_id || ''); }
function codexLogEntryHtml(entry) {
  const t = Number(entry?.t || entry?.timestamp || entry?.created_at || 0);
  const stamp = t ? fmtClock(t > 2e10 ? t / 1000 : t) : '--:--:--';
  const level = String(entry?.level || entry?.status || 'info').toLowerCase();
  return `<div class="codex-log-line ${esc(level)}"><time>${esc(stamp)}</time><span class="level">${esc(level)}</span><span class="msg">${esc(entry?.msg || entry?.message || entry?.output || '')}</span></div>`;
}
function renderCodexLogs(entries = S.codex.logs) {
  const body = $('#codexLog'); if (!body) return;
  const list = Array.isArray(entries) ? entries : [];
  if (!list.length) { body.innerHTML = '<div class="empty show"><div class="empty-art">' + ic('terminal') + '</div><h3>Chưa có phiên chạy</h3><p>Chạy lập kế hoạch để xem tiến trình ở đây.</p></div>'; return; }
  body.innerHTML = list.slice(-500).map(codexLogEntryHtml).join(''); body.scrollTop = body.scrollHeight;
}
function appendCodexLog(message, level = 'info', jobId = S.codex.activeId, timestamp = 0) {
  const text = String(message || '').trim(); if (!text) return;
  const key = `${jobId || 'none'}:${level}:${text}`;
  if (S.codex.logged.has(key)) return;
  S.codex.logged.add(key); S.codex.logs.push({ t: timestamp || Date.now(), level, message: text }); renderCodexLogs();
}
function renderCodexStatus(data = {}) {
  S.codex.status = data || {};
  const available = !!data.available;
  const state = $('#codexState');
  if (state) { state.textContent = available ? 'Sẵn sàng' : 'Chưa sẵn sàng'; state.className = 'codex-state ' + (available ? 'ok' : 'warn'); }
  $('#codexCliVersion').textContent = data.version || data.executable || (available ? 'Đã phát hiện' : 'Chưa cài');
  const authState = data.authenticated === false ? 'Chưa đăng nhập' : (data.authenticated ? 'Đã đăng nhập' : 'Kiểm tra bằng CLI');
  $('#codexAuthState').textContent = data.auth_method ? `${authState} · ${data.auth_method}` : authState;
  const message = $('#codexStatusMessage');
  if (message) message.textContent = data.message || (available ? 'Codex CLI đã sẵn sàng lập kế hoạch.' : 'Chưa tìm thấy Codex CLI trong PATH. Cài CLI rồi bấm kiểm tra lại.');
}
function formatCodexValue(value) {
  if (value == null) return '';
  if (typeof value === 'string') return value;
  try { return JSON.stringify(value, null, 2); } catch { return String(value); }
}
function codexShotPrompt(shot) { return String(shot?.prompt || shot?.image_prompt || shot?.video_prompt || shot?.description || '').trim(); }
function codexManifestShots(manifest) {
  if (!manifest) return [];
  if (Array.isArray(manifest.shots)) return manifest.shots;
  if (Array.isArray(manifest.scenes)) return manifest.scenes;
  if (Array.isArray(manifest.storyboard)) return manifest.storyboard;
  return [];
}
function renderCodexResult(job) {
  const el = $('#codexResult'); if (!el) return;
  const manifest = job?.plan || job?.manifest;
  const shots = codexManifestShots(manifest);
  S.codex.result = { job, manifest, shots };
  const prompts = shots.map(codexShotPrompt).filter(Boolean);
  const use = $('#btnCodexUsePrompts'); if (use) use.disabled = !prompts.length;
  const approve = $('#btnCodexApprove'); if (approve) approve.disabled = !manifest || !shots.length || String(job?.status || '').toLowerCase() !== 'done';
  if (!manifest && !job?.output) { el.innerHTML = '<div class="empty show"><div class="empty-art">' + ic('wand') + '</div><h3>Chưa có kế hoạch</h3><p>Kết quả sẽ hiển thị shot list, prompt, timeline và ghi chú sau khi Codex hoàn thành.</p></div>'; return; }
  const title = manifest?.title || manifest?.project || 'Kế hoạch video';
  const summary = manifest?.summary || '';
  const notes = Array.isArray(manifest?.notes) ? manifest.notes.join('\n') : (manifest?.notes || manifest?.note || manifest?.description || '');
  const timeline = manifest?.timeline;
  const timelineText = Array.isArray(timeline) ? timeline.map((item, i) => `${i + 1}. ${formatCodexValue(item)}`).join('\n') : formatCodexValue(timeline);
  const shotHtml = shots.length ? `<div class="codex-shot-list">${shots.map((shot, i) => {
    const prompt = codexShotPrompt(shot); const label = shot?.title || shot?.name || `Cảnh ${i + 1}`; const duration = shot?.duration || shot?.seconds || shot?.duration_seconds;
    return `<article class="codex-shot"><div class="codex-shot-head"><b>${i + 1}. ${esc(label)}</b>${duration ? `<span>${esc(duration)} giây</span>` : ''}</div><p>${esc(prompt || shot?.visual || shot?.action || 'Chưa có prompt')}</p>${shot?.audio || shot?.voice ? `<small>Âm thanh: ${esc(shot.audio || shot.voice)}</small>` : ''}</article>`;
  }).join('')}</div>` : '<p class="hint">Manifest chưa có danh sách cảnh dạng chuẩn. Xem output trong log để biết thêm chi tiết.</p>';
  const meta = [manifest?.ratio, shots.length ? `${shots.length} cảnh` : ''].filter(Boolean).join(' · ');
  el.innerHTML = `<div class="codex-result-title"><b>${esc(title)}</b><span>${esc(meta)}</span></div>${summary ? `<div class="codex-result-block"><strong>Tóm tắt</strong><p>${esc(summary)}</p></div>` : ''}${notes ? `<div class="codex-result-block"><strong>Ghi chú</strong><p>${esc(notes)}</p></div>` : ''}${shotHtml}${timelineText ? `<details class="codex-result-block"><summary>Timeline</summary><pre>${esc(timelineText)}</pre></details>` : ''}${!shots.length && job?.output ? `<details class="codex-result-block"><summary>Output</summary><pre>${esc(job.output)}</pre></details>` : ''}`;
}
function renderCodexJob(job, transientOutput = '', fromEvent = false) {
  if (!job) return;
  const id = codexJobId(job); if (!id) return;
  if (fromEvent && !S.codex.activeId) return;
  if (S.codex.activeId && id !== String(S.codex.activeId)) return;
  if (!S.codex.activeId) { S.codex.activeId = id; store.set('codex.latest_job', id); }
  S.codex.active = job;
  const status = String(job.status || '').toLowerCase(); const done = ['done', 'error', 'canceled', 'cancelled'].includes(status);
  const badge = $('#codexRunBadge'); if (badge) { badge.textContent = codexStatusLabel(status); badge.className = 'pill ' + (status === 'error' ? 'danger' : status === 'done' ? 'success' : 'accent'); }
  const stop = $('#btnCodexStop'); if (stop) stop.disabled = !job || done;
  const run = $('#btnCodexRun'); if (run) run.disabled = !done;
  if (Array.isArray(job.logs)) job.logs.forEach((entry) => appendCodexLog(entry?.message || entry?.msg || entry?.output, entry?.level || 'info', id, entry?.t || entry?.timestamp));
  if (transientOutput) {
    const text = String(transientOutput).slice(-2000);
    const transient = S.codex.logs.find((entry) => entry._transient && entry.jobId === id);
    if (transient) transient.message = text;
    else S.codex.logs.push({ t: Date.now(), level: 'info', message: text, _transient: true, jobId: id });
    renderCodexLogs();
  }
  if (job.error) appendCodexLog(job.error, 'error', id);
  if (job.output && done) appendCodexLog(job.output, status === 'error' ? 'error' : 'success', id);
  if (job.message) appendCodexLog(job.message, status === 'error' ? 'error' : 'info', id);
  const previous = S.codex.lastStatus[id]; if (previous !== status) { S.codex.lastStatus[id] = status; appendCodexLog(`Trạng thái: ${codexStatusLabel(status)}`, status === 'error' ? 'error' : 'info', id); }
  if (done) {
    if (S.codex.poll) { clearTimeout(S.codex.poll); S.codex.poll = null; }
    if (status === 'done') renderCodexResult(job);
    if (status === 'done' && !S.codex.toasted.has(id)) { S.codex.toasted.add(id); toast('Codex đã hoàn thành kế hoạch video', 'success'); }
    if (status === 'error' && !S.codex.toasted.has(id)) { S.codex.toasted.add(id); toast(job.error || 'Codex gặp lỗi', 'error', 5000); }
  }
}
async function loadCodexStatus() { try { renderCodexStatus(await api('GET', '/api/codex/status')); } catch (e) { renderCodexStatus({ available: false, message: e.message }); } }
async function loadCodexJobs() {
  try {
    const jobs = await api('GET', '/api/codex/jobs'); S.codex.jobs = Array.isArray(jobs) ? jobs : (jobs?.jobs || []);
    const wanted = S.codex.activeId && S.codex.jobs.find((item) => codexJobId(item) === String(S.codex.activeId));
    if (S.codex.activeId && !wanted) { S.codex.activeId = ''; store.set('codex.latest_job', ''); }
    const job = wanted || (!S.codex.activeId ? S.codex.jobs[0] : null);
    if (job) { renderCodexJob(job); if (!['done', 'error', 'canceled', 'cancelled'].includes(String(job.status || '').toLowerCase())) pollCodexJob(codexJobId(job)); }
  } catch { /* Older server versions have no Codex routes yet. */ }
}
function pollCodexJob(jobId) {
