      <div class="sv-speed-now"><b>${cap.vid_slots || 0}</b><span>clip cùng lúc<small>đổi luồng ở tab Tài khoản hoặc tab Làm phim</small></span></div>
      <label class="field inline"><span>Luồng dựng</span><select class="input xs select" id="afERender"><option value="0" ${!st.render_threads ? 'selected' : ''}>Tự động (${cap.cpu_render})</option>${[1, 2, 3, 4].map((n) => `<option value="${n}" ${+st.render_threads === n ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
