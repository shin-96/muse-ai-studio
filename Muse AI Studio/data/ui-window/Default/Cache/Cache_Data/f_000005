async function fmCreate(run) {
  const st = fmCreateSettings();
  if (st.idea.length < 10) { toast('Nhập ý tưởng phim (vài câu: nhân vật, bối cảnh, mâu thuẫn, kết)', 'error'); $('#fmIdea').focus(); return; }
  if (st.dub && !(S.vt && S.vt.has_key)) { toast('Đã chọn Lồng tiếng VoiceTube — dán API key và bấm Lưu key trước (hoặc chọn Giọng gốc Muse)', 'error', 6000); $('#fmDubKey [data-vtkey]')?.focus(); return; }
  store.set('filmDraft', { ...st, idea: '' });
  const btns = $$('#fmGo, #fmCreateOnly'); btns.forEach((b) => { b.disabled = true; });
  try {
    const d = await api('POST', '/api/film', { name: $('#fmName').value.trim(), settings: st });
    FM.cur = d.id; store.set('filmCur', d.id); FM.data = d; FM.creating = false; FM.filter = 'all'; FM.limit = 40; FM.picked.clear();
    if (run) await api('POST', `/api/film/${d.id}/run`, { action: 'all' });
    toast(run ? 'Đã bắt đầu làm phim — Muse đang viết kịch bản' : 'Đã tạo dự án phim. Bấm 1 · Kịch bản để Muse viết kịch bản.', 'success', 4000);
    await loadFilm();
  } catch (e) { toast(e.message, 'error', 5000); btns.forEach((b) => { b.disabled = false; }); }
}

