/* Nút Chạy ẩn / Hiện trình duyệt (đồng bộ với Cài đặt › Cửa sổ khi chạy) */
function renderBrowserVis() {
  const shown = (S.settings && S.settings.browser_visibility) === 'visible';
  $$('#browserVis [data-vis]').forEach((b) => {
    const on = (b.dataset.vis === 'visible') === shown;
    b.classList.toggle('on', on);
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  const sel = $('[data-s="browser_visibility"]');
  if (sel && document.activeElement !== sel) sel.value = (S.settings && S.settings.browser_visibility) || 'offscreen';
}
async function setBrowserVis(vis) {
  const cur = (S.settings && S.settings.browser_visibility) || 'offscreen';
  // "Chạy ẩn" giữ nguyên headless nếu người dùng đã chọn headless trong Cài đặt
  const next = vis === 'visible' ? 'visible' : (cur === 'headless' ? 'headless' : 'offscreen');
