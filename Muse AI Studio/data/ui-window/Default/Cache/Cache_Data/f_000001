/* =====================================================================
   Muse Studio — theme "Aurora": thanh menu trên, bảng màu tím/xanh ngọc,
   hỗ trợ sáng / tối. File này ghi đè style.css.
   ===================================================================== */
:root {
  --bg: #090b14;
  --bg-2: #0d1020;
  --panel: #111427;
  --panel-2: #161a31;
  --panel-3: #1e2340;
  --line: #222744;
  --line-2: #2d3357;
  --text: #eceefb;
  --text-2: #b7bcdb;
  --muted: #7c82a8;
  --faint: #535979;

  --violet: #8b7bff;
  --violet-2: #b6abff;
  --teal: #22d3c5;
  --teal-2: #8ff3e9;
  --orange: #ff9d5c;

  --accent: var(--violet);
  --accent-2: var(--violet-2);
  --accent-ink: #0d0830;
  --accent-soft: rgba(139, 123, 255, .14);
  --accent-line: rgba(139, 123, 255, .45);
  --r: 12px;
  --r-lg: 18px;
  --shadow: 0 16px 40px rgba(2, 4, 16, .45);
}
body[data-mode="video"] {
  --accent: var(--teal);
  --accent-2: var(--teal-2);
  --accent-ink: #02201d;
  --accent-soft: rgba(34, 211, 197, .13);
  --accent-line: rgba(34, 211, 197, .45);
}
body {
  background-image:
    radial-gradient(900px 420px at 100% 0%, var(--accent-soft), transparent 65%),
    radial-gradient(700px 380px at 0% 100%, rgba(255, 157, 92, .06), transparent 60%);
}

/* ------------------------------------------------------------ light theme */
html[data-theme="light"] {
  --bg: #f4f5fb;
  --bg-2: #ffffff;
  --panel: #ffffff;
  --panel-2: #f1f2f9;
  --panel-3: #e8e9f4;
  --line: #e3e5f0;
  --line-2: #d4d7e7;
  --text: #171a2e;
  --text-2: #3b4060;
  --muted: #6b7091;
  --faint: #9a9fbb;
  --shadow: 0 10px 30px rgba(30, 35, 80, .08);
  --accent: #6b57f5;
  --accent-2: #8b7bff;
  --accent-ink: #ffffff;
  --accent-soft: rgba(107, 87, 245, .10);
  --accent-line: rgba(107, 87, 245, .45);
}
html[data-theme="light"] body[data-mode="video"] {
  --accent: #0fa89c;
  --accent-2: #22d3c5;
  --accent-ink: #ffffff;
  --accent-soft: rgba(15, 168, 156, .10);
  --accent-line: rgba(15, 168, 156, .45);
}
html[data-theme="light"] .card { background: var(--panel); }
html[data-theme="light"] .topbar,
html[data-theme="light"] .appbar { background: rgba(255, 255, 255, .85); }
html[data-theme="light"] .statusbar { background: #fff; }
html[data-theme="light"] .drawer { background: rgba(255, 255, 255, .98); }
html[data-theme="light"] .trow:hover { background: var(--panel-2); }
html[data-theme="light"] .lightbox { background: rgba(15, 17, 30, .92); }
html[data-theme="light"] ::-webkit-scrollbar-thumb { background-color: #cdd0e2; }
html[data-theme="light"] .lmedia .kind { color: #fff; }

/* ------------------------------------------------------------ layout: thanh menu trên */
.app { flex-direction: column; }
.rail { display: none; }
.appbar {
  height: 58px; flex: none; display: flex; align-items: center; gap: 18px; padding: 0 18px;
  border-bottom: 1px solid var(--line); background: rgba(10, 12, 24, .78); backdrop-filter: blur(12px); z-index: 20;
}
.brand { display: flex; align-items: center; gap: 10px; margin: 0; min-width: 190px; }
.brand-logo {
  width: 34px; height: 34px; border-radius: 10px; color: #fff;
  background: conic-gradient(from 210deg, #8b7bff, #22d3c5, #ff9d5c, #8b7bff);
  box-shadow: 0 6px 18px rgba(139, 123, 255, .35);
}
.brand-logo svg { width: 20px; height: 20px; }
.brand-text { display: flex; flex-direction: column; line-height: 1.1; }
.brand-text b { font-size: 14.5px; letter-spacing: -.01em; }
.brand-text small { font-size: 10.5px; color: var(--muted); letter-spacing: .04em; text-transform: uppercase; }
.tabs-nav { display: flex; gap: 2px; padding: 4px; border-radius: 14px; background: var(--panel-2); border: 1px solid var(--line); }
.tabs-nav .nav {
  width: auto; flex-direction: row; gap: 7px; padding: 0 14px; height: 34px; border-radius: 10px; font-size: 13px; font-weight: 600;
}
.tabs-nav .nav svg.ic { width: 16px; height: 16px; }
.tabs-nav .nav.active { background: var(--accent); color: var(--accent-ink); box-shadow: 0 4px 14px var(--accent-soft); }
.appbar-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.engine-pill {
  display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border-radius: 20px;
  background: var(--panel-2); border: 1px solid var(--line); color: var(--muted); font-size: 12px; font-weight: 600;
}
.engine-pill b { color: var(--text); }
.engine-pill .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--faint); }
.engine-pill.on { color: var(--text-2); border-color: var(--accent-line); }
.engine-pill.on .pulse { background: var(--accent); box-shadow: 0 0 0 0 var(--accent-line); animation: ring 1.6s infinite; }
@keyframes ring { 70% { box-shadow: 0 0 0 7px transparent; } }
.main { flex: 1; min-height: 0; }
.app { height: calc(100vh - 30px); }
.drawer { left: 0; }

/* ------------------------------------------------------------ studio: composer bên phải */
.studio { padding: 16px; gap: 16px; }
.composer { width: 360px; order: 2; border-top: 3px solid var(--accent); }
.tasks { order: 1; }
.topbar { min-height: 56px; }
.project-picker { border-radius: 12px; }
.seg-mode button.on { box-shadow: 0 6px 16px var(--accent-soft); }
#promptInput { border-radius: 12px; }

/* hàng tác vụ dạng thẻ */
.tbody { padding: 8px 10px; }
.thead { padding-left: 24px; padding-right: 24px; border-bottom: 0; }
.trow {
  margin-bottom: 6px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel-2);
  border-bottom: 1px solid var(--line); padding: 8px 14px;
}
.trow:hover { border-color: var(--line-2); }
.trow.sel { border-color: var(--accent-line); }
.trow.running { border-color: var(--accent-line); background: linear-gradient(90deg, var(--accent-soft), var(--panel-2) 70%); }
.thumb { border-radius: 10px; }
.badge { padding: 2px 9px 2px 7px; border-radius: 20px; background: color-mix(in srgb, currentColor 12%, transparent); }
.filters button.on { box-shadow: 0 4px 12px var(--accent-soft); }

/* ------------------------------------------------------------ tài khoản: switch + nút gọn */
.toggle-use {
  width: 44px; height: 24px; border-radius: 20px; padding: 0; position: relative; font-size: 0; gap: 0;
  box-shadow: none !important;
}
.toggle-use svg.ic { display: none; }
.toggle-use::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: .2s; box-shadow: 0 1px 3px rgba(0, 0, 0, .35); }
.toggle-use.on { background: var(--accent); }
.toggle-use.on::after { left: 23px; }
.toggle-use.off { background: var(--line-2); }
.acc-acts { gap: 4px; }
.tile {
  width: auto; height: 32px; flex-direction: row; gap: 6px; padding: 0 10px; border-radius: 9px; font-size: 11.5px;
  background: var(--panel-3) !important; color: var(--text-2) !important; box-shadow: none; border: 1px solid var(--line);
}
.tile svg.ic { width: 14px; height: 14px; }
.tile:hover { filter: none; border-color: var(--accent-line); color: var(--text) !important; }
.tile.blue svg.ic { color: #7aa8ff; }
.tile.amber svg.ic { color: var(--orange); }
.tile.violet svg.ic { color: var(--violet-2); }
.tile.teal svg.ic { color: var(--accent); }
.tile.teal.on { border-color: var(--accent-line); color: var(--accent) !important; background: var(--accent-soft) !important; }
.busy-tag.held { color: var(--accent); }
.busy-tag.held::before { animation: none; border: 0; background: currentColor; width: 7px; height: 7px; }
.tile.red { width: 32px; padding: 0; justify-content: center; font-size: 0; gap: 0; }
.tile.red svg.ic { color: #ff7d86; }
.acc-grid { grid-template-columns: 54px 28px minmax(110px, 1fr) minmax(140px, 1.2fr) 122px minmax(150px, 1.1fr) 108px 138px 70px 400px; }
/* 1.9.2: màn hình hẹp → 3 nút Hạn mức / Cookie / Login chỉ còn biểu tượng (rê chuột xem tên), giữ chữ "Treo trình duyệt" */
@media (max-width: 1520px) {
  .acc-acts .tile:not(.teal):not(.red) { padding: 0 9px; gap: 0; }
  .acc-acts .tile:not(.teal) .tl { display: none; }
  .acc-grid { grid-template-columns: 54px 28px minmax(110px, 1fr) minmax(140px, 1.2fr) 122px minmax(150px, 1.1fr) 108px 138px 70px 272px; }
}
.kv svg.ic { color: var(--accent); }
.btn.primary-alt { background: linear-gradient(180deg, var(--accent-2), var(--accent)); color: var(--accent-ink); }

/* ------------------------------------------------------------ thư viện */
.lcard { border-radius: 16px; }
.lmedia { aspect-ratio: 16/10; }

@media (max-width: 1360px) {
  .brand-text { display: none; }
  .brand { min-width: 0; }
  .composer { width: 320px; }
  .acc-grid { grid-template-columns: 50px 24px minmax(96px, 1fr) minmax(120px, 1fr) 118px minmax(130px, 1fr) 96px 124px 62px 272px; }
}

/* nhãn phiên bản góc trên — luôn hiện, kể cả màn hình nhỏ */
.version-pill {
  display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border-radius: 20px;
  font: 600 12px/1 var(--mono); letter-spacing: .02em; white-space: nowrap; user-select: all;
  color: var(--text-2); background: var(--panel-2); border: 1px solid var(--line);
}

/* ------------------------------------------------------------ nút Chạy ẩn / Hiện trình duyệt */
.browser-vis { display: inline-flex; align-items: center; gap: 8px; margin-right: 6px; }
.browser-vis-label { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; font-weight: 600; white-space: nowrap; }
.browser-vis-label svg { width: 15px; height: 15px; }
.browser-vis .seg button { flex: 0 0 auto; padding: 0 11px; gap: 6px; white-space: nowrap; }
.browser-vis .seg button svg { width: 15px; height: 15px; }
.browser-vis .seg button[data-vis="visible"].on { color: var(--accent-ink); background: var(--accent); }
@media (max-width: 1180px) { .browser-vis-label { display: none; } }
@media (max-width: 920px) { .browser-vis .seg button { padding: 0 8px; font-size: 11.5px; } }

/* thanh trên cùng ở cửa sổ hẹp: chữ không xuống dòng, gọn bớt nhãn phụ */
.tabs-nav .nav, .engine-pill { white-space: nowrap; }
@media (max-width: 1180px) { .engine-pill-text { display: none; } .engine-pill { padding: 0 10px; } }
@media (max-width: 1080px) { #licenseLabel { display: none; } }

/* ------------------------------------------------------------ ghép video */
.merge-dlg [hidden] { display: none !important; }
.merge-btn { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.merge-btn:hover:not(:disabled) { filter: brightness(1.1); }
.merge-btn.busy { color: var(--accent-ink); background: var(--accent); }
.merge-btn svg { width: 15px; height: 15px; }
.lmedia .kind.merged { color: var(--accent-2, #c7b8ff); }
.merge-dlg .modal-body { display: flex; flex-direction: column; gap: 12px; }
.merge-stats { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--text-2); }
.merge-stats b { color: var(--text); }
.merge-mode { margin: 6px 0 0; font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
.merge-mode .pill { margin-right: 6px; }
.merge-hint { margin: 4px 0 0; font-size: 12px; }
.merge-err { margin: 6px 0 0; color: #ff8a90; font-size: 12.5px; }
.merge-list { display: flex; flex-direction: column; gap: 6px; max-height: 340px; overflow: auto; padding-right: 2px; }
.merge-row { display: grid; grid-template-columns: 26px 72px minmax(0, 1fr) auto; align-items: center; gap: 10px;
  padding: 6px 8px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel-2); }
.merge-no { font: 700 12px/1 var(--mono); color: var(--accent); text-align: center; }
.merge-row video { width: 72px; height: 42px; object-fit: cover; border-radius: 6px; background: #000; }
.merge-info { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
.merge-info b { font-size: 13px; font-weight: 600; }
.merge-info small { font-size: 11.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.merge-row-acts { display: flex; gap: 2px; }
.merge-skip details { font-size: 12px; color: var(--muted); }
.merge-skip summary { cursor: pointer; }
.merge-name-row { display: flex; align-items: center; gap: 6px; }
.merge-name-row em { font-style: normal; color: var(--muted); font-size: 12.5px; }
.merge-name > span { font-weight: 600; font-size: 13px; }
.merge-progress-head { display: flex; gap: 10px; align-items: baseline; font-size: 12.5px; color: var(--text-2); }
.merge-progress-head b { font: 700 14px/1 var(--mono); color: var(--accent); min-width: 44px; }
.merge-progress .bar { height: 7px; }
.merge-result { border-radius: 10px; padding: 10px 12px; font-size: 13px; display: flex; flex-direction: column; gap: 6px; }
.merge-result > div:first-child { display: flex; align-items: center; gap: 7px; }
.merge-result svg { width: 16px; height: 16px; flex: none; }
.merge-result.ok { border: 1px solid rgba(66, 158, 115, .45); background: rgba(66, 158, 115, .1); }
.merge-result.err { border: 1px solid rgba(240, 84, 92, .4); background: rgba(240, 84, 92, .08); color: #ff9ca1; }
.merge-result small { color: var(--text-2); }
.merge-result-acts { display: flex; gap: 6px; flex-wrap: wrap; }
.merge-actions { display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid var(--line); padding-top: 12px; }
@media (max-width: 1180px) { .merge-btn #mergeLabel { max-width: 130px; overflow: hidden; text-overflow: ellipsis; } }
.tasks-bar.sub { flex-wrap: wrap; row-gap: 6px; }
.tasks-bar.sub .check em, .tasks-bar.sub .btn { white-space: nowrap; }
.tasks-bar.sub #quickSelect { min-width: 128px; flex: none; }
.merge-btn .merge-short { display: none; }
@media (max-width: 1280px) {
  .tasks-bar.sub .btn.xs { padding: 0 8px; }
  .merge-btn #mergeLabel { display: none; }
  .merge-btn .merge-short { display: inline; }
}
.quota .q-topup { display: block; color: var(--muted); font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ------------------------------------------------------------ Market (kho chatbot botlamvideo) */
.market-wrap { flex: 1; min-height: 0; overflow: auto; padding: 16px; display: flex; flex-direction: column; gap: 16px; }
.market-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
@media (max-width: 1100px) { .market-top { grid-template-columns: 1fr; } }
.market-account, .market-runs { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
.mk-acc-head { display: flex; gap: 10px; align-items: flex-start; }
.mk-acc-head > svg { width: 22px; height: 22px; color: var(--accent); flex: none; margin-top: 2px; }
.mk-acc-head.ok > svg { color: var(--green-2, #4ade80); }
.mk-acc-head b { display: block; font-size: 14px; }
.mk-acc-head small { color: var(--muted); font-size: 12px; line-height: 1.45; }
.mk-login { display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; }
@media (max-width: 760px) { .mk-login { grid-template-columns: 1fr; } }
.mk-acc-acts { display: flex; gap: 6px; flex-wrap: wrap; }
.market-account a { color: var(--accent); }
.mk-runs-head b { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; }
.mk-runs-head svg { width: 16px; height: 16px; color: var(--accent); }
.mk-run { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; background: var(--panel-2); display: flex; flex-direction: column; gap: 4px; }
.mk-run-top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.mk-run-top b { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mk-run-foot { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.mk-run-foot small { color: var(--muted); font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.mk-run-foot span { display: flex; gap: 4px; flex: none; }
.mk-run .bar { margin: 2px 0; }
.market-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; }
.mk-card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--panel); display: flex; flex-direction: column; }
.mk-card.owned { border-color: rgba(66, 158, 115, .5); }
.mk-card.bundle { border-color: var(--accent-line); box-shadow: 0 0 0 1px var(--accent-line) inset; }
.mk-media { position: relative; aspect-ratio: 3 / 4; background: var(--panel-2); display: grid; place-items: center; overflow: hidden; }
.mk-media img { width: 100%; height: 100%; object-fit: cover; }
.mk-media > svg { width: 36px; height: 36px; color: var(--faint); }
.mk-badge { position: absolute; left: 8px; top: 8px; display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 700;
  padding: 2px 8px; border-radius: 20px; background: rgba(0, 0, 0, .7); backdrop-filter: blur(4px); }
.mk-badge svg { width: 12px; height: 12px; }
.mk-badge.owned { color: #6ee7a8; }
.mk-badge.combo { color: #ffd479; }
.mk-info { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.mk-info > b { font-size: 13px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.mk-info > small { color: var(--muted); font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mk-price { display: flex; gap: 6px; align-items: baseline; font-size: 12.5px; margin-top: auto; padding-top: 4px; }
.mk-price b { color: var(--accent); }
.mk-price s { color: var(--faint); font-size: 11.5px; }
.mk-price .ok { color: #6ee7a8; font-weight: 600; }
.mk-acts { display: flex; margin-top: 6px; }
.mk-acts .btn { width: 100%; }
.market-more { display: flex; justify-content: center; }
.market-more[hidden] { display: none; }
.mk-run-dlg { display: flex; flex-direction: column; gap: 14px; }
.mk-run-item { display: flex; gap: 12px; align-items: center; }
.mk-run-item img { width: 54px; height: 72px; object-fit: cover; border-radius: 8px; }
.mk-run-item b { display: block; }
.mk-run-item small { color: var(--muted); }
.mk-steps { margin: 0; padding-left: 18px; color: var(--text-2); font-size: 12.5px; line-height: 1.55; display: flex; flex-direction: column; gap: 4px; }
/* tên tác vụ dài (vd dự án chạy tự động) không đè sang cột Loại */
.tmain { min-width: 0; }
.tname { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ------------------------------------------------------------ SRT → Video slide */
.sv-sub { margin: 0 0 0 10px; font-size: 12px; }
@media (max-width: 1000px) { .sv-sub { display: none; } }
.sv-wrap { flex: 1; min-height: 0; display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 16px; padding: 16px; overflow: hidden; }
@media (max-width: 900px) { .sv-wrap { grid-template-columns: 1fr; overflow: auto; } }
.sv-list { padding: 8px; display: flex; flex-direction: column; gap: 6px; overflow: auto; min-height: 0; }
.sv-list-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 24px 8px; color: var(--muted); }
.sv-list-empty svg { width: 28px; height: 28px; color: var(--faint); }
.sv-item { text-align: left; border: 1px solid var(--line); border-radius: 10px; background: var(--panel-2); padding: 9px 10px; display: flex;
  flex-direction: column; gap: 4px; color: var(--text); cursor: pointer; }
.sv-item:hover { border-color: var(--line-2); }
.sv-item.on { border-color: var(--accent-line); box-shadow: 0 0 0 1px var(--accent-line) inset; }
.sv-item b { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sv-item small { color: var(--muted); font-size: 11px; }
.sv-st { align-self: flex-start; font-size: 10.5px; font-weight: 700; padding: 1px 8px; border-radius: 20px; color: var(--text-2);
  background: color-mix(in srgb, currentColor 14%, transparent); }
.sv-st.st-done { color: #4ade80; } .sv-st.st-error { color: #f87171; } .sv-st.st-stopped { color: #fbbf24; }
.sv-st.st-planning, .sv-st.st-refs, .sv-st.st-images, .sv-st.st-rendering { color: var(--accent); }
.sv-st.st-ready, .sv-st.st-planned { color: #38bdf8; }
.sv-main { min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 14px; padding-right: 2px; }
.sv-head { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
.sv-head-top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
.sv-title b { display: block; font-size: 16px; }
.sv-title small { color: var(--muted); font-size: 12px; }
.sv-msg { color: var(--text-2); font-size: 12.5px; min-height: 17px; }
.sv-head .bar { height: 6px; }
