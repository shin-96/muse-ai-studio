    <div class="sv-row sv-audio fm-vol">
      <span class="sv-audio-lbl">${ic('mic')}Tiếng thoại</span>
      <span class="sv-vol"><input type="range" id="fmEClipVol" min="0" max="2" step="0.05" value="${st.clip_volume}"><small class="mono">${Math.round(st.clip_volume * 100)}%</small></span>
