  const d = SV.data; if (!url && !d?.video_url) return;
  openModal({ title: title || d.name, icon: 'film', wide: true, body: `<video src="${esc(url || d.video_url)}" controls autoplay style="width:100%;border-radius:10px;background:#000"></video>`,
