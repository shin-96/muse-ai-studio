  </div>`;
}

function svSpeedHtml(d) {
  const cap = d.capacity || { accounts: 0, per_account: [], slots: 0, cpu_render: 1 };
  const st = d.settings || {};
  const film = st.mode === 'film';
  const per = cap.per_account || [];
  const vper = cap.vid_per_account || [];
  const same = per.length && per.every((x) => x === per[0]);
  const perText = !per.length ? 'chưa có tài khoản dùng được' : same ? `${per.length} tài khoản × ${per[0]} luồng` : `${per.length} tài khoản (${per.join(' + ')} luồng)`;
  const vsame = vper.length && vper.every((x) => x === vper[0]);
  const vText = !vper.length ? '' : vsame ? `${vper.length} tài khoản × ${vper[0]} luồng video` : `${vper.length} tài khoản (${vper.join(' + ')} luồng video)`;
  const lim = cap.limited_by === 'license' ? ' · giới hạn bởi license' : cap.limited_by === 'total' ? ` · giới hạn bởi Tổng số luồng (${cap.total_threads})` : '';
  const left = (d.shot_list || []).filter((x) => !x.image_url).length;
  const cleft = film ? (d.shot_list || []).filter((x) => !x.clip_url).length : 0;
  const eta = (cap.slots && left ? left * 80 / cap.slots : 0) + (cap.vid_slots && cleft ? cleft * 85 / cap.vid_slots : 0);   // đo thật: ~80 giây/ảnh, ~85 giây/clip
  const etaText = eta ? `≈ ${Math.ceil(eta / 60)} phút cho ${left ? `${left} ảnh` : ''}${left && cleft ? ' + ' : ''}${cleft ? `${cleft} clip` : ''} còn lại` : '';
  const opt = (n, cur) => `<option value="${n}" ${+cur === n ? 'selected' : ''}>${n}</option>`;
  return `<div class="sv-speed">
    <div class="sv-speed-head">${ic('zap')}<b>Tốc độ</b>${etaText ? `<small>${etaText}</small>` : ''}</div>
    <div class="sv-speed-now"><b>${cap.slots}</b><span>ảnh chạy cùng lúc<small>${esc(perText)}${esc(lim)}</small></span></div>
    ${film ? `<div class="sv-speed-now"><b>${cap.vid_slots || 0}</b><span>clip chạy cùng lúc<small>${esc(vText || 'chưa có tài khoản dùng được')}</small></span></div>` : ''}
    <label class="field inline"><span>Luồng ảnh mỗi tài khoản</span>
      <input class="input xs num" type="number" id="svImgThreads" min="1" max="50" value="${per.length ? Math.max(...per) : 5}">
      <button class="btn ghost xs" id="svImgApply" title="Áp dụng cho mọi tài khoản đang bật (giống sửa ở tab Tài khoản)">Áp dụng</button></label>
    ${film ? `<label class="field inline"><span>Luồng video mỗi tài khoản</span>
      <input class="input xs num" type="number" id="svVidThreads" min="1" max="50" value="${vper.length ? Math.max(...vper) : 5}">
      <button class="btn ghost xs" id="svVidApply" title="Áp dụng cho mọi tài khoản đang bật">Áp dụng</button></label>` : ''}
    <div class="sv-row">
      <label class="field inline"><span>Luồng phân tích</span><select class="input xs select" id="svPlan" title="Số chat Muse viết mô tả cảnh song song">${[1, 2, 3, 4].map((n) => opt(n, st.plan_threads || 3)).join('')}</select></label>
      <label class="field inline"><span>Luồng dựng video</span><select class="input xs select" id="svRender" title="Số cảnh ffmpeg dựng song song">
        <option value="0" ${!st.render_threads ? 'selected' : ''}>Tự động (${cap.cpu_render})</option>${[1, 2, 3, 4].map((n) => opt(n, st.render_threads)).join('')}</select></label>
    </div>
    <small class="hint">Nhanh nhất là thêm tài khoản Muse (tab Tài khoản): mỗi tài khoản có nhóm luồng riêng. Đặt quá nhiều luồng cho 1 tài khoản, Muse có thể chặn hoặc treo bớt.</small>
  </div>`;
}

