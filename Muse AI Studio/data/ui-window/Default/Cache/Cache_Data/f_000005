}

function bindSrt() {
  $('#svFile').onchange = async (e) => {
    const f = e.target.files[0]; e.target.value = '';
    if (!f) return;
    if (f.size > 2 * 1024 * 1024) { toast('File SRT quá lớn (tối đa 2 MB)', 'error'); return; }
    if (!SV.styles.length) { try { const r = await api('GET', '/api/srt'); SV.styles = r.styles || []; } catch { /* ignore */ } }
    openSrtImport(f, await svReadFile(f));
  };
  $('#svList').onclick = (e) => {
    const b = e.target.closest('[data-sv]'); if (!b) return;
    SV.cur = +b.dataset.sv; store.set('srtCur', SV.cur); SV.filter = 'all'; SV.limit = 60; SV.picked.clear();
    renderSrtList(); loadSrtDetail();
  };
  const main = $('#svMain');
  main.addEventListener('click', async (e) => {
    const t = e.target;
    const zoom = t.closest('[data-zoom]'); if (zoom) { svZoom(zoom.dataset.zoom); return; }
    const clip = t.closest('[data-clip]'); if (clip) { svPlay(clip.dataset.clip, `Clip cảnh #${clip.closest('[data-sid]')?.dataset.sid || ''}`); return; }
    const run = t.closest('[data-svrun]');
    if (run) {
      const action = run.dataset.svrun;
      if (action === 'plan' && SV.data.planned > 0 && !confirm('Phân tích lại sẽ viết lại toàn bộ mô tả nhân vật và cảnh (giữ ảnh đã tạo). Tiếp tục?')) return;
      if (action === 'script' && SV.data.cues > 0 && !confirm('Viết lại kịch bản sẽ thay toàn bộ lời dẫn, phụ đề và các cảnh hiện có. Tiếp tục?')) return;
      try { await api('POST', `/api/srt/${SV.cur}/run`, { action }); toast('Đã bắt đầu', 'success', 1600); loadSrtDetail(); } catch (err) { toast(err.message, 'error', 5000); }
      return;
    }
    if (t.closest('#svStop')) { try { await api('POST', `/api/srt/${SV.cur}/stop`); loadSrtDetail(); } catch (err) { toast(err.message, 'error'); } return; }
    if (t.closest('#svPlay')) { svPlay(); return; }
    if (t.closest('#svReveal')) { openPath(SV.data.video_path, true); return; }
    if (t.closest('#svDel')) {
      if (!confirm(`Xoá dự án SRT "${SV.data.name}"? Ảnh và video đã tạo vẫn còn trong Studio / Thư viện.`)) return;
      try { await api('DELETE', `/api/srt/${SV.cur}`); SV.cur = null; SV.data = null; store.set('srtCur', null); loadSrt(); } catch (err) { toast(err.message, 'error'); }
      return;
    }
    if (t.closest('#svLogoDel')) { svSaveSettings({ logo: '' }); return; }
    const mode = t.closest('#svMode [data-m]');
    if (mode) {
      if (mode.dataset.m === (SV.data.settings?.mode || 'slide')) return;
      if (mode.dataset.m === 'film' && SV.data.shots > 0) toast(`Chế độ Phim: thêm bước Clip động (~85 giây/clip, ${SV.data.shots} cảnh).`, 'info', 4000);
      svSaveSettings({ mode: mode.dataset.m }); return;
    }
    const adel = t.closest('[data-audel]');
    if (adel) { try { SV.data = await api('DELETE', `/api/srt/${SV.cur}/audio?kind=${adel.dataset.audel}`); renderSrtMain(); } catch (err) { toast(err.message, 'error'); } return; }
    if (t.closest('#svVidApply')) {
      const n = Math.max(1, Math.min(50, +$('#svVidThreads').value || 1));
      try { const cap = await api('POST', '/api/srt/threads', { vid_threads: n }); toast(`Đã đặt ${n} luồng video cho ${cap.accounts} tài khoản → ${cap.vid_slots} clip chạy cùng lúc`, 'success', 3500); loadSrtDetail(); } catch (err) { toast(err.message, 'error', 5000); }
      return;
    }
    if (t.closest('#svImgApply')) {
      const n = Math.max(1, Math.min(50, +$('#svImgThreads').value || 1));
      try { const cap = await api('POST', '/api/srt/threads', { img_threads: n }); toast(`Đã đặt ${n} luồng ảnh cho ${cap.accounts} tài khoản → ${cap.slots} ảnh chạy cùng lúc`, 'success', 3500); loadSrtDetail(); } catch (err) { toast(err.message, 'error', 5000); }
      return;
    }
    const ratio = t.closest('#svRatio [data-r]'); if (ratio) { svSaveSettings({ ratio: ratio.dataset.r }); return; }
    const f = t.closest('#svFilter [data-f]'); if (f) { SV.filter = f.dataset.f; SV.limit = 60; $$('#svFilter button').forEach((x) => x.classList.toggle('on', x === f)); renderSrtShots(); return; }
    if (t.closest('#btnSvMore')) { SV.limit += 60; renderSrtShots(); return; }
    const del = t.closest('[data-cdel]');
    if (del) { const cid = del.closest('[data-cid]').dataset.cid; try { SV.data = await api('POST', `/api/srt/${SV.cur}/character`, { id: cid, ref: '' }); renderSrtMain(); } catch (err) { toast(err.message, 'error'); } return; }
    const regen = t.closest('[data-regen]');
    if (regen) {
      const sid = +regen.closest('[data-sid]').dataset.sid;
      try { await api('POST', `/api/srt/${SV.cur}/run`, { action: 'images', only: [sid] }); toast(`Đang tạo lại ảnh cảnh #${sid}`, 'info', 2000); loadSrtDetail(); } catch (err) { toast(err.message, 'error'); }
      return;
    }
    const pbad = t.closest('[data-pick-bad]');
    if (pbad) { (SV.data.shot_list || []).filter(pbad.dataset.pickBad === 'clip' ? svClipBad : svImgBad).forEach((x) => SV.picked.add(x.id)); if (SV.filter === 'all') { SV.filter = 'error'; } renderSrtMain(); return; }
    if (t.closest('[data-pick-none]')) { SV.picked.clear(); renderSrtShots(); return; }
    const prun = t.closest('[data-pick-run]');
    if (prun) {
      const action = prun.dataset.pickRun; const only = [...SV.picked].sort((a, b) => a - b);
      if (!only.length) return;
      const label = { images: 'tạo lại ảnh', fix: 'AI sửa prompt + tạo lại ảnh', clips: 'tạo lại clip', fixclip: 'AI sửa chuyển động + tạo lại clip' }[action];
      try { await api('POST', `/api/srt/${SV.cur}/run`, { action, only }); toast(`Đang ${label} cho ${only.length} cảnh`, 'success', 2500); SV.picked.clear(); loadSrtDetail(); } catch (err) { toast(err.message, 'error', 5000); }
      return;
    }
    const fixone = t.closest('[data-fixone]');
    if (fixone) {
      const sid = +fixone.closest('[data-sid]').dataset.sid;
      try { await api('POST', `/api/srt/${SV.cur}/run`, { action: 'fix', only: [sid] }); toast(`Muse đang sửa prompt cảnh #${sid} rồi tạo lại`, 'info', 2500); loadSrtDetail(); } catch (err) { toast(err.message, 'error'); }
      return;
    }
    const restore = t.closest('[data-restore]');
    if (restore) {
      const sid = +restore.closest('[data-sid]').dataset.sid;
      const shot = (SV.data.shot_list || []).find((x) => x.id === sid);
      if (shot?.scene_orig) { try { SV.data = await api('POST', `/api/srt/${SV.cur}/shot`, { id: sid, scene: shot.scene_orig }); renderSrtMain(); toast(`Đã khôi phục mô tả gốc cảnh #${sid}`, 'success', 1800); } catch (err) { toast(err.message, 'error'); } }
      return;
    }
    const regclip = t.closest('[data-regclip]');
    if (regclip) {
      const sid = +regclip.closest('[data-sid]').dataset.sid;
      try { await api('POST', `/api/srt/${SV.cur}/run`, { action: 'clips', only: [sid] }); toast(`Đang tạo clip động cảnh #${sid}`, 'info', 2000); loadSrtDetail(); } catch (err) { toast(err.message, 'error'); }
    }
  });
  main.addEventListener('change', async (e) => {
    const t = e.target;
    try {
      if (t.id === 'svSec') return svSaveSettings({ shot_sec: +t.value });
      if (t.id === 'svStyle') return svSaveSettings({ style: t.value });
      if (t.id === 'svStyleText') return svSaveSettings({ style_text: t.value });
      if (t.id === 'svSubs') return svSaveSettings({ subtitles: t.checked });
      if (t.id === 'svSubScale') return svSaveSettings({ sub_scale: +t.value });
      if (t.id === 'svMotion') { mvLive('sv', t); return svSaveSettings({ motion: t.value }); }
      if (t.id === 'svMotionStrength') { mvLive('sv', t); return svSaveSettings({ motion_strength: t.value }); }
      if (t.id === 'svShake') { mvLive('sv', t); return svSaveSettings({ shake: t.value }); }
      if (t.id === 'svFps') return svSaveSettings({ fps: +t.value });
      if (t.id === 'svRefs') return svSaveSettings({ char_refs: t.checked });
      if (t.id === 'svPlan') return svSaveSettings({ plan_threads: +t.value });
      if (t.id === 'svRender') return svSaveSettings({ render_threads: +t.value });
      if (t.id === 'svLogoFile' && t.files[0]) { const fid = await svUpload(t.files[0]); return svSaveSettings({ logo: fid }); }
      if (t.matches('[data-pick]')) { const sid = +t.closest('[data-sid]').dataset.sid; if (t.checked) SV.picked.add(sid); else SV.picked.delete(sid); t.closest('.sv-shot').classList.toggle('picked', t.checked); renderSvPickBar(); return; }
      if (t.id === 'svAutoFix') return svSaveSettings({ auto_fix: t.checked });
      if (t.id === 'svClipAudio') return svSaveSettings({ clip_audio: t.checked });
      if (t.id === 'svClipVol') return svSaveSettings({ clip_volume: +t.value });
      if (t.id === 'svVoiceVol') return svSaveSettings({ voice_volume: +t.value });
      if (t.id === 'svMusicVol') return svSaveSettings({ music_volume: +t.value });
      if (t.id === 'svIdea') return svSaveSettings({ idea: t.value });
      if (t.id === 'svGenre') return svSaveSettings({ genre: t.value });
      if (t.id === 'svMinutes') return svSaveSettings({ minutes: +t.value });
      if (t.id === 'svLang') return svSaveSettings({ lang: t.value });
      if (t.id === 'svNarr') return svSaveSettings({ narration: t.value });
      if (t.matches('[data-aup]') && t.files[0]) {
        const f = t.files[0]; const kind = t.dataset.aup;
        if (f.size > 300 * 1024 * 1024) { toast('File âm thanh quá lớn (tối đa 300 MB)', 'error'); return; }
        toast(`Đang tải ${f.name}…`, 'info', 2000);
        SV.data = await api('POST', `/api/srt/${SV.cur}/audio?kind=${kind}&name=${encodeURIComponent(f.name)}`, undefined, f);
        renderSrtMain(); toast(`Đã gắn ${kind === 'voice' ? 'voice' : 'nhạc nền'} — áp dụng khi dựng`, 'success', 2500); return;
      }
      const cbox = t.closest('[data-cid]');
      if (cbox && t.dataset.cf) { SV.data = await api('POST', `/api/srt/${SV.cur}/character`, { id: cbox.dataset.cid, [t.dataset.cf]: t.value }); toast('Đã lưu nhân vật — áp dụng cho ảnh tạo sau', 'success', 1800); return; }
      if (cbox && t.matches('[data-cup]') && t.files[0]) { const fid = await svUpload(t.files[0]); SV.data = await api('POST', `/api/srt/${SV.cur}/character`, { id: cbox.dataset.cid, ref: fid }); renderSrtMain(); return; }
      const sbox = t.closest('[data-sid]');
      if (sbox && t.classList.contains('sv-scene')) { SV.data = await api('POST', `/api/srt/${SV.cur}/shot`, { id: +sbox.dataset.sid, scene: t.value }); toast(`Đã lưu cảnh #${sbox.dataset.sid}`, 'success', 1400); }
      if (sbox && t.classList.contains('sv-motion')) { SV.data = await api('POST', `/api/srt/${SV.cur}/shot`, { id: +sbox.dataset.sid, motion: t.value }); toast(`Đã lưu chuyển động cảnh #${sbox.dataset.sid} — áp dụng khi tạo lại clip`, 'success', 1800); }
    } catch (err) { toast(err.message, 'error', 5000); }
  });
}

