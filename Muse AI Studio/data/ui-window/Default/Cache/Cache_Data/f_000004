          const task = s.task || {};
          const url = clipUrl(s);
          const actual = s.duration_actual ?? B.editView?.clips?.find((c) => String(c.scene_id) === String(s.id))?.duration;
          const sbUrl = s.storyboard_url || (d.reference_images?.[i % (d.reference_images?.length || 1)]?.url) || '';
          return `<article class="sb-result">
            ${url
              ? `<video controls preload="none" poster="${esc(sbUrl)}" src="${esc(url)}"></video>`
              : `<div class="sb-media-placeholder">${sbUrl ? `<img src="${esc(sbUrl)}" alt="Storyboard cảnh ${i + 1}" style="max-height:110px;object-fit:contain;border-radius:6px;margin:auto">` : ic(['error', 'failed'].includes(task.status) ? 'alert' : 'film')}<span>${esc(phase(task.status || 'draft'))}</span></div>`}
            <div class="sb-result-body">
              <header><b>Phân cảnh ${String(i + 1).padStart(2, '0')}</b><span class="chip xs">${esc(phase(task.status || 'draft'))}</span></header>
              <p>${esc(s.prompt)}</p>
              <small>${esc(continuityBadgeText(i, scenes.length))}</small>
              <small>${esc((s.character_ids || []).map((id) => d.characters?.find((c) => c.id === id)?.name || id).join(' · '))}</small>
              ${actual != null ? `<small>Thời lượng thực tế: ${Number(actual).toFixed(1)} giây</small>` : ''}
              ${task.message ? `<small>${esc(task.message)}</small>` : ''}
              ${task.error ? `<div class="rf-error">${esc(task.error)}</div>` : ''}
              ${!url && task.progress != null ? `<div class="sb-clip-progress"><i style="width:${Math.min(100, Math.max(0, Number(task.progress) || 0))}%"></i></div>` : ''}
              <div class="sb-actions" style="margin-top:8px">
                ${url ? `<a class="btn ghost xs" href="${esc(url)}" download>${ic('download')}Tải clip</a>` : ''}
                ${['error', 'failed', 'stopped', 'cancelled'].includes(task.status) ? `<button type="button" class="btn ghost xs" data-sb-retry-scene="${esc(s.id)}">Chạy lại cảnh</button>` : ''}
              </div>
            </div>
          </article>`;
        }).join('')}</div>
      </section>
      <section class="card" id="sbPostCard">
        <div class="sb-section-head">
          <h3>${ic('film')}Hậu Kỳ Phim Rạp: Nối Mượt Phân Cảnh, Nhạc Nền Theo Mạch Phim &amp; Phụ Đề Đa Quốc Gia</h3>
          <small>Cắt ghép sửa lỗi thành 1 bộ phim hoàn chỉnh mượt theo 1 dòng chảy không ngắt quãng cảm xúc</small>
        </div>
        <div id="sbPostEditor">${postHtml()}</div>
      </section>
    </div>`;
  }

  function currentEdit() {
    if (!$id('sbSubtitleLang') || !B.edit) return B.edit;
    const next = { ...B.edit };
    next.clips = [...root.querySelectorAll('[data-sb-edit-scene]')]
      .filter((el) => el.querySelector('[data-edit-enabled]').checked)
      .map((el) => ({
        scene_id: el.dataset.sbEditScene,
        trim_in: Number(el.querySelector('[data-edit-in]').value) || 0,
        trim_out: el.querySelector('[data-edit-out]').value === '' ? null : Number(el.querySelector('[data-edit-out]').value),
      }));
    next.subtitle_lang = $id('sbSubtitleLang').value;
    next.subtitles_srt = $id('sbSrtText').value;
    next.subtitle_tracks = { ...(next.subtitle_tracks || {}) };
    if (next.subtitle_lang) next.subtitle_tracks[next.subtitle_lang] = { srt: next.subtitles_srt };
    if ($id('sbMusicMode')) next.music_mode = $id('sbMusicMode').value;
    next.music_volume = Number($id('sbMusicVolume').value);
    next.dialogue_volume = Number($id('sbDialogueVolume').value);
    if ($id('sbCinemaAudio')) next.cinema_audio = $id('sbCinemaAudio').checked;
    if ($id('sbSeamlessFlow')) next.seamless_flow = $id('sbSeamlessFlow').checked;
    if ($id('sbAutoFixClips')) next.auto_fix_clips = $id('sbAutoFixClips').checked;
    return next;
  }

  function rememberEdit() {
    if (!B.edit) return;
    B.edit = currentEdit();
    B.editDirty = true;
  }

  function hydrateEdit(view) {
    B.editView = view;
    const e = view.edit || {};
    B.edit = {
      ...e,
      clips: Array.isArray(e.clips) ? e.clips.map((c) => ({ ...c })) : [],
      subtitle_lang: e.subtitle_lang || '',
      subtitles_srt: e.subtitle_tracks?.[e.subtitle_lang]?.srt || '',
      music_mode: e.music_mode || (e.music_file ? 'upload' : 'auto_cinematic'),
      music_volume: e.music_volume ?? 0.22,
      dialogue_volume: e.dialogue_volume ?? 1,
      cinema_audio: e.cinema_audio !== false,
      seamless_flow: e.seamless_flow !== false,
      auto_fix_clips: e.auto_fix_clips !== false,
    };
    B.editDirty = false;
  }

  function postHtml() {
    const view = B.editView, e = B.edit;
    if (!view || !e) return '<p class="hint">Đang tải dữ liệu clip và bàn dựng hậu kỳ…</p>';
    const source = view.clips || [];
    const eligible = source.filter((c) => c.path || c.url);
    const order = e.clips.map((c) => c.scene_id);
    const ordered = [
      ...e.clips.map((c) => eligible.find((s) => String(s.scene_id) === String(c.scene_id))).filter(Boolean),
      ...eligible.filter((c) => !order.some((id) => String(id) === String(c.scene_id))),
    ];
    const render = view.render || {};
    const rendering = ['queued', 'running', 'rendering', 'processing'].includes(render.status);
    const trackCount = Object.keys(e.subtitle_tracks || {}).filter((k) => e.subtitle_tracks[k]?.srt).length;
    return `<p class="sb-copy">Nối các phân cảnh 1 → N thành một bộ phim hoàn chỉnh mượt theo một dòng chảy cảm xúc, tự động xử lý điểm cắt, thêm nhạc nền điện ảnh theo từng phân cảnh, làm sống động âm thanh theo hành động/thoại và xuất phụ đề Tiếng Việt, Anh, Anh Mỹ, Nhật, Hàn, Tây Ban Nha, Úc, Canada cùng các nước thu nhập cao.</p>
      <div class="sb-checks" style="margin:12px 0">
        <label class="chk"><input type="checkbox" id="sbSeamlessFlow" ${e.seamless_flow !== false ? 'checked' : ''}><span>Nối mượt liên hoàn theo 1 dòng chảy (khử ngắt quãng cảm xúc giữa các cảnh)</span></label>
        <label class="chk"><input type="checkbox" id="sbAutoFixClips" ${e.auto_fix_clips !== false ? 'checked' : ''}><span>Tự cắt ghép &amp; sửa lỗi điểm nối đầu/cuối phân cảnh</span></label>
        <label class="chk"><input type="checkbox" id="sbCinemaAudio" ${e.cinema_audio !== false ? 'checked' : ''}><span>Âm thanh chuẩn rạp ngoài đời thực: sống động theo hành động &amp; rõ lời thoại nhân vật</span></label>
      </div>
      ${eligible.length
        ? `<div class="sb-edit-list">${ordered.map((c, i) => {
            const trim = e.clips.find((s) => String(s.scene_id) === String(c.scene_id));
            return `<div class="sb-edit-row" data-sb-edit-scene="${esc(c.scene_id)}">
              <b>${i + 1}</b>
              <label class="chk"><input type="checkbox" data-edit-enabled ${trim ? 'checked' : ''}><span>Cảnh ${c.order ?? ((B.detail.scenes || []).findIndex((s) => String(s.id) === String(c.scene_id)) + 1)} · ${c.duration != null ? Number(c.duration).toFixed(1) + ' giây' : 'đã có clip'}${c.shorter_than_target ? ' · ngắn hơn 15 giây' : ''}</span></label>
              <label>Bắt đầu (giây)<input class="input" type="number" min="0" step="0.1" data-edit-in value="${trim?.trim_in ?? 0}"></label>
              <label>Kết thúc (giây)<input class="input" type="number" min="0" step="0.1" data-edit-out value="${trim?.trim_out ?? (c.duration != null ? Math.min(15, c.duration) : '')}" placeholder="Hết clip"></label>
              <div class="sb-actions">
                <button type="button" class="icon-btn" data-sb-move="-1" aria-label="Đưa cảnh lên">${ic('chevron-up')}</button>
                <button type="button" class="icon-btn" data-sb-move="1" aria-label="Đưa cảnh xuống">${ic('chevron-down')}</button>
              </div>
            </div>`;
          }).join('')}</div>`
        : '<div class="sb-alert" style="margin-top:12px">Chưa có clip hoàn thành. Tạo clip trước để sắp xếp và dựng bộ phim hoàn chỉnh.</div>'}
      <div class="sb-post-settings">
        <div>
          <h4>Phụ đề Đa Ngôn Ngữ (VN, Anh, Mỹ, Nhật, Hàn, TBN, Úc, Canada &amp; Các Nước Thu Nhập Cao)</h4>
          <label class="field">
            <span>Ngôn ngữ phụ đề chèn vào phim &amp; đang chỉnh sửa (${trackCount} bản SRT sẵn sàng)</span>
            <select class="input select" id="sbSubtitleLang">
              <option value="">Không chèn phụ đề vào hình</option>
              ${opt((view.languages || []).length ? view.languages.map((l) => [l.code, l.label]) : LANGS, e.subtitle_lang)}
            </select>
          </label>
          <div class="sb-actions" style="margin:10px 0">
            <button type="button" class="btn primary-alt xs" id="sbAutoSubtitles">${ic('sparkles')}Tự tạo bộ phụ đề đa ngôn ngữ theo thoại phân cảnh</button>
            <button type="button" class="btn ghost xs" id="sbImportSrt">${ic('upload')}Nhập file .srt</button>
            <input type="file" id="sbSrtFile" accept=".srt,text/plain" hidden>
          </div>
          <label class="field">
            <span>Nội dung SRT theo thời gian bộ phim tổng</span>
            <textarea class="input" id="sbSrtText" rows="7" placeholder="1&#10;00:00:00,000 --> 00:00:03,000&#10;Nội dung phụ đề…">${esc(e.subtitles_srt || '')}</textarea>
          </label>
          <p class="hint">Hỗ trợ tự tạo phụ đề khớp mốc từng phân cảnh cho Tiếng Việt, Anh, Anh Mỹ, Nhật, Hàn, Tây Ban Nha, Úc, Canada và các nước thu nhập cao, hoặc nhập/dán phụ đề SRT đã dịch riêng (không tự dịch máy ngầm khi bạn nhập tay).</p>
        </div>
        <div>
          <h4>Nhạc nền Điện Ảnh &amp; Âm thanh Rạp Chiếu Phim</h4>
          <label class="field">
            <span>Chế độ nhạc nền theo phân cảnh</span>
            <select class="input select" id="sbMusicMode">
              ${opt([
                ['auto_cinematic', 'Tự tạo & phối nhạc nền điện ảnh biến thiên theo từng phân cảnh (Chuẩn rạp)'],
                ['upload', 'Dùng file nhạc tải lên + Phối âm sống động chuẩn rạp'],
                ['none', 'Không thêm nhạc nền (Chỉ giữ âm thanh hành động & thoại gốc)'],
              ], e.music_mode || 'auto_cinematic')}
            </select>
          </label>
          <div class="sb-actions" style="margin-top:10px">
            <label class="btn ghost xs">${ic('music')}Tải file nhạc riêng<input type="file" id="sbMusicFile" accept=".mp3,.wav,.m4a,.aac,.ogg,.flac,audio/*" hidden></label>
            <button type="button" class="btn ghost xs" id="sbRemoveMusic">Dùng nhạc điện ảnh tự động</button>
          </div>
          <p class="hint" id="sbMusicName">${esc(B.music?.name || e.music_name || e.music_file?.split(/[\\/]/).pop() || 'Nhạc nền điện ảnh tự động biến thiên mượt theo cảm xúc từng phân cảnh')}</p>
          <label class="field"><span>Âm lượng nhạc nền · <b id="sbMusicVolumeLabel">${Math.round(e.music_volume * 100)}%</b></span><input type="range" id="sbMusicVolume" min="0" max="1" step="0.01" value="${e.music_volume}"></label>
          <label class="field"><span>Âm lượng thoại &amp; hành động nhân vật · <b id="sbDialogueVolumeLabel">${Math.round(e.dialogue_volume * 100)}%</b></span><input type="range" id="sbDialogueVolume" min="0" max="2" step="0.01" value="${e.dialogue_volume}"></label>
          <p class="hint">Hệ thống cân bằng động (Cinema Mastering) giúp lời thoại và tiếng động hành động nổi bật, nhạc nền ôm theo dòng chảy của phim mà không lấn át giọng nhân vật.</p>
        </div>
      </div>
      <div class="sb-actions" style="margin-top:17px">
        <button type="button" class="btn primary-alt" id="sbRender" ${!eligible.length || rendering ? 'disabled' : ''}>${ic('film')}${rendering ? 'Đang dựng bộ phim hoàn chỉnh…' : 'Nối Cảnh, Phối Nhạc Rạp & Xuất Bộ Phim Hoàn Chỉnh'}</button>
        <button type="button" class="btn ghost" id="sbSaveEdit" ${rendering ? 'disabled' : ''}>${ic('check')}Lưu chỉnh sửa</button>
        ${rendering ? '<button type="button" class="btn ghost" id="sbCancelRender">Dừng dựng</button>' : ''}
      </div>
      ${render.status ? `<div class="sb-final-output"><p class="hint">${esc(phase(render.status))}${render.progress != null ? ' · ' + Math.round((Number(render.progress) || 0) * 100) + '%' : ''}</p>${render.error ? `<p class="rf-error">${esc(render.error)}</p>` : ''}${render.url ? `<video src="${esc(render.url)}" controls preload="metadata"></video><a class="btn primary-alt sm" href="${esc(render.url)}" download>${ic('download')}Tải bộ phim hoàn chỉnh</a>` : ''}${(render.srt_files || []).map((f) => `<a class="btn ghost xs" href="${esc(typeof f === 'string' ? fileUrl(f) : f.url || fileUrl(f.file || f.path))}" download>${ic('download')}SRT ${esc(f.lang || f.language || '')}</a>`).join('')}</div>` : ''}`;
  }

  async function loadEdit(keep = false) {
    if (!B.current) return;
    try {
      const view = await api('GET', `/api/scene-batches/${B.current}/edit`);
      if (!keep || !B.editDirty) hydrateEdit(view);
      else B.editView = view;
      const el = $id('sbPostEditor');
      if (el && !el.contains(document.activeElement) && ![...el.querySelectorAll('video')].some((v) => !v.paused)) {
        el.innerHTML = postHtml();
      }
    } catch (e) {
      if ($id('sbPostEditor')) $id('sbPostEditor').innerHTML = `<p class="rf-error">${esc(e.message)}</p>`;
    }
  }

  async function autoGenerateSubtitles() {
    if (B.busy || !B.current) return;
    B.edit = currentEdit();
    B.busy = true;
    try {
      const view = await api('POST', `/api/scene-batches/${B.current}/subtitles/auto`, { edit: B.edit });
      hydrateEdit(view);
      if ($id('sbPostEditor')) $id('sbPostEditor').innerHTML = postHtml();
      toast('Đã tạo bộ phụ đề đa ngôn ngữ (VN, Anh, Mỹ, Nhật, Hàn, TBN, Úc, Canada & các nước thu nhập cao) khớp mạch phân cảnh.', 'success');
    } catch (e) {
      notify(e);
    } finally {
      B.busy = false;
    }
  }

  async function saveEdit(render = false) {
    if (B.busy || !B.current) return;
    B.edit = currentEdit();
    B.busy = true;
    try {
      const view = await api('POST', `/api/scene-batches/${B.current}/${render ? 'render' : 'edit'}`, B.edit);
      if (render) {
        toast('Đã bắt đầu nối các phân cảnh, phối nhạc rạp và xuất bộ phim hoàn chỉnh.', 'success');
        await loadEdit(false);
      } else {
        hydrateEdit(view);
        $id('sbPostEditor').innerHTML = postHtml();
        toast('Đã lưu cài đặt dựng phim và phụ đề.', 'success');
      }
    } catch (e) {
      notify(e);
    } finally {
      B.busy = false;
    }
  }

  async function refresh(quiet = false) {
    if (B.loading) return;
    B.loading = true;
    try {
      const data = await api('GET', '/api/scene-batches');
      B.projects = data.projects || [];
      B.capacity = data.capacity || null;
      B.error = '';
      refreshDraftCapacity();
      list();
      if (!B.creating && B.current) {
        const requested = B.current;
        const d = await api('GET', `/api/scene-batches/${requested}`);
        if (String(requested) !== String(B.current)) return;
        B.detail = d;
        const main = $id('sbMain');
        const editing = main.contains(document.activeElement) && document.activeElement.matches('input,textarea,select');
        const playing = [...main.querySelectorAll('video')].some((v) => !v.paused);
        if (!quiet || (!editing && !playing)) {
          if (B.edit) B.edit = currentEdit();
          detailView();
          await loadEdit(quiet);
        }
      } else if (!$id('sbTitle')) {
        createView();
      }
    } catch (e) {
      B.error = e.message;
      list();
      if (!quiet) notify(e);
      if (!$id('sbMain').children.length) {
        $id('sbMain').innerHTML = `<div class="card"><h2>Chưa tải được phân cảnh</h2><p class="hint">${esc(e.message)}</p><button type="button" class="btn ghost" data-sb-refresh>Thử lại</button></div>`;
      }
    } finally {
      B.loading = false;
    }
  }

  function schedule() {
    clearTimeout(B.timer);
    B.timer = setTimeout(async () => {
      if (!active()) return;
      await refresh(true);
      schedule();
    }, 5000);
  }

  async function open() {
    shell();
    if (B.current && !B.detail) B.creating = false;
    await refresh();
    schedule();
  }

  async function selectProject(id) {
    if (B.creating) saveDraft();
    B.current = id;
    B.creating = false;
    B.edit = null;
    B.editView = null;
    B.editDirty = false;
    B.music = null;
    store.set('sceneBatchCurrent', id);
    await refresh();
  }

  function newProject() {
    if (B.busy) return;
    if (B.creating) saveDraft();
    B.current = null;
    B.detail = null;
    B.edit = null;
    B.editView = null;
    B.editDirty = false;
    B.creating = true;
    store.set('sceneBatchCurrent', null);
    list();
    createView();
  }

  async function action(name, scene_ids) {
    if (B.busy || !B.current) return;
    B.busy = true;
    try {
      await api('POST', `/api/scene-batches/${B.current}/${name}`, scene_ids ? { scene_ids } : {});
      await refresh();
    } catch (e) {
      notify(e);
    } finally {
      B.busy = false;
    }
  }

  root.addEventListener('input', (event) => {
    const el = event.target;
    if (B.creating) {
      if (el.dataset.sbRefLabel != null) B.draft.reference_images[Number(el.dataset.sbRefLabel)].label = el.value;
      if (el.matches('input,textarea,select')) saveDraft();
    } else {
      if (el.id === 'sbSubtitleLang') return;
      rememberEdit();
      if (el.id === 'sbMusicVolume') $id('sbMusicVolumeLabel').textContent = Math.round(el.value * 100) + '%';
      if (el.id === 'sbDialogueVolume') $id('sbDialogueVolumeLabel').textContent = Math.round(el.value * 100) + '%';
    }
  });

  root.addEventListener('change', async (event) => {
    const el = event.target;
    if (el.id === 'sbRefFiles') {
      await addRefs(el.files);
      el.value = '';
      return;
    }
    if (el.id === 'sbStoryboardBatchFiles') {
      await addSceneStoryboards(el.files, null);
      el.value = '';
      return;
    }
    if (el.id === 'sbSingleSceneStoryboardFile') {
      await addSceneStoryboards(el.files, B.targetSceneUploadIndex ?? 0);
      el.value = '';
      return;
    }
    if (el.id === 'sbSceneCountSelect') {
      const n = Number(el.value);
      if ($id('sbSceneCount')) $id('sbSceneCount').value = String(n);
      resizeScenesTo(n);
      return;
    }
    if (el.dataset.sceneSbSelect != null) {
      saveDraft();
      const idx = Number(el.dataset.sceneSbSelect);
      const chosenFile = el.value;
      const refObj = B.draft.reference_images.find((r) => r.file === chosenFile);
      if (B.draft.scenes[idx]) {
        B.draft.scenes[idx].storyboard_file = chosenFile;
        B.draft.scenes[idx].storyboard_name = refObj?.name || chosenFile;
        B.draft.scenes[idx].storyboard_url = refObj ? refUrl(refObj) : '';
      }
      store.set('sceneBatchDraft', B.draft);
      createView();
      return;
    }
    if (el.id === 'sbScenesFile' && el.files[0]) {
      try {
        if (el.files[0].size > 1024 * 1024) throw new Error('File câu lệnh tối đa 1 MB.');
        importLines(await svReadFile(el.files[0]));
      } catch (e) {
        notify(e);
      }
      return;
    }
    if (el.dataset.sbRefRole != null) {
      B.draft.reference_images[Number(el.dataset.sbRefRole)].role = el.value;
      saveDraft();
    }
    if (el.id === 'sbSrtFile' && el.files[0]) {
      try {
        if (el.files[0].size > 2 * 1024 * 1024) throw new Error('File SRT tối đa 2 MB.');
        $id('sbSrtText').value = await svReadFile(el.files[0]);
        rememberEdit();
      } catch (e) {
        notify(e);
      }
      el.value = '';
      return;
    }
    if (el.id === 'sbSubtitleLang') {
      const previous = B.edit?.subtitle_lang || '';
      const oldSrt = B.edit?.subtitles_srt || '';
      B.edit.subtitle_tracks = B.edit.subtitle_tracks || {};
      if (previous) B.edit.subtitle_tracks[previous] = { srt: oldSrt };
      B.edit.subtitle_lang = el.value;
      $id('sbSrtText').value = B.edit.subtitle_tracks[el.value]?.srt || '';
      rememberEdit();
      return;
    }
    if (el.id === 'sbMusicFile' && el.files[0]) {
      const f = el.files[0];
      try {
        if (f.size > 100 * 1024 * 1024) throw new Error('File nhạc tối đa 100 MB.');
        B.edit = currentEdit();
        const result = await api('POST', `/api/scene-batches/${B.current}/music?name=${encodeURIComponent(f.name)}`, undefined, f);
        B.music = result;
        B.edit.music_file = result.file;
        B.edit.music_name = result.name || f.name;
        B.edit.music_mode = 'upload';
        if ($id('sbMusicMode')) $id('sbMusicMode').value = 'upload';
        B.editDirty = true;
        $id('sbMusicName').textContent = result.name || f.name;
        toast('Đã tải nhạc nền cho bước dựng bộ phim tổng.', 'success');
      } catch (e) {
        notify(e);
      }
      el.value = '';
      return;
    }
    if (B.creating && el.matches('input,textarea,select')) saveDraft();
    else if (!B.creating) rememberEdit();
  });

  root.addEventListener('click', async (event) => {
    const el = event.target;
    const project = el.closest('[data-sb-project]');
    if (project) { selectProject(project.dataset.sbProject); return; }
    if (el.closest('[data-sb-new]')) { newProject(); return; }
    if (el.closest('[data-sb-refresh]')) { refresh(); return; }
    if (el.closest('#sbStart')) { submit(true); return; }
    if (el.closest('#sbSave')) { submit(false); return; }
    if (el.closest('[data-sb-start]')) { action('start'); return; }
    if (el.closest('[data-sb-retry]')) { action('retry'); return; }
    if (el.closest('[data-sb-stop]')) { action('stop'); return; }
    const retry = el.closest('[data-sb-retry-scene]');
    if (retry) { action('retry', [retry.dataset.sbRetryScene]); return; }
    if (el.closest('#sbImportScenes')) { $id('sbScenesFile').click(); return; }
    if (el.closest('#sbPasteScenes')) { pasteDialog(); return; }
    if (el.closest('#sbUploadStoryboards')) { $id('sbStoryboardBatchFiles')?.click(); return; }
    if (el.closest('#sbAutoContinuity')) { autoLinkContinuity(); return; }
    const pickSceneImg = el.closest('[data-sb-pick-scene-image]');
    if (pickSceneImg) {
      B.targetSceneUploadIndex = Number(pickSceneImg.dataset.sbPickSceneImage);
      $id('sbSingleSceneStoryboardFile')?.click();
      return;
    }
    const clearSceneImg = el.closest('[data-sb-clear-scene-image]');
    if (clearSceneImg) {
      saveDraft();
      const idx = Number(clearSceneImg.dataset.sbClearSceneImage);
      if (B.draft.scenes[idx]) {
        B.draft.scenes[idx].storyboard_file = '';
        B.draft.scenes[idx].storyboard_name = '';
        B.draft.scenes[idx].storyboard_url = '';
      }
      store.set('sceneBatchDraft', B.draft);
      createView();
      return;
    }
    const presetBtn = el.closest('[data-sb-preset-count]');
    if (presetBtn) {
      const n = Number(presetBtn.dataset.sbPresetCount);
      resizeScenesTo(n);
      return;
    }
    if (el.closest('#sbAddCharacter')) {
      saveDraft();
      if (B.draft.characters.length >= 20) return toast('Tối đa 20 hồ sơ nhân vật.', 'warn');
      const idx = B.draft.characters.length + 1;
      B.draft.characters.push({
        id: 'character_' + Math.random().toString(36).slice(2, 9),
        name: 'Nhân vật ' + idx,
        description: 'Giữ đồng nhất 100% khuôn mặt, kiểu tóc và trang phục theo ảnh tham chiếu ở mọi phân cảnh.',
        voice: 'Giọng tự nhiên, rõ chữ, cảm xúc sống động theo thoại và hành động; giữ cố định xuyên suốt các phân cảnh.',
        reference_file: B.draft.reference_images[0]?.file || '',
      });
      createView();
      return;
    }
    const removeChar = el.closest('[data-sb-remove-character]');
    if (removeChar) {
      saveDraft();
      const id = removeChar.dataset.sbRemoveCharacter;
      B.draft.characters = B.draft.characters.filter((c) => c.id !== id);
      B.draft.scenes.forEach((s) => { s.character_ids = s.character_ids.filter((c) => c !== id); });
      store.set('sceneBatchDraft', B.draft);
      createView();
      return;
    }
    const removeRef = el.closest('[data-sb-remove-ref]');
    if (removeRef) {
      saveDraft();
      const removed = B.draft.reference_images.splice(Number(removeRef.dataset.sbRemoveRef), 1)[0];
      B.draft.characters.forEach((c) => { if (c.reference_file === removed.file) c.reference_file = ''; });
      store.set('sceneBatchDraft', B.draft);
      createView();
      return;
    }
    if (el.closest('#sbResizeScenes')) {
      saveDraft();
      const n = Number($id('sbSceneCount').value);
      if (!Number.isInteger(n) || n < MIN_SCENES || n > MAX_SCENES) {
        return toast(`Chọn từ ${MIN_SCENES} đến ${MAX_SCENES} phân cảnh.`, 'warn');
      }
      if (n < B.draft.scenes.length && B.draft.scenes.slice(n).some((s) => s.prompt)) {
        if (!await confirmDialog(`Bỏ ${B.draft.scenes.length - n} ô phân cảnh cuối cùng?`, { title: 'Giảm số phân cảnh', ok: 'Bỏ các ô cuối' })) return;
      }
      resizeScenesTo(n);
      return;
    }
    if (el.closest('[data-sb-jump-edit]')) { $id('sbPostCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
    if (el.closest('#sbAutoSubtitles')) { autoGenerateSubtitles(); return; }
    if (el.closest('#sbImportSrt')) { $id('sbSrtFile').click(); return; }
    if (el.closest('#sbRemoveMusic')) {
      rememberEdit();
      B.edit.music_file = '';
      B.edit.music_name = '';
      B.edit.music_mode = 'auto_cinematic';
      if ($id('sbMusicMode')) $id('sbMusicMode').value = 'auto_cinematic';
      B.music = null;
      $id('sbMusicName').textContent = 'Nhạc nền điện ảnh tự động biến thiên mượt theo cảm xúc từng phân cảnh';
      return;
    }
    if (el.closest('#sbCancelRender')) {
      try {
        await api('POST', `/api/scene-batches/${B.current}/render/cancel`, {});
        await loadEdit(true);
      } catch (e) {
        notify(e);
      }
      return;
    }
    if (el.closest('#sbSaveEdit')) { saveEdit(false); return; }
    if (el.closest('#sbRender')) { saveEdit(true); return; }
    const move = el.closest('[data-sb-move]');
    if (move) {
      rememberEdit();
      const row = move.closest('[data-sb-edit-scene]');
      const other = Number(move.dataset.sbMove) < 0 ? row.previousElementSibling : row.nextElementSibling;
      if (other) {
        if (Number(move.dataset.sbMove) < 0) row.parentNode.insertBefore(row, other);
        else row.parentNode.insertBefore(other, row);
        rememberEdit();
        [...root.querySelectorAll('.sb-edit-row')].forEach((r, i) => { r.querySelector('b').textContent = i + 1; });
      }
      return;
    }
  });

  window.addEventListener('beforeunload', () => { if (B.creating && $id('sbTitle')) saveDraft(); });
  window.SceneBatch = { open, refresh };
  const oldOpen = window.ReferenceFilm.open;
  function setMode(mode, load = true) {
    window.ReferenceWorkspaceMode = mode === 'film' ? 'film' : 'scenes';
    store.set('referenceWorkspaceMode', window.ReferenceWorkspaceMode);
    $id('referenceFilmWorkspace').hidden = window.ReferenceWorkspaceMode !== 'film';
    root.hidden = window.ReferenceWorkspaceMode !== 'scenes';
    for (const id of ['rfRefresh', 'rfNew']) $id(id).hidden = window.ReferenceWorkspaceMode === 'scenes';
    page.querySelectorAll('[data-reference-workspace]').forEach((b) => {
      const on = b.dataset.referenceWorkspace === window.ReferenceWorkspaceMode;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (load) {
      if (window.ReferenceWorkspaceMode === 'scenes') open();
      else oldOpen();
    }
  }
  page.querySelectorAll('[data-reference-workspace]').forEach((b) => b.addEventListener('click', () => {
    if (B.creating && $id('sbTitle')) saveDraft();
    setMode(b.dataset.referenceWorkspace);
  }));
  window.ReferenceFilm.open = async () => {
    setMode(store.get('referenceWorkspaceMode', 'scenes'), false);
    if (window.ReferenceWorkspaceMode === 'scenes') await open();
    else await oldOpen();
  };
  setMode(store.get('referenceWorkspaceMode', 'scenes'), false);
})();
