function ic(name, cls = '') { return `<svg class="ic ${cls}" viewBox="0 0 24 24" aria-hidden="true">${ICONS[name] || ''}</svg>`; }
function hydrateIcons(root = document) {
  $$('i[data-icon]', root).forEach((el) => {
    const t = document.createElement('template');
    t.innerHTML = ic(el.dataset.icon, el.className || '');
    el.replaceWith(t.content.firstChild);
  });
}

/* ------------------------------------------------------------------ api */
async function api(method, url, data, raw) {
  const opt = { method, headers: { 'X-Muse-Request': '1' }, credentials: 'same-origin', cache: 'no-store' };
  if (raw !== undefined) { opt.headers['content-type'] = 'application/octet-stream'; opt.body = raw; }
  else if (data !== undefined || !['GET', 'HEAD'].includes(method)) { opt.headers['content-type'] = 'application/json'; opt.body = JSON.stringify(data ?? {}); }
  const controller = url === '/api/license/trial/redeem' ? new AbortController() : null;
  if (controller) opt.signal = controller.signal;
  const timer = controller ? setTimeout(() => controller.abort(), 8000) : null;
  let r, j;
  try {
    r = await fetch(url, opt);
    j = await r.json().catch(() => ({ ok: false, error: 'HTTP ' + r.status }));
  } catch (error) {
    if (controller?.signal.aborted) throw new Error('Tool chưa hoàn tất kích hoạt. Bấm kích hoạt lại; mốc 2 giờ đã lưu sẽ được giữ nguyên.');
    throw error;
  } finally { if (timer) clearTimeout(timer); }
  if (!j.ok) {
    if (r.status === 401) showSessionLost(j.error);
    if (j.license) setLicense(j.license);
    throw new Error(j.error || 'Có lỗi xảy ra');
  }
  return j.data;
}

