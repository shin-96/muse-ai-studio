function svReloadSoon(ms = 600) { if (S.page !== 'srt' || !SV.cur) return; clearTimeout(svTimer); svTimer = setTimeout(() => loadSrtDetail(), ms); }

async function loadSrt() {
  try {
    const r = await api('GET', '/api/srt');
    SV.list = r.projects || []; SV.styles = r.styles || [];
    SV.genres = r.genres || []; SV.langs = r.langs || []; SV.narrations = r.narrations || [];
