// 1.9.5 — ô API key VoiceTube ngay tại chỗ chọn lồng tiếng (không phải vào Cài đặt)
function vtKeyHtml() {
  const vt = S.vt;
  if (!vt || vt.pending) return '<small class="hint">Đang kiểm tra API key VoiceTube…</small>';
  if (vt.has_key) return `<small class="hint vt-ok">${ic('check')}API key VoiceTube ${esc(vt.masked || '')}${vt.credits != null ? ` · còn ${(+vt.credits).toLocaleString('vi-VN')} credit` : ''}${vt.error ? ` · <span class="warn-text">lỗi: ${esc(vt.error)}</span>` : ''}</small>`;
  return `<div class="vt-inline"><input class="input xs" type="password" data-vtkey placeholder="Dán API key VoiceTube (fvc_…)" autocomplete="off" spellcheck="false">
    <button type="button" class="btn xs" data-vtsave>${ic('key')}Lưu key</button></div>
    <small class="hint">Lấy key ở voicetube.net → API đối tác. Key được mã hoá, lưu trên máy này và dùng chung cho mọi phim.</small>`;
}
function vtEnsure(then) {
  if (S.vt && !S.vt.pending) { then?.(); return; }
  if (!S.vt) { S.vt = { has_key: false, pending: true }; api('GET', '/api/voicetube?check=1').then((r) => { S.vt = r; vtInfo(r); then?.(); }).catch(() => { S.vt = { has_key: false }; then?.(); }); }
}
async function vtSave(btn) {
  const box = btn.closest('.vt-inline'); const input = box && $('[data-vtkey]', box);
  const key = (input?.value || '').trim();
  if (!key) { toast('Dán API key VoiceTube vào ô trước', 'error'); input?.focus(); return; }
  btn.disabled = true;
  try {
    S.vt = await api('POST', '/api/voicetube', { key }); vtInfo(S.vt); FM.vtVoices = null;
    toast(`Đã lưu key VoiceTube — còn ${(+S.vt.credits || 0).toLocaleString('vi-VN')} credit`, 'success', 3500);
    renderFilmDub(); fmDubCreateRefresh();
  } catch (e) { toast(e.message, 'error', 6000); } finally { btn.disabled = false; }
}
document.addEventListener('click', (e) => { const b = e.target.closest('[data-vtsave]'); if (b) { e.preventDefault(); vtSave(b); } });
function fmDubCreateRefresh() {
  const box = $('#fmDubKey'); if (!box) return;
  const on = ($('#fmDubSeg button.on')?.dataset.v || 'off') === 'on';
  box.hidden = !on; if (on) box.innerHTML = vtKeyHtml();
}
// giọng vùng (Bắc / Trung / Nam) chỉ có nghĩa với tiếng Việt
function accentToggle(langSel, accentSel) {
  const l = $(langSel), a = $(accentSel); if (!l || !a) return;
  const f = a.closest('.field') || a.closest('label'); if (f) f.style.display = l.value !== 'vi' ? 'none' : '';
}

function renderFilmDub() {
  const box = $('#fmDub'); if (!box || !FM.data) return;
  if (FM.vtVoicesLang && FM.vtVoicesLang !== (FM.data.settings?.lang || 'vi')) FM.vtVoices = null;   // đổi ngôn ngữ phim
  box.innerHTML = fmDubHtml(FM.data);
  if (!S.vt) { S.vt = { has_key: false, pending: true }; api('GET', '/api/voicetube?check=1').then((r) => { S.vt = r; renderFilmDub(); }).catch(() => {}); }
  else if (FM.data.settings?.dub && S.vt.has_key && !FM.vtVoices && !FM.vtLoading) {
    FM.vtLoading = true;
    const lang = FM.data.settings?.lang || 'vi';
    api('GET', `/api/voicetube/voices?lang=${encodeURIComponent(lang)}`).then((r) => { FM.vtVoices = r.voices || []; FM.vtVoicesLang = lang; renderFilmDub(); })
      .catch((e) => toast(e.message, 'error', 5000)).finally(() => { FM.vtLoading = false; });
  }
}
function fmMixChip(s) {
  const m = s.mix; if (!m) return '';
  const bits = [];
  if (m.lcut) bits.push('nghe tiếp tiếng câu trước (L-cut)');
  if (m.stray) bits.push('vùi tiếng người lạ trong shot im lặng');
  if (m.eq) bits.push('khớp màu giọng với các câu khác của nhân vật');
  if (m.sep) bits.push(`tách giọng khỏi nhân vật giống giọng (${m.sep > 0 ? '+' : ''}${(+m.sep).toFixed(1)} cung cả giọng)`);
  if (Math.abs(m.shift || 0) >= 0.6) bits.push(`cao độ ${m.shift > 0 ? '+' : ''}${m.shift.toFixed(1)} cung`);
  if (Math.abs(m.gain || 0) >= 0.5) bits.push(`âm lượng ${m.gain > 0 ? '+' : ''}${m.gain.toFixed(1)} dB`);
  return bits.length ? `<span class="chip xs" title="Lần dựng gần nhất: ${esc(bits.join(' · '))}">${ic('sliders')}cân âm</span>` : '';
}

const FM_QA = { no_speech: 'không có lời', wrong_text: 'nói sai câu', extra: 'nói thêm câu lạ', partial: 'thiếu vài chữ', voice: 'giọng không hợp nhân vật',
  voice_drift: 'lệch giọng nhân vật' };
function fmQaChip(s) {
  const q = s.qa; if (!q || !s.clip_url || !(s.lines || []).length) return '';
  const heard = q.heard ? ` — nghe được: "${q.heard}"` : '';
  const take = s.takes > 1 ? ` (lần tạo ${s.takes})` : '';
  const names = Object.fromEntries((FM.data?.characters || []).map((c) => [c.id, c.name]));
  const vs = q.vsim != null ? ` · giống giọng các câu khác của nhân vật ${q.vsim.toFixed(2)}${q.vnear && q.vmargin != null && q.vmargin < 0.05 ? ` (gần giọng ${names[q.vnear] || q.vnear})` : ''}` : '';
  const tip = (q.engine === 'asr' ? `Tool nghe lại clip: khớp ${Math.round((q.match || 0) * 100)}% lời thoại` : 'Tool kiểm tra clip có tiếng nói') + (q.f0 ? ` · giọng ~${q.f0} Hz` : '') + vs + heard + take;
  if (q.ok && !q.issue) return `<span class="chip xs ok" title="${esc(tip)}">${ic('check')}${q.engine === 'asr' ? `lời khớp ${Math.round((q.match || 0) * 100)}%` : 'có lời'}</span>`;
  if (q.ok) return `<span class="chip xs warn" title="${esc(tip)}">${FM_QA[q.issue] || q.issue}</span>`;
  return `<span class="chip xs bad" title="${esc(tip)}">${ic('info')}${FM_QA[q.issue] || 'lỗi lời thoại'}${take}</span>`;
}

async function fmSave(patch) {
  try { FM.data = await api('POST', `/api/film/${FM.cur}/settings`, patch); renderFilmMain(); } catch (e) { toast(e.message, 'error', 5000); renderFilmMain(); }
}

function fmCollectLines(box) {
  return $$('.fm-line', box).map((r) => ({ speaker: $('.fm-spk', r).value, to: r.dataset.to || '', text: $('.fm-txt', r).value.trim(),
    ...(r.dataset.emo ? { emotion: r.dataset.emo } : {}) })).filter((x) => x.text);
}

async function fmSaveLines(sbox) {
  const sid = +sbox.dataset.sid;
  try {
    FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: sid, lines: fmCollectLines(sbox) });
    const s = (FM.data.shot_list || []).find((x) => x.id === sid);
    toast(s?.stale ? `Đã lưu lời thoại cảnh #${sid} — bấm Tạo lại clip để nhân vật nói lời mới` : `Đã lưu lời thoại cảnh #${sid}`, 'success', 2200);
    if (s && sbox.isConnected) sbox.outerHTML = fmShotHtml(s);      // chỉ vẽ lại cảnh này (không làm mất chỗ đang gõ ở cảnh khác)
    renderFilmHead(); renderFmPickBar();
  } catch (err) { toast(err.message, 'error', 5000); }
}

function fmPlay(url, title) {
  const d = FM.data; if (!url && !d?.video_url) return;
  openModal({ title: title || d.name, icon: 'film', wide: true, body: `<video src="${esc(url || d.video_url)}" controls autoplay style="width:100%;border-radius:10px;background:#000"></video>`,
    foot: url ? [{ label: 'Đóng', cls: 'ghost' }] : [{ label: 'Mở thư mục', cls: 'ghost', icon: 'folder-open', onClick: () => openPath(d.video_path, true) }, { label: 'Đóng', cls: 'ghost' }] });
}

async function fmRun(action, only) {
  const labels = { all: 'làm phim tự động', continue: 'chạy tiếp', script: 'viết kịch bản', music: 'tạo nhạc nền', refs: 'tạo ảnh nhân vật',
    images: 'tạo ảnh cảnh', clips: 'tạo clip thoại', render: 'dựng phim', fix: 'AI sửa prompt + tạo lại ảnh', fixclip: 'AI sửa + tạo lại clip',
    dub: 'lồng tiếng VoiceTube' };
  try {
    await api('POST', `/api/film/${FM.cur}/run`, only ? { action, only } : { action });
    toast(`Đang ${labels[action] || action}${only ? ` cho ${only.length} cảnh` : ''}`, 'success', 2000);
    loadFilmDetail();
  } catch (err) { toast(err.message, 'error', 5000); }
}

function bindFilm() {
  $('#fmNewBtn').onclick = () => { FM.creating = true; renderFilmList(); renderFilmMain(); };
  $('#fmList').onclick = (e) => {
    if (e.target.closest('[data-fmnew]')) { FM.creating = true; renderFilmList(); renderFilmMain(); return; }
    if (e.target.closest('[data-queue]')) { openQueue('film'); return; }
    const b = e.target.closest('[data-fm]'); if (!b) return;
    FM.cur = +b.dataset.fm; FM.creating = false; store.set('filmCur', FM.cur); FM.filter = 'all'; FM.limit = 40; FM.picked.clear();
    renderFilmList(); loadFilmDetail();
  };
  const main = $('#fmMain');
  main.addEventListener('input', (e) => {
    if (e.target.id === 'fmMinutes') fmUpdateEstimate();
    if (e.target.matches('input[type=range]')) { const m = e.target.parentElement.querySelector('.mono'); if (m) m.textContent = `${Math.round(e.target.value * 100)}%`; }
  });
  main.addEventListener('click', async (e) => {
    const t = e.target;
    // --- form tạo phim
    const segb = t.closest('#fmRatio [data-v], #fmMusic [data-v], #fmDubSeg [data-v]');
    if (segb) {
      $$('button', segb.parentElement).forEach((x) => x.classList.toggle('on', x === segb)); fmUpdateEstimate();
      if (segb.closest('#fmDubSeg')) { fmDubCreateRefresh(); vtEnsure(fmDubCreateRefresh); }
      return;
    }
    if (t.closest('#fmGo')) { fmCreate(true); return; }
    if (t.closest('#fmBulk')) { const { idea, ...rest } = fmCreateSettings(); store.set('filmDraft', { ...rest, idea: '' }); fmBulkDialog(); return; }
    if (t.closest('#fmCreateOnly')) { fmCreate(false); return; }
    if (t.closest('#fmCancelNew')) { FM.creating = false; if (!FM.cur && FM.list.length) FM.cur = FM.list[0].id; renderFilmList(); loadFilmDetail(); return; }
    if (!FM.data) return;
    // --- phim đang mở
    const zoom = t.closest('[data-zoom]'); if (zoom) { svZoom(zoom.dataset.zoom); return; }
    const clip = t.closest('[data-clip]'); if (clip) { fmPlay(clip.dataset.clip, `Clip cảnh #${clip.closest('[data-sid]')?.dataset.sid || ''}`); return; }
    const dplay = t.closest('[data-dubplay]'); if (dplay) { fmAudio(dplay.dataset.dubplay); return; }
    if (t.closest('[data-goset]')) { showPage('settings'); return; }
    if (t.closest('[data-dubcast]')) {
      try { FM.data = await api('POST', `/api/film/${FM.cur}/cast`, { auto: true }); renderFilmDub(); toast('Đã phân vai giọng theo giới tính, tuổi, vùng miền và chất giọng của từng nhân vật', 'success', 3000); }
      catch (err) { toast(err.message, 'error', 6000); } return;
    }
    const dtest = t.closest('[data-dubtest]');
    if (dtest) {
      const cid = dtest.closest('[data-castc]').dataset.castc; dtest.disabled = true;
      toast('VoiceTube đang đọc thử câu đầu của nhân vật (~30–40 giây)…', 'info', 4000);
      try { const r = await api('POST', `/api/film/${FM.cur}/dubtest`, { char: cid }); fmAudio(r.url); loadFilmDetail(); }
      catch (err) { toast(err.message, 'error', 6000); } finally { dtest.disabled = false; } return;
    }
    const run = t.closest('[data-fmrun]');
    if (run) {
      const action = run.dataset.fmrun;
      if (action === 'script' && FM.data.shots > 0 && !confirm('Viết lại kịch bản sẽ thay toàn bộ nhân vật, cảnh và lời thoại hiện có. Tiếp tục?')) return;
      if (action === 'music' && FM.data.music && !confirm('Muse sẽ sáng tác bản nhạc mới thay bản hiện tại. Tiếp tục?')) return;
      fmRun(action); return;
    }
    if (t.closest('#fmStop')) { try { await api('POST', `/api/film/${FM.cur}/stop`); loadFilmDetail(); } catch (err) { toast(err.message, 'error'); } return; }
    if (t.closest('#fmPlay')) { fmPlay(); return; }
    if (t.closest('#fmReveal')) { openPath(FM.data.video_path, true); return; }
    if (t.closest('#fmDel')) {
      if (!confirm(`Xoá dự án phim "${FM.data.name}"? Ảnh, clip và phim đã tạo vẫn còn trong Studio / Thư viện.`)) return;
      try { await api('DELETE', `/api/film/${FM.cur}`); FM.cur = null; FM.data = null; store.set('filmCur', null); loadFilm(); } catch (err) { toast(err.message, 'error'); }
      return;
    }
    if (t.closest('#fmLogoDel')) { fmSave({ logo: '' }); return; }
    const mm = t.closest('#fmMusicMode [data-v]');
    if (mm) { if (mm.dataset.v !== FM.data.settings?.music_mode) fmSave({ music_mode: mm.dataset.v }); return; }
    if (t.closest('#fmMusicDel')) { try { FM.data = await api('DELETE', `/api/film/${FM.cur}/audio`); renderFilmMain(); } catch (err) { toast(err.message, 'error'); } return; }
    const ratio = t.closest('#fmERatio [data-r]'); if (ratio) { fmSave({ ratio: ratio.dataset.r }); return; }
    for (const [btn, inp, key] of [['#fmImgApply', '#fmImgThreads', 'img_threads'], ['#fmVidApply', '#fmVidThreads', 'vid_threads']]) {
      if (t.closest(btn)) {
        const n = Math.max(1, Math.min(50, +$(inp).value || 1));
        try { const cap = await api('POST', '/api/srt/threads', { [key]: n }); toast(`Đã đặt ${n} luồng ${key === 'img_threads' ? 'ảnh' : 'video'} cho ${cap.accounts} tài khoản`, 'success', 3000); loadFilmDetail(); } catch (err) { toast(err.message, 'error', 5000); }
        return;
      }
    }
    const f = t.closest('#fmFilter [data-f]'); if (f) { FM.filter = f.dataset.f; FM.limit = 40; $$('#fmFilter button').forEach((x) => x.classList.toggle('on', x === f)); renderFilmShots(); return; }
    if (t.closest('#btnFmMore')) { FM.limit += 40; renderFilmShots(); return; }
    const cdel = t.closest('[data-cdel]');
    if (cdel) { try { FM.data = await api('POST', `/api/film/${FM.cur}/character`, { id: cdel.closest('[data-cid]').dataset.cid, ref: '' }); renderFilmMain(); } catch (err) { toast(err.message, 'error'); } return; }
    const sbox = t.closest('[data-sid]');
    const sid = sbox ? +sbox.dataset.sid : 0;
    if (t.closest('[data-ladd]')) {
      const box = t.closest('.fm-lines');
      const first = Object.keys(Object.fromEntries((FM.data.characters || []).map((c) => [c.id, 1])))[0] || 'narrator';
      const row = document.createElement('div');
      row.className = 'fm-line';
      row.innerHTML = `<select class="input xs select fm-spk">${(FM.data.characters || []).map((c) => `<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('')}${FM.data.settings?.narrator ? '<option value="narrator">Người dẫn chuyện</option>' : ''}</select>
        <input class="input xs fm-txt" placeholder="Lời thoại…"><button class="btn ghost xs" data-ldel>${ic('x')}</button>`;
      $('.fm-spk', row).value = first;
      box.insertBefore(row, t.closest('[data-ladd]'));
      if ($$('.fm-line', box).length >= 3) t.closest('[data-ladd]').remove();
      $('.fm-txt', row).focus();
      return;
    }
    if (t.closest('[data-ldel]')) { t.closest('.fm-line').remove(); fmSaveLines(sbox); return; }
    if (t.closest('[data-regen]')) { fmRun('images', [sid]); return; }
    if (t.closest('[data-fixone]')) { fmRun('fix', [sid]); return; }
    if (t.closest('[data-regclip]')) { fmRun('clips', [sid]); return; }
    if (t.closest('[data-restore]')) {
      const shot = (FM.data.shot_list || []).find((x) => x.id === sid);
      if (shot?.scene_orig) { try { FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: sid, scene: shot.scene_orig }); renderFilmMain(); } catch (err) { toast(err.message, 'error'); } }
      return;
    }
    const pbad = t.closest('[data-pick-bad]');
    if (pbad) { (FM.data.shot_list || []).filter(pbad.dataset.pickBad === 'clip' ? fmClipBad : fmImgBad).forEach((x) => FM.picked.add(x.id)); FM.filter = 'error'; renderFilmMain(); return; }
    if (t.closest('[data-pick-none]')) { FM.picked.clear(); renderFilmShots(); return; }
    const prun = t.closest('[data-pick-run]');
    if (prun) { const only = [...FM.picked].sort((a, b) => a - b); if (!only.length) return; FM.picked.clear(); fmRun(prun.dataset.pickRun, only); }
  });
  main.addEventListener('change', async (e) => {
    const t = e.target;
    if (t.id === 'fmLang') { accentToggle('#fmLang', '#fmAccent'); return; }
    if (!FM.data || FM.creating) return;
    const map = { fmEIdea: ['idea', 'value'], fmEGenre: ['genre', 'value'], fmEMinutes: ['minutes', 'num'], fmELang: ['lang', 'value'],
      fmENarr: ['narrator', 'checked'], fmEStyle: ['style', 'value'], fmEStyleText: ['style_text', 'value'], fmESubs: ['subtitles', 'checked'],
      fmESubScale: ['sub_scale', 'num'], fmEClipVol: ['clip_volume', 'num'], fmERefs: ['char_refs', 'checked'], fmEAutoFix: ['auto_fix', 'checked'],
      fmEMotion: ['motion', 'value'], fmEMotionStrength: ['motion_strength', 'value'], fmEShake: ['shake', 'value'], fmEFps: ['fps', 'num'],
      fmEAccent: ['accent', 'value'], fmEPace: ['pace', 'value'], fmERender: ['render_threads', 'num'], fmMusicVol: ['music_volume', 'num'], fmDuck: ['duck', 'checked'],
      fmESceneCards: ['scene_cards', 'checked'], fmENameCards: ['name_cards', 'checked'], fmEBookends: ['bookends', 'checked'],
      fmEVoiceCheck: ['voice_check', 'checked'], fmEVoiceMatch: ['voice_match', 'checked'], fmEAudioLevel: ['audio_level', 'checked'],
      fmEVoiceEq: ['voice_eq', 'checked'], fmEVoiceSep: ['voice_sep', 'checked'], fmEDub: ['dub', 'checked'],
      fmEColdOpen: ['cold_open', 'checked'], fmEHook: ['hook', 'num'] };
    try {
      if (['fmEMotion', 'fmEMotionStrength', 'fmEShake'].includes(t.id)) mvLive('fmE', t);
      if (map[t.id]) { const [key, how] = map[t.id]; return fmSave({ [key]: how === 'checked' ? t.checked : how === 'num' ? +t.value : t.value }); }
      if (t.id === 'fmLogoFile' && t.files[0]) { const fid = await svUpload(t.files[0]); return fmSave({ logo: fid }); }
      if (t.id === 'fmMusicFile' && t.files[0]) {
        const f = t.files[0];
        if (f.size > 300 * 1024 * 1024) { toast('File nhạc quá lớn (tối đa 300 MB)', 'error'); return; }
        toast(`Đang tải ${f.name}…`, 'info', 2000);
        FM.data = await api('POST', `/api/film/${FM.cur}/audio?name=${encodeURIComponent(f.name)}`, undefined, f);
        renderFilmMain(); toast('Đã gắn nhạc nền của bạn — áp dụng khi dựng phim', 'success', 2500); return;
      }
      if (t.matches('[data-pick]')) { const sid = +t.closest('[data-sid]').dataset.sid; if (t.checked) FM.picked.add(sid); else FM.picked.delete(sid); t.closest('.sv-shot').classList.toggle('picked', t.checked); renderFmPickBar(); return; }
      const cbox = t.closest('[data-cid]');
      if (cbox && t.dataset.cf) {
        FM.data = await api('POST', `/api/film/${FM.cur}/character`, { id: cbox.dataset.cid, [t.dataset.cf]: t.value });
        toast(t.dataset.cf === 'voice' ? 'Đã lưu giọng nói — áp dụng cho clip tạo sau' : 'Đã lưu nhân vật — áp dụng cho ảnh tạo sau', 'success', 1800); return;
      }
      if (cbox && t.matches('[data-cup]') && t.files[0]) { const fid = await svUpload(t.files[0]); FM.data = await api('POST', `/api/film/${FM.cur}/character`, { id: cbox.dataset.cid, ref: fid }); renderFilmMain(); return; }
      const sbox = t.closest('[data-sid]');
      if (sbox && (t.classList.contains('fm-spk') || t.classList.contains('fm-txt'))) {
        if (t.classList.contains('fm-spk') && !$('.fm-txt', t.closest('.fm-line')).value.trim()) return;   // câu mới chưa có lời → chờ gõ
        await fmSaveLines(sbox); return;
      }
      if (sbox && t.classList.contains('fm-face')) { FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: +sbox.dataset.sid, face: t.value }); toast(`Đã lưu biểu cảm shot #${sbox.dataset.sid} — bấm Ảnh rồi Tạo lại clip để áp dụng`, 'success', 2200); return; }
      if (sbox && t.classList.contains('fm-cam')) {
        FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: +sbox.dataset.sid, camera: t.value });
        toast(`Đã đổi máy quay shot #${sbox.dataset.sid} — bấm Tạo lại clip để áp dụng`, 'success', 2200); return;
      }
      const crow = t.closest('[data-castc]');
      if (crow && (t.classList.contains('fm-castv') || t.classList.contains('fm-casts'))) {
        const body = { char: crow.dataset.castc, ...(t.classList.contains('fm-castv') ? { voice: t.value } : { speed: +t.value }) };
        FM.data = await api('POST', `/api/film/${FM.cur}/cast`, body); renderFilmDub();
        toast('Đã đổi giọng — câu đã lồng của nhân vật này sẽ đọc lại khi bấm Lồng tiếng', 'success', 2600); return;
      }
      if (sbox && t.classList.contains('fm-type')) {
        FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: +sbox.dataset.sid, type: t.value });
        const s = (FM.data.shot_list || []).find((x) => x.id === +sbox.dataset.sid);
        if (s && sbox.isConnected) sbox.outerHTML = fmShotHtml(s);
        toast(`Đã đổi shot #${sbox.dataset.sid} sang ${FM_TYPE[t.value]?.[0] || t.value} — bấm Ảnh rồi Tạo lại clip để áp dụng`, 'success', 2600); return;
      }
      if (sbox && t.classList.contains('sv-scene')) { FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: +sbox.dataset.sid, scene: t.value }); toast(`Đã lưu khung hình cảnh #${sbox.dataset.sid}`, 'success', 1400); }
      if (sbox && t.classList.contains('sv-motion')) { FM.data = await api('POST', `/api/film/${FM.cur}/shot`, { id: +sbox.dataset.sid, motion: t.value }); toast(`Đã lưu hành động cảnh #${sbox.dataset.sid} — áp dụng khi tạo lại clip`, 'success', 1800); }
    } catch (err) { toast(err.message, 'error', 5000); }
  });
}

