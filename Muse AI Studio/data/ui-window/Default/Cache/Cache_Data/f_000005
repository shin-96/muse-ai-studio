      ${(d.photos || []).length < 8 ? `<label class="af-ph add">${ic('upload')}<small>Thêm ảnh</small><input type="file" id="afPhotoAdd" accept="image/png,image/jpeg,image/webp" multiple hidden></label>` : ''}</div>
    <label class="field"><span>Giá hiển thị ${p.source === 'shopee' ? '<em>(theo trang Shopee lúc đọc)</em>' : ''}</span><input class="input sm" id="afPrPrice" value="${esc(p.price_min ? (p.price_max && p.price_max !== p.price_min ? `${afMoney(p.price_min)} - ${afMoney(p.price_max)}` : afMoney(p.price_min)) : (p.price_note || ''))}" placeholder="vd: 199000" ${live ? 'disabled' : ''}></label>
