    foot: [{ label: 'Huỷ', cls: 'ghost' }, { label: 'Nhập', cls: 'primary-alt', icon: 'upload', onClick: async (bg) => {
      const settings = { style: $('#svNewStyle', bg).value, ratio: ($('#svNewRatio button.on', bg) || {}).dataset?.r || '16:9',
        shot_sec: Math.max(2, Math.min(15, +$('#svNewSec', bg).value || 5.4)), mode: ($('#svNewMode button.on', bg) || {}).dataset?.m || 'slide' };
      store.set('srtStyle', settings.style); store.set('srtRatio', settings.ratio); store.set('srtSec', settings.shot_sec); store.set('srtMode', settings.mode);
      const d = await api('POST', '/api/srt', { name: $('#svNewName', bg).value.trim() || name, srt: text, srt_name: file.name, settings });
      SV.cur = d.id; store.set('srtCur', d.id); SV.data = d; SV.filter = 'all'; SV.limit = 60;
