  box.innerHTML = `<button class="sv-item fm-new ${AF.creating ? 'on' : ''}" data-afnew>${ic('plus')}<b>Video mới</b><small>Dán link Shopee → làm trọn bộ</small></button>${queueCardHtml('aff')}${items}`;
}

