          ${(s.props || []).map((x) => { const pr = (FM.data.props || []).find((y) => y.id === x); return pr ? `<span class="chip xs" title="${esc(pr.look || '')}">${ic('box')}${esc(pr.name)}</span>` : ''; }).join('')}
