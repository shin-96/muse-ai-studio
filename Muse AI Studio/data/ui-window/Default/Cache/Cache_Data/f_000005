/* ---------------- cảnh */
const afImgBad = (s) => !s.image_url && !!(s.error || ['error', 'stopped'].includes(s.task_status));
const afClipBad = (s) => !!s.image_url && (!!s.stale || (!s.clip_url && !!(s.clip_error || ['error', 'stopped'].includes(s.clip_status))));

function afVisibleShots() {
  const list = AF.data?.shot_list || [];
  if (AF.filter === 'missing') return list.filter((s) => !s.image_url);
  if (AF.filter === 'noclip') return list.filter((s) => !s.clip_url || s.stale);
  if (AF.filter === 'check') return list.filter((s) => (s.check || []).length);
  if (AF.filter === 'error') return list.filter((s) => afImgBad(s) || afClipBad(s));
  return list;
}

function renderAfPickBar() {
  const box = $('#afPickBar'); if (!box || !AF.data) return;
  const ids = new Set((AF.data.shot_list || []).map((s) => s.id));
  [...AF.picked].forEach((id) => { if (!ids.has(id)) AF.picked.delete(id); });
  const n = AF.picked.size;
  const bad = (AF.data.shot_list || []).filter(afImgBad).length;
  const cbad = (AF.data.shot_list || []).filter(afClipBad).length;
  const off = AF.data.busy ? 'disabled' : '';
  box.innerHTML = `
    <button class="btn ghost xs" data-afpick-bad="img" ${bad ? '' : 'disabled'}>${ic('check')}Chọn ảnh lỗi (${bad})</button>
    <button class="btn ghost xs" data-afpick-bad="clip" ${cbad ? '' : 'disabled'}>${ic('check')}Chọn clip cần làm lại (${cbad})</button>
    ${n ? `<span class="sv-pick-n">Đã chọn ${n}</span>
      <button class="btn ghost xs" data-afpick-none>${ic('x')}Bỏ chọn</button>
      <button class="btn xs" data-afpick-run="images" ${off}>${ic('refresh')}Tạo lại ảnh</button>
      <button class="btn primary-alt xs" data-afpick-run="fix" ${off}>${ic('wand')}AI sửa + tạo lại ảnh</button>
      <button class="btn xs" data-afpick-run="clips" ${off}>${ic('video')}Tạo lại clip</button>` : ''}`;
}

function renderAffShots() {
  const box = $('#afShots'); if (!box || !AF.data) return;
  renderAfPickBar();
  const all = afVisibleShots(); const items = all.slice(0, AF.limit);
  const beats = Object.fromEntries((AF.data.beats || []).map((b) => [b.id, b]));
  const names = AF.opts.beats || {};
  let last = null;
  box.innerHTML = items.map((s) => {
    const b = beats[s.beat];
    const head = b && s.beat !== last ? `<div class="fm-beat"><b>${esc(names[b.function] || b.function)}</b><small>cảnh ${b.a}${b.b !== b.a ? `–${b.b}` : ''}</small></div>` : '';
    last = s.beat;
    return head + afShotHtml(s, b ? (names[b.function] || b.function) : '');
  }).join('') || `<p class="hint" style="padding:12px">${(AF.data.shot_list || []).length ? 'Không có cảnh nào trong bộ lọc này.' : 'Chưa có kịch bản — bấm <b>Làm video tự động</b> hoặc <b>Kịch bản</b>.'}</p>`;
  $('#afMore').hidden = all.length <= AF.limit;
}

function afShotHtml(s, beatName) {
  const d = AF.data; const st = d.settings || {};
  if (beatName === undefined) {
    const b = (d.beats || []).find((x) => x.id === s.beat);
    beatName = b ? ((AF.opts.beats || {})[b.function] || b.function) : '';
  }
  const ratio = (st.ratio || '9:16').replace(':', ' / ');
  const off = d.busy;
  const hasHost = (d.characters || []).some((c) => c.id === 'host');
  const busy = ['queued', 'running'].includes(s.task_status);
  const cbusy = ['queued', 'running'].includes(s.clip_status);
  const bad = afImgBad(s); const cbad = !s.stale && afClipBad(s);
  const line = (s.lines || [])[0];
  const tag = !s.image_url ? '' : s.clip_url ? `<button class="sv-clip-tag ok" data-clip="${esc(s.clip_url)}">${ic('play')}clip${s.stale ? ' · lời cũ' : ''}</button>`
    : cbusy ? `<span class="sv-clip-tag">${s.clip_status === 'running' ? `clip ${Math.round(s.clip_progress || 0)}%` : 'chờ clip'}</span>`
    : cbad ? '<span class="sv-clip-tag bad">clip lỗi</span>' : '';
  return `<div class="sv-shot af-shot ${bad || cbad ? 'bad' : ''} ${AF.picked.has(s.id) ? 'picked' : ''}" data-sid="${s.id}">
    <div class="sv-thumb" style="aspect-ratio:${ratio}">${s.image_url ? `<img src="${esc(s.image_url)}" loading="lazy" alt="" data-zoom="${esc(s.image_url)}">`
      : `<span>${busy ? (s.task_status === 'running' ? `Đang tạo ${Math.round(s.task_progress || 0)}%` : 'Chờ tạo') : bad ? 'Lỗi' : 'Chưa có ảnh'}</span>`}${tag}${shotTimeTag(s)}</div>
    <div class="sv-shot-body">
      <div class="sv-shot-top"><label class="sv-pick"><input type="checkbox" data-afpick ${AF.picked.has(s.id) ? 'checked' : ''}></label><b>#${s.id}</b>
        ${beatName ? `<span class="chip xs af-beat-chip" title="Phần của video">${esc(beatName)}</span>` : ''}
        ${hasHost ? `<select class="input xs select af-kind" title="Người dẫn xuất hiện nói, hay cảnh sản phẩm (giọng ngoài khung)">${Object.entries({ presenter: 'Người dẫn', product: 'Sản phẩm' }).map(([k, l]) => `<option value="${k}" ${s.kind === k ? 'selected' : ''}>${l}</option>`).join('')}</select>` : `<span class="chip xs">${s.kind === 'presenter' ? 'Người dẫn' : 'Sản phẩm'}</span>`}
        <label class="chk af-has" title="Cảnh có sản phẩm → đính kèm ảnh thật sản phẩm khi tạo ảnh"><input type="checkbox" class="af-prodchk" ${s.product !== false ? 'checked' : ''}><span>có SP</span></label>
        ${(d.camera_moves || []).length ? `<select class="input xs select af-cam" title="Chuyển động máy quay của clip (đã thử thật trên Muse: vòng quanh sản phẩm giữ nhãn rõ) — đổi rồi Tạo lại clip">${(d.camera_moves || []).map((m) => { const cur = s.camera || (s.kind === 'presenter' ? 'static' : ([1, 2].includes(s.id % 4) ? 'orbit' : 'push')); return `<option value="${esc(m.id)}" ${m.id === cur ? 'selected' : ''}>🎥 ${esc(m.label)}</option>`; }).join('')}</select>` : ''}
        ${(s.check || []).map((w) => `<span class="chip xs warn" title="Kiểm tra lại câu này trước khi đăng">${ic('alert')}${esc(w)}</span>`).join('')}
        ${s.stale ? '<span class="chip xs warn">lời đã sửa</span>' : ''}
        ${s.fixed ? '<span class="chip xs fix">AI đã sửa</span>' : ''}
        ${fmQaChip(s)}
        <div class="grow"></div>
        <button class="btn ghost xs" data-afregen ${busy || off ? 'disabled' : ''}>${ic('refresh')}Ảnh</button>
        <button class="btn ghost xs" data-affix ${busy || off || !s.scene ? 'disabled' : ''} title="Muse viết lại mô tả cho hợp chính sách rồi tạo lại ảnh">${ic('wand')}AI sửa</button>
        <button class="btn ghost xs" data-afclip ${!s.image_url || cbusy || off ? 'disabled' : ''}>${ic('video')}${s.clip_url ? 'Tạo lại clip' : 'Tạo clip'}</button>
      </div>
      ${st.host !== 'silent' ? `<div class="af-line"><span>${ic('mic')}</span><input class="input xs af-txt" data-spk="${esc(line?.speaker || (hasHost ? 'host' : 'narrator'))}" value="${esc(line?.text || '')}" placeholder="Câu nói của cảnh…" title="${esc(line?.emotion ? 'Cách nói: ' + line.emotion : '')}"></div>` : ''}
      <div class="af-line"><span title="Chữ lớn trên hình">${ic('captions')}</span><input class="input xs af-cap-in" value="${esc(s.caption || '')}" placeholder="Chữ trên hình (tối đa ~6 chữ)"></div>
      <textarea class="input xs sv-scene" rows="2" placeholder="Khung hình mở đầu (tiếng Anh)">${esc(s.scene || '')}</textarea>
      <textarea class="input xs sv-motion" rows="1" placeholder="Chuyển động trong clip (tiếng Anh)">${esc(s.motion || '')}</textarea>
      ${bad && s.error ? `<small class="sv-err">${esc(s.error)}</small>` : ''}
      ${cbad && s.clip_error ? `<small class="sv-err">Clip: ${esc(s.clip_error)}</small>` : ''}
    </div>
  </div>`;
}

async function afSave(patch) {
  try { AF.data = await api('POST', `/api/aff/${AF.cur}/settings`, patch); renderAffMain(); } catch (e) { toast(e.message, 'error', 5000); renderAffMain(); }
}

async function afProduct(patch, msg) {
  try { AF.data = await api('POST', `/api/aff/${AF.cur}/product`, patch); renderAffMain(); if (msg) toast(msg, 'success', 1800); } catch (e) { toast(e.message, 'error', 5000); }
}

async function afShot(sbox, patch, msg) {
  const sid = +sbox.dataset.sid;
  try {
    AF.data = await api('POST', `/api/aff/${AF.cur}/shot`, { id: sid, ...patch });
    const s = (AF.data.shot_list || []).find((x) => x.id === sid);
    if (s && sbox.isConnected) sbox.outerHTML = afShotHtml(s);
    renderAffHead(); renderAfPickBar();
    if (msg) toast(typeof msg === 'function' ? msg(s) : msg, 'success', 1800);
  } catch (err) { toast(err.message, 'error', 5000); }
}

function afPlay(url, title) {
  const d = AF.data; if (!url && !d?.video_url) return;
  const vertical = (d.settings?.ratio || '9:16') === '9:16';
  openModal({ title: title || d.name, icon: 'film', wide: !vertical, body: `<video src="${esc(url || d.video_url)}" controls autoplay style="width:100%;max-height:78vh;border-radius:10px;background:#000"></video>`,
    foot: url ? [{ label: 'Đóng', cls: 'ghost' }] : [{ label: 'Mở thư mục', cls: 'ghost', icon: 'folder-open', onClick: () => openPath(d.video_path, true) }, { label: 'Đóng', cls: 'ghost' }] });
}

async function afRun(action, only) {
  const labels = { all: 'làm video tự động', continue: 'chạy tiếp', product: 'đọc sản phẩm', script: 'viết kịch bản', music: 'tạo nhạc nền',
    refs: 'tạo ảnh người dẫn', images: 'tạo ảnh cảnh', clips: 'tạo clip', render: 'dựng video', fix: 'AI sửa + tạo lại ảnh' };
  try {
    await api('POST', `/api/aff/${AF.cur}/run`, only ? { action, only } : { action });
