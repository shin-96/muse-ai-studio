  refs: 'Ảnh nhân vật', images: 'Ảnh cảnh', clips: 'Clip động', ready: 'Sẵn sàng dựng', rendering: 'Đang dựng', done: 'Hoàn thành', error: 'Lỗi', stopped: 'Đã dừng' };
const SV_AUDIO = '.mp3,.wav,.m4a,.aac,.ogg,.flac,.opus,audio/*';
const svTime = (t) => { t = Math.max(0, +t || 0); const m = Math.floor(t / 60); const s = (t - m * 60).toFixed(1).padStart(4, '0'); return `${m}:${s}`; };
const svDur = (t) => { t = Math.round(+t || 0); return `${Math.floor(t / 60)}:${pad(t % 60)}`; };
