async function bootstrapSession() {
  const params = new URLSearchParams(location.hash.slice(1));
  const capability = params.get('session');
  if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  if (!capability) return;
  const response = await fetch('/api/session', { method: 'POST', credentials: 'same-origin',
    headers: { 'content-type': 'application/json', 'X-Muse-Session': capability }, body: '{}' });
  if (!response.ok) {
    showSessionLost('Phiên làm việc không hợp lệ.');
    throw new Error('Phiên làm việc không hợp lệ. Hãy mở lại Muse AI Studio từ ứng dụng.');
  }
}

function canGenerate(kind) {
  kind = kind === 'image-to-video' ? 'video' : kind;
  const license = S.license || {};
  return Boolean(license.valid && (license.license_type !== 'trial' || trialRemaining() > 0)
    && (!Array.isArray(license.features) || license.features.includes(kind)));
}

let trialClock = { at: 0, seconds: 0 };
let trialRedeemOperation = null;
function setLicense(license) {
  S.license = license || { valid: false };
  trialClock = { at: performance.now(), seconds: Math.max(0, Number(S.license.remaining_seconds) || 0) };
  renderLicense();
}
function trialRemaining() {
  return Math.max(0, Math.floor(trialClock.seconds - (performance.now() - trialClock.at) / 1000));
}
function trialCountdown() {
  const seconds = trialRemaining();
  if (!seconds) return 'Hết hạn';
  const d = Math.floor(seconds / 86400);
  if (d >= 1) return `${d} ngày ${Math.floor((seconds % 86400) / 3600)}h`;
  return [Math.floor(seconds / 3600), Math.floor(seconds / 60) % 60, seconds % 60].map((p) => String(p).padStart(2, '0')).join(':');
}

function licenseExpiry(license) {
  if (license.permanent) return 'Vĩnh viễn';
  if (!license.expires_at) return 'Chưa kích hoạt';
  const date = new Date(typeof license.expires_at === 'number' ? license.expires_at * 1000 : license.expires_at);
  return Number.isNaN(date.getTime()) ? String(license.expires_at) : date.toLocaleString('vi-VN');
}

// License Hub keys are intentionally short (MUSE-...), while older commercial
// builds used signed MSL1 tokens.  Keep the check in the UI only as a friendly
// hint; the local API remains the authority and validates both formats.
function licenseKeyHint(key) {
  const value = String(key || '').trim();
  if (!value) return '';
  if (/^HHN1\./.test(value)) return 'Key Bản Quyền Ký Số (HHN1)';
  if (/^(HHN|VIP|PRO|KEY|MUSE)-[A-Z0-9-]+$/i.test(value)) return 'Mã Voucher Web Kích Hoạt';
  if (/^MSL1\./.test(value)) return 'Key thương mại';
  return 'Mã Kích Hoạt';
}

function renderLicense() {
  const license = S.license || {};
  const isPro = (license.plan === 'pro');
  const trial = !isPro;
  const usable = Boolean(license.valid && (isPro || trialRemaining() > 0));
  const label = $('#licenseLabel');
  if (label) {
    if (!license.valid) {
      label.textContent = 'Chưa đăng nhập';
      label.title = 'Bấm để đăng nhập tài khoản';
    } else if (isPro) {
      label.textContent = `Gói PRO · ${license.customer || ''}`;
      label.title = 'Bản quyền PRO không giới hạn';
    } else {
      label.textContent = `Miễn phí · ${trialCountdown()}`;
      label.title = 'Đang dùng gói Miễn phí theo ngày trên Google Sheet';
    }
  }
  $('#btnLicense')?.classList.toggle('license-locked', !usable);
  $$('[data-trial-countdown]').forEach((element) => { element.textContent = trialCountdown(); });
  const run = $('#btnCreateRun');
  if (run) {
    run.disabled = !usable;
    run.title = usable ? '' : (license.message || 'Đăng nhập tài khoản để sử dụng miễn phí');
  }
  const selected = [...S.selected].map((id) => S.tasks.get(id)).filter(Boolean);
  const sel = $('#btnRunSel');
  if (sel) sel.disabled = !usable || !selected.length;
  const retry = $('#btnRetryErr');
  if (retry) retry.disabled = !usable;
  $$('[data-act="rerun"]').forEach((button) => { button.disabled = !usable; });
}


function openLicense() {
  const license = S.license || {};
