/* ==================================================================== INIT */
function applyTheme(t) {
  document.documentElement.dataset.theme = t;
  store.set('theme', t);
  const b = $('#btnTheme');
  if (b) { b.innerHTML = ic(t === 'light' ? 'moon' : 'sun'); b.title = t === 'light' ? 'Chuyển giao diện tối' : 'Chuyển giao diện sáng'; }
}

async function init() {
  hydrateIcons();
  applyTheme(store.get('theme', 'dark'));
  $('#btnTheme').onclick = () => applyTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
  bind();
  try { await bootstrapSession(); } catch (error) { toast(error.message, 'error', 15000); renderLicense(); return; }
  const d = store.get('draft', {});
  $('#promptInput').value = d.text || '';
  $('#sepInput').value = d.sep || '';
  S.refs = store.get('refs', []);
  $$('#countChips button').forEach((b) => b.classList.toggle('on', +b.dataset.count === S.count));
  $$('#pairSeg button').forEach((b) => b.classList.toggle('on', b.dataset.pair === S.pair));
  S.project = store.get('project', null);
  try { await refreshAll(); } catch (e) { toast('Không tải được dữ liệu: ' + e.message, 'error', 15000); renderLicense(); return; }
  setMode(S.mode);
  renderRefs();
  connectEvents();
  const p = store.get('page', 'studio');
  if (p !== 'studio') showPage(p);
  if (!S.license.valid) openLicense();
  setInterval(async () => { try { setLicense(await api('GET', '/api/license/status')); } catch { /* connection status handled by SSE */ } }, 30000);
  setInterval(() => { if (S.license.license_type === 'trial' || S.license.hub_trial) renderLicense(); }, 1000);
}
init();
