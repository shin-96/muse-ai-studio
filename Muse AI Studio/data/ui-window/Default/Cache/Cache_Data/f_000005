          <button class="btn sm" data-mg="open">${ic('external')}Mở file</button><button class="btn sm" data-mg="reveal">${ic('folder-open')}Thư mục</button>
          <button class="btn sm ghost" data-mg="library">${ic('images')}Thư viện</button></div>`;
      } else if (job.status === 'error' || job.status === 'cancelled') {
        res.className = 'merge-result err';
        res.innerHTML = `<div>${ic(job.status === 'error' ? 'alert' : 'info')}${esc(job.message || '')}</div>`;
        $('[data-mg="start"]', bg).hidden = false;
        $('[data-mg="start"]', bg).disabled = st.clips.length < 2;
      }
      hydrateIcons(res);
    };
