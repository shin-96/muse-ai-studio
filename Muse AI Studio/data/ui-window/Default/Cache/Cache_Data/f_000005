async function afBookmarklet() {
  if (AF.bm) return AF.bm;
  const src = await (await fetch('/static/shopee_grab.js', { cache: 'no-store' })).text();
  const code = src.replace(/\/\*[\s\S]*?\*\//g, '').split('\n').map((l) => l.trim()).filter(Boolean).join(' ');
  AF.bm = 'javascript:' + encodeURIComponent(code);
