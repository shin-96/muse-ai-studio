      mm === 'auto' ? 'Muse sáng tác nhạc nền không lời theo thể loại phim' : 'Đổi ở mục Nhạc nền', mm === 'auto'],
    ['refs', 'Ảnh nhân vật', 'users', refsDone, 'Ảnh tham chiếu cho nhân vật chính', has],
    ['images', `Ảnh cảnh${has ? ` ${d.images}/${d.shots}` : ''}`, 'images', has && d.images === d.shots, 'Tạo ảnh khung hình cho các cảnh chưa có / bị lỗi', has],
    ['clips', `Clip thoại${has ? ` ${d.clips}/${d.shots}` : ''}`, 'video', has && d.clips === d.shots, 'Ảnh cảnh → clip Muse có nhân vật nói lời thoại', d.images > 0],
    ...(st.dub ? [['dub', `Lồng tiếng${has ? ` ${(d.shot_list || []).filter((x) => x.dub_url).length}/${(d.shot_list || []).filter((x) => (x.lines || []).length === 1).length}` : ''}`, 'mic',
      has && (d.shot_list || []).filter((x) => (x.lines || []).length === 1).every((x) => x.dub_url), 'VoiceTube đọc lại mọi câu thoại bằng giọng cố định của từng nhân vật', has]] : []),
    ['render', 'Dựng phim', 'film', !!d.video_url, 'Nối clip + phụ đề khớp tiếng nói + nhạc nền', d.images > 0],
  ];
  const step = ([act, label, icon, done, title, enabled], n) => `<button class="btn sm sv-step ${done ? 'fm-done' : ''}" data-fmrun="${act}" ${live || !enabled ? 'disabled' : ''} title="${esc(title)}"><b>${done ? ic('check') : n}</b>${ic(icon)}${esc(label)}</button>`;
  box.innerHTML = `
    <div class="sv-head-top">
      <div class="sv-title"><b>${esc(d.name)}</b><small>${has ? `~${svDur(d.duration)} · ${(d.scenes || []).length ? `${d.scenes.length} cảnh · ` : ''}${d.shots} shot · ${d.lines} câu thoại · ${(d.characters || []).length} nhân vật` : `Ý tưởng · ~${st.minutes} phút (${fmActs(st.minutes)}, ~${fmScenes(st.minutes)} shot) · chưa có kịch bản`}</small></div>
      <span class="sv-st st-${esc(d.status)}">${esc(FM_STATUS[d.status] || d.status)}</span>
    </div>
    <div class="sv-msg">${esc(d.message || '')}</div>
    ${fmStoryHtml(d)}
    <div class="bar"><i style="width:${Math.max(live ? 3 : 0, pct)}%"></i></div>
    <div class="sv-acts">
      <button class="btn primary-alt sm" data-fmrun="${has ? 'continue' : 'all'}" ${live ? 'disabled' : ''} title="Tự chạy hết các bước còn thiếu">${ic('play')}${has ? 'Chạy tiếp tự động' : 'Làm phim tự động'}</button>
      <span class="sv-sep"></span>
      ${steps.map((x, i) => step(x, i + 1)).join('')}
      <div class="grow"></div>
      ${live ? `<button class="btn danger sm" id="fmStop">${ic('square')}Dừng</button>` : ''}
      ${has ? `<a class="btn ghost sm" href="/api/film/${d.id}/srt" download title="Tải phụ đề .srt">${ic('download')}SRT</a>` : ''}
      ${d.video_url ? `<button class="btn sm" id="fmPlay">${ic('play')}Xem phim</button><button class="btn ghost sm" id="fmReveal" title="Mở thư mục chứa phim">${ic('folder-open')}</button>` : ''}
      <button class="btn ghost sm" id="fmDel" title="Xoá dự án (giữ nguyên ảnh/clip/phim đã tạo)" ${live ? 'disabled' : ''}>${ic('trash')}</button>
    </div>`;
}

function fmVoiceChips(d) {
  const names = Object.fromEntries((d.characters || []).map((c) => [c.id, c.name]));
  const pairs = (d.voice_qa?.pairs || []).filter((p) => p.sim >= 0.7);
  return pairs.map((p) => `<span class="chip xs warn" title="Độ giống giọng trung bình ${p.sim.toFixed(2)} — khi dựng, tool dịch nhẹ cả giọng 1 người cho 2 giọng tách ra (Tách 2 giọng quá giống nhau). Phim mới: tool giao 2 chất giọng đối lập ngay từ kịch bản.">Giọng ${esc(names[p.a] || p.a)} và ${esc(names[p.b] || p.b)} còn giống nhau</span>`).join('');
}

function fmStoryHtml(d) {
  if (!(d.shot_list || []).length || !(d.logline || d.question || d.review?.fixed != null || (d.lint || []).length || (d.voice_qa?.pairs || []).length)) return '';
  const rv = d.review || {};
  const lint = d.lint || [];
  return `<div class="fm-story">
    ${d.logline ? `<p><b>Câu chuyện:</b> ${esc(d.logline)}</p>` : ''}
    ${d.question ? `<p><b>Người xem chờ:</b> ${esc(d.question)}</p>` : ''}
    <div class="fm-story-chips">
      ${rv.fixed != null ? `<span class="chip xs ${rv.fixed ? 'fix' : 'ok'}" title="${esc((rv.issues || []).join('\n') || 'Đạo diễn (Muse) đọc lại kịch bản, không thấy chỗ khó hiểu')}">${ic('check')}Đạo diễn soát: ${rv.fixed ? `sửa ${rv.fixed} shot` : 'ổn'}</span>` : ''}
      ${lint.map((x) => `<span class="chip xs warn">${esc(x)}</span>`).join('')}
      ${fmVoiceChips(d)}
    </div></div>`;
}

