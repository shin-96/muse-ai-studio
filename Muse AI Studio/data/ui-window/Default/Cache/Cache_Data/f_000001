/* 1.9.1: biểu cảm, đạo cụ, giọng & âm thanh */
.fm-face { font-style: italic; }
.fm-prop .sv-char-img { background: var(--accent-soft); }
.fm-audio { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
.chip.xs svg { width: 11px; height: 11px; vertical-align: -1px; margin-right: 2px; }
.chip.xs.ok { background: rgba(31, 199, 126, .14); color: var(--green-2, #6ee7b7); cursor: help; display: inline-flex; align-items: center; gap: 3px; }
.chip.xs.bad { background: rgba(240, 84, 92, .14); color: var(--red, #f0545c); cursor: help; display: inline-flex; align-items: center; gap: 3px; }
.chip.xs.ok svg, .chip.xs.bad svg { width: 11px; height: 11px; }

/* ============ 1.8.0 Video Aff ============ */
.af-create .af-src { display: flex; flex-direction: column; gap: 8px; }
.af-create .af-src[hidden] { display: none; }
.af-linkrow { display: flex; gap: 8px; align-items: center; }
.af-linkrow .input { flex: 1; min-width: 0; }
.af-styles { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; }
.af-styles button { text-align: left; border: 1px solid var(--line); border-radius: 10px; background: var(--panel-2); padding: 9px 11px;
  display: flex; flex-direction: column; gap: 3px; cursor: pointer; color: var(--text); }
.af-styles button:hover { border-color: var(--line-2); }
.af-styles button.on { border-color: var(--accent-line); box-shadow: 0 0 0 1px var(--accent-line) inset; }
.af-styles button b { font-size: 13px; }
.af-styles button small { color: var(--muted); font-size: 11.5px; line-height: 1.4; }
.af-photos { display: flex; flex-wrap: wrap; gap: 8px; }
.af-ph { position: relative; width: 92px; height: 92px; border-radius: 9px; overflow: hidden; border: 1px solid var(--line); background: var(--panel-2); }
.af-photos.sm .af-ph { width: 70px; height: 70px; }
.af-ph img { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; display: block; }
.af-ph > button { position: absolute; top: 3px; right: 3px; padding: 2px; min-height: 0; background: rgba(0, 0, 0, .55); color: #fff; border: 0; }
.af-ph > button.af-ph-up { right: auto; left: 3px; }
.af-ph > button svg { width: 12px; height: 12px; }
.af-ph-main { position: absolute; left: 0; right: 0; bottom: 0; font-size: 10px; text-align: center; background: rgba(238, 77, 45, .9); color: #fff; padding: 1px 0; }
.af-ph.add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; cursor: pointer; border-style: dashed; color: var(--muted); }
.af-ph.add svg { width: 18px; height: 18px; }
.af-ph.add small { font-size: 10.5px; }
.af-prod, .af-cap { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; }
.af-meta { color: var(--muted); font-size: 11.5px; overflow-wrap: anywhere; }
.af-meta a { color: var(--accent); }
.af-caption { margin: 0; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }
.af-tags { display: flex; flex-wrap: wrap; gap: 4px; }
.af-warn { color: #f59e0b; }
.af-login-msg { color: #f59e0b; font-weight: 600; }
.af-line { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 6px; align-items: center; }
.af-line > span { display: inline-flex; color: var(--muted); }
.af-line > span svg { width: 14px; height: 14px; }
.af-shot .af-kind { width: auto; max-width: 150px; }
.af-shot .af-has { font-size: 11.5px; gap: 4px; }
.af-shot { grid-template-columns: 128px minmax(0, 1fr); }
@media (max-width: 760px) { .af-shot { grid-template-columns: 1fr; } }
.af-shot .chip.xs.warn { display: inline-flex; align-items: center; gap: 3px; }
.af-shot .chip.xs svg { width: 11px; height: 11px; }
.af-paste { display: flex; flex-direction: column; gap: 6px; }
.af-paste.on textarea { border-color: #ee4d2d; border-style: dashed; }
.af-upd summary { cursor: pointer; font-size: 12px; color: var(--muted); }
.af-upd[open] summary { margin-bottom: 6px; }
.af-grab p { margin: 0 0 10px; font-size: 13px; line-height: 1.55; color: var(--text-2); }
.af-bm-row { margin: 8px 0; }
.af-bm { display: inline-flex; align-items: center; gap: 6px; background: #ee4d2d; color: #fff !important; text-decoration: none;
  font-weight: 700; font-size: 13px; padding: 7px 14px; border-radius: 8px; cursor: grab; }
.af-bm svg { width: 15px; height: 15px; }
/* ---------- 1.9.3 hàng chờ làm hàng loạt */
.sv-item.q-card { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 4px 8px; border-style: dashed; }
.sv-item.q-card svg.ic { width: 15px; height: 15px; color: var(--accent); }
.sv-item.q-card small { flex-basis: 100%; }
.sv-item.q-card.live { border-style: solid; border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
.q-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-bottom: 10px; }
.q-bar .grow { flex: 1; }
.q-paste textarea { min-height: 52px; }
.q-hint { margin: 4px 0 10px; font-size: 12px; }
.q-list { display: flex; flex-direction: column; gap: 6px; max-height: 56vh; overflow: auto; }
.q-row { display: grid; grid-template-columns: 132px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 10px;
  border: 1px solid var(--line); border-radius: 10px; background: var(--panel-2); }
.q-row .chip { justify-self: start; white-space: nowrap; }
.q-row .chip.run { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
.q-name { display: flex; flex-direction: column; min-width: 0; }
.q-name b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.q-name small { color: var(--muted); font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.q-acts { display: flex; gap: 2px; }
.q-row.ph-done { opacity: .75; }
@media (max-width: 640px) { .q-row { grid-template-columns: 1fr auto; } .q-row .chip { grid-column: 1 / -1; } }

/* 1.9.4 — máy quay từng shot, lồng tiếng VoiceTube */
.fm-cam, .af-cam { width: auto; min-width: 0; max-width: 150px; padding-top: 2px; padding-bottom: 2px; font-size: 11.5px; color: #9fd8ff; }
.sv-shot-list.grid .fm-cam, .sv-shot-list.grid .af-cam { max-width: 128px; }
.fm-dub .fm-dub-key { display: block; margin: 2px 0 6px; color: var(--muted); }
.fm-dub .fm-dub-key a { color: var(--accent); }
.fm-cast { display: flex; flex-direction: column; gap: 6px; margin: 6px 0 8px; }
.fm-cast-row { display: grid; grid-template-columns: minmax(0, 1fr) 62px auto; gap: 4px 6px; align-items: center;
  padding: 6px 0; border-top: 1px solid var(--line); }
.fm-cast-row:first-child { border-top: 0; }
.fm-cast-row b { grid-column: 1 / -1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fm-cast-row select { min-width: 0; }
.chip.ok { color: #8de0b5; border-color: rgba(141, 224, 181, .45); cursor: pointer; }
.warn-text { color: var(--orange); }

/* 1.9.5 — cửa sổ mất phiên với tool */
.session-lost { position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 95; display: flex; gap: 12px;
  align-items: flex-start; max-width: min(720px, calc(100vw - 32px)); padding: 14px 18px; border-radius: 12px;
  background: #3a1220; border: 1px solid #ff5c7a; color: #ffe3e8; box-shadow: 0 12px 40px rgba(0, 0, 0, .45); }
.session-lost .ic { flex: none; width: 22px; height: 22px; color: #ff8aa0; margin-top: 2px; }
.session-lost p { margin: 4px 0 0; line-height: 1.45; }

/* 1.9.5 — chọn giọng nhân vật + ô API key VoiceTube ngay trong form */
.fm-dub-field { display: flex; flex-direction: column; gap: 6px; }
.vt-inline { display: flex; gap: 6px; align-items: center; margin-top: 6px; }
.vt-inline .input { flex: 1; min-width: 0; }
.vt-ok { display: inline-flex; align-items: center; gap: 4px; color: var(--ok, #39d98a); }
.vt-ok .ic { width: 14px; height: 14px; }
