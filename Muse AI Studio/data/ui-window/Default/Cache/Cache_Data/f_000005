/* Match a prompt's reference names against uploaded files.  We keep the
 * original prompt unchanged (Muse still receives the user's wording), and
 * only use this index to choose the attachments for that prompt.  Matching
 * uses NFKC, case folding and whitespace folding; "_" and "-" count as spaces
 * (file Honey_Badger.png = "honey badger" in the prompt, 1.6.1).  Accents and
 * other punctuation stay significant so similarly named files cannot be mixed up. */
function refTokens(value) {
  return String(value || '').normalize('NFKC').toLowerCase().replace(/\\/g, '/').replace(/[_\-\s]+/g, ' ').trim();
}

function refStem(name) {
  const base = String(name || '').split(/[\\/]/).pop() || '';
  return base.replace(/\.[^.]*$/, '');
}

function namedRefsForPrompt(prompt, refs) {
  const text = refTokens(prompt);
  const aliases = new Map();
  for (const ref of refs) {
    const base = String(ref.name || ref.file || '').split(/[\\/]/).pop() || '';
    const relative = String(ref.relativePath || '').replace(/\\/g, '/');
    const variants = [base, refStem(base), relative, relative.split('/').slice(1).join('/')];
    for (const value of variants) {
      const alias = refTokens(value);
      if (!alias) continue;
      const candidates = aliases.get(alias) || [];
      if (!candidates.some((item) => item.file === ref.file)) candidates.push(ref);
      aliases.set(alias, candidates);
    }
  }
  const missing = new Set(), ambiguous = new Set(), selected = new Map(), occupied = [];
  const overlap = (start, end) => occupied.some(([left, right]) => start < right && end > left);
  const choose = (alias, start, end) => {
    alias = refTokens(alias);
    const candidates = aliases.get(alias) || [];
    if (!candidates.length) missing.add(alias);
    else if (candidates.length > 1) ambiguous.add(alias);
    else if (!selected.has(candidates[0].file)) selected.set(candidates[0].file, { ref: candidates[0], at: start });
    occupied.push([start, end]);
  };
  // Markers make a missing/short filename explicit. The original prompt is
  // preserved; matching never rewrites the user's directions.
  const marker = /@"([^"\r\n]+)"|@([^\s,;:!?()[\]{}]+)|\[([^\]\r\n]+)\]/g;
  for (const match of text.matchAll(marker)) {
    const alias = (match[1] || match[2] || match[3] || '').trim().replace(/[.,]+$/, '');
    choose(alias, match.index, match.index + match[0].length);
  }
  const word = (character) => /[\p{L}\p{N}\p{M}_\-/]/u.test(character);
  // Longer aliases claim their text first: hero face does not also select
  // hero, and folder/a.png disambiguates duplicate a.png basenames.
  for (const alias of [...aliases.keys()].sort((a, b) => b.length - a.length)) {
    if (alias.length < 2 || /^\d+$/.test(alias)) continue;
    let start = 0;
    while ((start = text.indexOf(alias, start)) >= 0) {
      const end = start + alias.length;
      const before = text[start - 1] || '', after = text[end] || '';
      const isStemInsideFilename = after === '.' && /^[.][\p{L}\p{N}]/u.test(text.slice(end));
      if (!overlap(start, end) && !word(before) && !word(after) && !isStemInsideFilename) choose(alias, start, end);
      start = end;
    }
  }
  // Also report a filename with an extension that was typed without a marker
  // but did not resolve; do not silently create a video without that image.
  const filename = /[\p{L}\p{N}_./-]+\.(?:png|jpe?g|webp|gif|bmp)(?![\p{L}\p{N}_-])/gu;
  for (const match of text.matchAll(filename)) {
    if (!overlap(match.index, match.index + match[0].length)) missing.add(match[0]);
  }
  return { refs: [...selected.values()].sort((a, b) => a.at - b.at).map((item) => item.ref),
    missing: [...missing], ambiguous: [...ambiguous] };
}

function readyRefs() {
  return S.refs.filter((ref) => ref.file).map(({ file, name, relativePath }) => ({ file, name, relativePath }));
}

function namedItems(prompts, refs) {
  return prompts.map((prompt) => namedRefsForPrompt(prompt, refs));
}

function buildItems() {
  const prompts = parsePrompts();
  const refs = readyRefs();
  if (S.pair === 'named') {
    return namedItems(prompts, refs).map(({ refs: matched }, i) => ({ prompt: prompts[i], refs: matched }));
  }
  if (!refs.length) return prompts.map((p) => ({ prompt: p, refs: [] }));
  if (S.pair === 'shared') {
    if (!prompts.length) return [{ prompt: '', refs }];
    return prompts.map((p) => ({ prompt: p, refs }));
  }
  if (prompts.length <= 1) return refs.map((r) => ({ prompt: prompts[0] || '', refs: [r] }));
  return prompts.map((p, i) => ({ prompt: p, refs: refs[i] ? [refs[i]] : [] }));
}

function updateComposer() {
  if (S.mode === 'image-to-video') {
    const count = S.i2v.pairs.length || Math.min(S.i2v.files.length, String(S.i2v.promptText || '').split(/\r?\n/).map((x) => x.trim()).filter(Boolean).length);
