  openModal({ title: fromSelection ? 'Ghép clip đã chọn' : 'Ghép video hoàn chỉnh', icon: 'film', wide: true, body, onOpen: (bg, close) => {
    bg.classList.add('merge-dlg');
    const st = { clips, plan: data && data.plan && { ...data.plan, clipsCount: clips.length } };
    const renderList = () => {
      const total = st.clips.reduce((n, c) => n + (+c.duration || 0), 0);
      const plan = localMergePlan(st.clips, st.plan);
      $('#mgSummary', bg).innerHTML = st.clips.length
        ? `<div class="merge-stats"><span><b>${st.clips.length}</b> clip</span><span>Tổng <b>${fmtDur(total)}</b></span>${plan ? `<span><b>${plan.width}×${plan.height}</b></span>` : ''}</div>
           <p class="merge-mode">${mergeModeText(plan)}</p>
           ${data && data.error ? `<p class="merge-err">${esc(data.error)}</p>` : ''}
           <p class="muted merge-hint">Thứ tự ghép từ trên xuống (mặc định theo STT = thứ tự prompt). Dùng ▲ ▼ để đổi thứ tự, ✕ để bỏ bớt clip.</p>`
        : '<p class="muted">Chưa có clip video nào tạo xong để ghép.</p>';
      $('#mgList', bg).innerHTML = st.clips.map((c, i) => `
        <div class="merge-row" data-i="${i}">
          <span class="merge-no">${i + 1}</span>
          <video src="${fileUrl(c.path)}#t=0.3" preload="metadata" muted></video>
          <div class="merge-info"><b>${esc(c.name)}</b><small>STT ${pad(c.stt)} · ${c.duration ? fmtDur(c.duration) : '?'}${c.w ? ` · ${c.w}×${c.h}` : ''}${c.audio === false ? ' · không tiếng' : ''}</small>
            <small class="merge-prompt" title="${esc(c.prompt)}">${esc(c.prompt)}</small></div>
          <div class="merge-row-acts">
            <button class="icon-btn sm" data-mv="up" title="Lên trên" ${i === 0 ? 'disabled' : ''}>${ic('chevron-up')}</button>
            <button class="icon-btn sm" data-mv="down" title="Xuống dưới" ${i === st.clips.length - 1 ? 'disabled' : ''}>${ic('chevron-down')}</button>
            <button class="icon-btn sm danger" data-mv="remove" title="Bỏ clip này khỏi video ghép">${ic('x')}</button>
          </div>
        </div>`).join('');
      const skip = (data && data.skipped) || [];
      $('#mgSkip', bg).innerHTML = skip.length ? `<details><summary>Bỏ qua ${skip.length} tác vụ</summary>${skip.map((s) => `<div>${esc(s.name)} — ${esc(s.reason)}</div>`).join('')}</details>` : '';
      $('[data-mg="start"]', bg).disabled = st.clips.length < 2 || mergeRunning();
    };
    const setRunning = (job) => {
      const running = job && job.status === 'running';
      $('#mgProgress', bg).hidden = !job;
      $('[data-mg="cancel"]', bg).hidden = !running;
      $('[data-mg="start"]', bg).hidden = running || (job && job.status === 'done');
      $('#mgName', bg).disabled = !!running;
      $$('[data-mv]', bg).forEach((b) => { if (running) b.disabled = true; });
      if (!job) return;
      $('#mgPct', bg).textContent = `${job.status === 'done' ? 100 : job.progress || 0}%`;
      $('#mgMsg', bg).textContent = job.message || '';
      $('#mgBar', bg).style.width = `${job.status === 'done' ? 100 : Math.max(2, job.progress || 0)}%`;
      const res = $('#mgResult', bg);
      res.hidden = !['done', 'error', 'cancelled'].includes(job.status);
      if (job.status === 'done') {
        const r = job.result || {};
        res.className = 'merge-result ok';
        res.innerHTML = `<div>${ic('check')}<b>Đã ghép xong:</b> ${esc((job.output || '').split(/[\\/]/).pop())}</div>
