    if (data) renderList(); else {
      $('#mgSummary', bg).innerHTML = `<div class="merge-stats"><span><b>${S.merge.clips}</b> clip</span></div>`;
      $('.merge-name', bg).hidden = true;
    }
    setRunning(S.merge && (S.merge.status === 'running' || !data) ? S.merge : null);
    $('#mgList', bg).addEventListener('click', (e) => {
      const b = e.target.closest('[data-mv]'); if (!b || mergeRunning()) return;
      const i = +b.closest('.merge-row').dataset.i;
      if (b.dataset.mv === 'up' && i > 0) [st.clips[i - 1], st.clips[i]] = [st.clips[i], st.clips[i - 1]];
      if (b.dataset.mv === 'down' && i < st.clips.length - 1) [st.clips[i + 1], st.clips[i]] = [st.clips[i], st.clips[i + 1]];
      if (b.dataset.mv === 'remove') st.clips.splice(i, 1);
      renderList(); hydrateIcons($('#mgList', bg));
    });
    $('.merge-actions', bg).parentElement.addEventListener('click', async (e) => {
      const b = e.target.closest('[data-mg]'); if (!b) return;
      const a = b.dataset.mg;
      const out = S.merge && S.merge.output;
      if (a === 'close') close();
      if (a === 'cancel') api('POST', '/api/merge/cancel').catch((err) => toast(err.message, 'error'));
      if (a === 'open' && out) openPath(out);
      if (a === 'reveal' && out) openPath(out, true);
      if (a === 'play' && out) openLightbox([{ path: out, kind: 'video', name: out.split(/[\\/]/).pop(), w: S.merge.result?.w, h: S.merge.result?.h, size: S.merge.result?.size, project: proj }], 0);
      if (a === 'library') { close(); showPage('library'); loadLibrary(); }
      if (a === 'start') {
        b.disabled = true;
        try {
          const r = await api('POST', '/api/merge', { project_id: S.project, task_ids: st.clips.map((c) => c.task_id), name: $('#mgName', bg).value.trim() || null });
          onMergeJob(r.job, true);
        } catch (err) { toast(err.message, 'error'); b.disabled = false; }
      }
    });
    hydrateIcons(bg);
  } });
}

function onMergeJob(job, quiet = false) {
  const prev = S.merge;
  S.merge = job;
  renderMergeButton();
  $$('.modal-bg.merge-dlg').forEach((m) => m._mergeUpdate && m._mergeUpdate(job));
  if (!job || quiet) return;
  const finished = prev && prev.status === 'running' && job.status !== 'running';
  if (finished && job.status === 'done') {
    toast(`Đã ghép xong ${job.clips} clip → ${(job.output || '').split(/[\\/]/).pop()}`, 'success', 6000);
    if (S.page === 'library') loadLibrary();
  }
}


