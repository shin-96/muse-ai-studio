/* ==================================================================== EVENTS (SSE) */
function connectEvents() {
  const es = new EventSource('/api/events');
  es.onmessage = (m) => {
    let e; try { e = JSON.parse(m.data); } catch { return; }
    switch (e.type) {
      case 'trial_expired':
        es.close();
        setLicense({ ...S.license, valid: false, remaining_seconds: 0, message: e.message });
        toast(e.message || 'Đã hết 2 giờ dùng thử.', 'error', 10000);
        window.close();
        break;
      case 'license': setLicense(e.license); break;
      case 'task': upsertTask(e.task); if (SV.data && e.task && e.task.project_id === SV.data.project_id) svReloadSoon(1500); break;
      case 'tasks_reload': if (!e.project_id || +e.project_id === S.project) loadTasks(); if (S.page === 'library') loadLibraryDebounced(); break;
      case 'projects': S.projects = e.projects; renderProjects(); break;
      case 'account': {
        const i = S.accounts.findIndex((x) => x.id === e.account.id);
        const acc = { ...(S.accounts[i] || {}), ...e.account }; delete acc.password;
        if (i >= 0) S.accounts[i] = acc; else S.accounts.push(acc);
        scheduleAccounts(); break;
      }
      case 'accounts': S.accounts = e.accounts; scheduleAccounts(); renderProxies(); if (S.page === 'srt') svReloadSoon(800); if (S.page === 'film') fmReloadSoon(800); if (S.page === 'aff') afReloadSoon(800); break;
      case 'proxy': { const i = S.proxies.findIndex((x) => x.id === e.proxy.id); if (i >= 0) S.proxies[i] = { ...S.proxies[i], ...e.proxy, label: S.proxies[i].label }; renderProxies(); scheduleAccounts(); break; }
      case 'proxies': S.proxies = e.proxies; renderProxies(); scheduleAccounts(); break;
      case 'settings': S.settings = e.settings; applyRunSettings(); break;
      case 'engine': S.engine = e.engine; renderEngine(); scheduleAccounts(); break;
      case 'log': pushLog(e.entry); break;
      case 'codex_job': renderCodexJob(e.job || e.data || e, e.transient_output || '', true); break;
      case 'merge_job': onMergeJob(e.job); break;
      case 'srt_project': onSrtProject(e.project); break;
      case 'film_project': onFilmProject(e.project); if (Q.film?.items?.length) queueSoon('film', 1500); break;
      case 'aff_project': onAffProject(e.project); if (Q.aff?.items?.length) queueSoon('aff', 1500); break;
      case 'queue': if (e.kind === 'film' || e.kind === 'aff') queueSoon(e.kind, 300); break;
      default: break;
    }
  };
  es.onerror = () => { $('#sbMsg').textContent = 'Mất kết nối với ứng dụng, đang thử lại…'; $('#sbDot').className = 'dot error'; };
  es.onopen = () => { if ($('#sbDot').classList.contains('error')) { $('#sbMsg').textContent = 'Đã kết nối'; $('#sbDot').className = 'dot'; refreshAll(); } };
}

async function refreshAll() {
  api('GET', '/api/merge/status').then((r) => { if (r && r.job) onMergeJob(r.job, true); }).catch(() => {});
  const st = await api('GET', '/api/state');
  showAppVersion(st.app && st.app.version);
  S.settings = st.settings; S.defaults = st.default_templates; S.ratios = st.ratios; S.refsDir = st.refs_dir;
  S.projects = st.projects; S.accounts = st.accounts; S.proxies = st.proxies; S.engine = st.engine;
  setLicense(st.license);
  S.logs = st.logs || [];
  if (S.logs.length) { const last = S.logs[S.logs.length - 1]; $('#sbMsg').textContent = last.msg; }
  renderProjects(); renderAccounts(); renderProxies(); renderEngine(); applyRunSettings(); renderRatios();
  await loadTasks();
}

