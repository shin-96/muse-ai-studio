let afTimer = null;

function afEditing() {
  const a = document.activeElement;
  return !!(a && a.closest && a.closest('#afMain') && a.matches('input[type=text], input:not([type]), textarea, select'));
}

function afReloadSoon(ms = 600) {
  if (S.page !== 'aff' || !AF.cur || AF.creating) return;
  clearTimeout(afTimer);
  afTimer = setTimeout(() => { if (afEditing()) afReloadSoon(2000); else loadAffDetail(); }, ms);
}

async function loadAff() {
  try {
    const r = await api('GET', '/api/aff');
    const { projects, ...opts } = r;
    AF.list = projects || []; AF.opts = opts;
    if (AF.cur && !AF.list.some((p) => p.id === AF.cur)) AF.cur = AF.list[0]?.id || null;
    if (!AF.cur && AF.list.length && !AF.creating) AF.cur = AF.list[0].id;
  } catch (e) { toast(e.message, 'error'); }
  if (!AF.list.length) AF.creating = true;
  renderAffList();
  if (!Q.aff) loadQueue('aff');
  if (AF.cur && !AF.creating) await loadAffDetail(); else renderAffMain();
}

async function loadAffDetail() {
  if (!AF.cur) return;
  try { AF.data = await api('GET', `/api/aff/${AF.cur}`); } catch (e) { AF.data = null; toast(e.message, 'error'); }
  renderAffMain();
}

function onAffProject(p) {
  if (!p) return;
  const i = AF.list.findIndex((x) => x.id === p.id);
  if (i >= 0) AF.list[i] = p; else AF.list.unshift(p);
  if (S.page !== 'aff') return;
  renderAffList();
  if (p.id === AF.cur && !AF.creating) {
    if (AF.data) { const { characters, ...rest } = p; Object.assign(AF.data, rest); renderAffHead(); }
    afReloadSoon(['product', 'scripting', 'music', 'images', 'refs', 'clips'].includes(p.status) ? 1500 : 300);
  }
}

function renderAffList() {
  const box = $('#afList'); if (!box) return;
  const items = AF.list.map((p) => {
    const pct = p.status === 'done' ? 100 : Math.round(p.progress || 0);
    return `<button class="sv-item ${p.id === AF.cur && !AF.creating ? 'on' : ''}" data-af="${p.id}">
      <b>${esc(p.product_title || p.name)}</b>
      <small>${p.shots ? `${p.shots} cảnh · ${p.images}/${p.shots} ảnh · ${p.clips}/${p.shots} clip` : `~${p.seconds || 30} giây · ${p.has_product ? 'chưa có kịch bản' : 'chưa đọc sản phẩm'}`}</small>
      <span class="sv-st st-${esc(p.status)}">${esc(AF_STATUS[p.status] || p.status)}${p.busy ? ' …' : ''}</span>
      ${p.busy ? `<div class="bar"><i style="width:${Math.max(3, pct)}%"></i></div>` : ''}
