  const src = st.music_src === 'muse' ? '<span class="chip xs fix">Muse tạo</span>' : st.music_src === 'upload' ? '<span class="chip xs">File của bạn</span>' : '';
  return `<h3 class="card-title">${ic('music')}Nhạc nền</h3>
    <div class="seg seg-sm sv-mode" id="fmMusicMode">${FM_MUSIC.map(([v, l, icon, title]) => `<button type="button" data-v="${v}" class="${v === mm ? 'on' : ''}" title="${esc(title)}">${ic(icon)}${l}</button>`).join('')}</div>
    ${mm === 'none' ? '<small class="hint">Phim chỉ có tiếng thoại của nhân vật.</small>' : `
    <div class="sv-audio">
      ${d.music_url ? `<div class="sv-audio-row"><audio src="${esc(d.music_url)}" controls preload="none"></audio></div>
        <div class="sv-audio-row">${src}<small class="sv-audio-name" title="${esc(st.music_name || '')}">${esc(st.music_name || '')}</small>
          <a class="btn ghost xs" href="${esc(d.music_url)}" download="${esc(st.music_name || 'nhac_nen.mp3')}" title="Tải file nhạc về máy">${ic('download')}Tải về</a>
          <button class="btn ghost xs" id="fmMusicDel" title="Bỏ nhạc này" ${live ? 'disabled' : ''}>${ic('trash')}</button></div>`
        : `<small class="hint">${mm === 'auto' ? `Muse sẽ sáng tác nhạc ở bước 2${d.music_text ? `: <i>${esc(d.music_text)}</i>` : ' theo thể loại phim'}.` : 'Chưa có file — tải nhạc của bạn lên.'}</small>`}
      <div class="sv-audio-row">
        ${mm === 'auto' ? `<button class="btn ghost xs" data-fmrun="music" ${live ? 'disabled' : ''} title="Muse sáng tác bản nhạc mới (thay bản cũ)">${ic('sparkles')}${d.music ? 'Muse tạo bản khác' : 'Muse tạo nhạc ngay'}</button>` : ''}
        <label class="btn ghost xs">${ic('upload')}Tải nhạc của bạn<input type="file" id="fmMusicFile" accept="${SV_AUDIO}" hidden></label>
      </div>
      <div class="sv-audio-row">
        <span class="sv-audio-lbl">${ic('music')}Âm lượng</span>
        <span class="sv-vol"><input type="range" id="fmMusicVol" min="0" max="1" step="0.05" value="${st.music_volume}"><small class="mono">${Math.round(st.music_volume * 100)}%</small></span>
      </div>
      <label class="chk"><input type="checkbox" id="fmDuck" ${st.duck !== false ? 'checked' : ''}><span>Tự nhỏ nhạc khi nhân vật nói</span></label>
    </div>`}`;
}

/* ---------------- nhân vật + giọng */
function fmCharsHtml(d) {
  const main = new Set(d.main || []);
  const chars = (d.characters || []).map((c) => `
    <div class="sv-char ${main.has(c.id) ? 'main' : ''}" data-cid="${esc(c.id)}">
      <div class="sv-char-img">${c.ref_url ? `<img src="${esc(c.ref_url)}" alt="" data-zoom="${esc(c.ref_url)}">`
        : `<span>${c.ref_status === 'running' || c.ref_status === 'queued' ? 'Đang tạo…' : (main.has(c.id) ? 'Chưa có ảnh' : 'Phụ')}</span>`}</div>
      <div class="sv-char-body">
        <input class="input xs" data-cf="name" value="${esc(c.name)}">
        <small>${esc(c.role || '')}</small>
        <textarea class="input xs" data-cf="look" rows="2" title="Ngoại hình cố định (tiếng Anh) — chép vào mọi ảnh">${esc(c.look || '')}</textarea>
        <span class="fm-voice-lbl">${ic('mic')}Giọng nói (cố định)</span>
        <textarea class="input xs fm-voice" data-cf="voice" rows="2" title="Mô tả giọng (tiếng Anh) — gửi y nguyên trong mọi clip để giọng không đổi">${esc(c.voice || '')}</textarea>
        <div class="sv-char-acts">
          <label class="btn ghost xs" title="Dùng ảnh của bạn làm ảnh tham chiếu nhân vật">${ic('upload')}Ảnh của bạn<input type="file" data-cup accept="image/png,image/jpeg,image/webp" hidden></label>
          ${c.ref_url ? `<button class="btn ghost xs" data-cdel title="Bỏ ảnh tham chiếu">${ic('trash')}</button>` : ''}
        </div>
      </div>
    </div>`).join('');
  const narr = d.settings?.narrator && (d.characters || []).length ? `
    <div class="sv-char" data-cid="narrator">
