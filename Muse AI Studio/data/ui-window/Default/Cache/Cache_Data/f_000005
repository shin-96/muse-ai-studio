async function afPaste(text) {
  if (!text.includes('musestudio-shopee')) { toast('Chưa phải dữ liệu từ nút Lấy SP — mở trang sản phẩm Shopee trong Chrome, bấm nút rồi dán lại', 'error', 6000); return; }
  try {
    AF.data = await api('POST', `/api/aff/${AF.cur}/paste`, { text });
    renderAffMain();
    toast(AF.data.busy ? 'Đã nhận dữ liệu sản phẩm — tool đang làm tiếp' : 'Đã nhận dữ liệu sản phẩm', 'success', 3000);
  } catch (e) { toast(e.message, 'error', 6000); }
}

async function afAddPhotos(files, toProject) {
  const list = [...files].slice(0, 8);
  const ids = [];
  for (const f of list) {
    try { const r = await api('POST', '/api/refs?name=' + encodeURIComponent(f.name), undefined, f); ids.push(r); } catch (e) { toast(`${f.name}: ${e.message}`, 'error'); }
  }
  if (toProject) { if (ids.length) await afProduct({ add_photos: ids.map((x) => x.file) }, `Đã thêm ${ids.length} ảnh sản phẩm`); return; }
  AF.photos = [...AF.photos, ...ids.map((r) => ({ file: r.file, url: r.url }))].slice(0, 8);
  afRenderPhotos();
}

/* ---------------- 1.9.3 hàng chờ làm hàng loạt (Làm phim + Video Aff) */
const Q = { film: null, aff: null, modal: null, timer: {} };
const Q_PHASE = { waiting: ['Chờ', ''], running: ['Đang chạy', 'run'], need_input: ['Cần dán dữ liệu SP', 'warn'],
  done: ['Xong', 'ok'], error: ['Lỗi', 'bad'], stopped: ['Đã dừng giữa chừng', 'warn'] };
const qNoun = (k) => (k === 'film' ? 'phim' : 'video');

async function loadQueue(kind) {
  try { Q[kind] = await api('GET', `/api/queue/${kind}`); } catch (e) { return; }
  if (kind === 'film') renderFilmList(); else renderAffList();
  if (Q.modal && Q.modal.kind === kind && Q.modal.el.isConnected) renderQueueModal();
}
function queueSoon(kind, ms = 700) { clearTimeout(Q.timer[kind]); Q.timer[kind] = setTimeout(() => loadQueue(kind), ms); }

function queueCardHtml(kind) {
  const v = Q[kind]; const c = v?.counts || {};
  const bits = [c.running ? `${c.running} đang chạy` : '', c.waiting ? `${c.waiting} chờ` : '', c.need_input ? `${c.need_input} cần dán SP` : '',
    c.done ? `${c.done} xong` : '', (c.error || 0) + (c.stopped || 0) ? `${(c.error || 0) + (c.stopped || 0)} lỗi/dừng` : ''].filter(Boolean);
  return `<button class="sv-item q-card ${c.running ? 'live' : ''}" data-queue="${kind}" title="Thêm nhiều ${qNoun(kind)} một lần — tool tự làm lần lượt">
    ${ic('list-ordered')}<b>Hàng chờ${v?.paused ? ' · tạm dừng' : ''}</b>
    <small>${bits.length ? bits.join(' · ') : `Làm hàng loạt: tool tự chạy từng ${qNoun(kind)}`}</small></button>`;
}

async function queueAct(kind, action, extra = {}) {
  try { Q[kind] = await api('POST', `/api/queue/${kind}`, { action, ...extra }); } catch (e) { toast(e.message, 'error', 5000); return; }
  if (kind === 'film') renderFilmList(); else renderAffList();
  if (Q.modal && Q.modal.el.isConnected) renderQueueModal();
}

function renderQueueModal() {
  const m = Q.modal; if (!m || !m.el.isConnected) return;
  const kind = m.kind; const v = Q[kind] || { items: [], counts: {}, parallel: 1, paused: false };
  const body = $('.modal-body', m.el);
  const rows = v.items.map((e) => {
    const [label, cls] = Q_PHASE[e.phase] || [e.phase, ''];
    const chip = e.phase === 'waiting' ? `Chờ #${e.order}` : e.phase === 'running' ? `${label} ${Math.round(e.progress || 0)}%` : label;
    return `<div class="q-row ph-${esc(e.phase)}" data-qid="${e.id}" data-sid="${e.sid}">
      <span class="chip xs ${cls}">${esc(chip)}</span>
      <div class="q-name"><b>${esc(e.name)}</b><small>${esc(e.message || '')}</small></div>
      <div class="q-acts">
        ${e.phase === 'waiting' ? `<button class="icon-btn" data-qa="up" title="Lên trên">${ic('chevron-up')}</button><button class="icon-btn" data-qa="down" title="Xuống dưới">${ic('chevron-down')}</button>` : ''}
        <button class="icon-btn" data-qa="open" title="Mở ${qNoun(kind)} này">${ic('external')}</button>
        <button class="icon-btn" data-qa="remove" title="Bỏ khỏi hàng chờ (không xoá ${qNoun(kind)}, không dừng nếu đang chạy)">${ic('x')}</button>
      </div></div>`;
  }).join('');
  body.innerHTML = `<div class="q-bar">
      <label class="field inline"><span>Chạy cùng lúc</span><select class="input xs select" id="qPar">${[1, 2, 3, 4].map((n) => `<option value="${n}" ${v.parallel === n ? 'selected' : ''}>${n} ${qNoun(kind)}</option>`).join('')}</select></label>
      <button class="btn ${v.paused ? 'primary-alt' : 'ghost'} sm" data-qa="${v.paused ? 'resume' : 'pause'}">${ic(v.paused ? 'play' : 'square')}${v.paused ? 'Chạy tiếp hàng chờ' : 'Tạm dừng hàng chờ'}</button>
      <button class="btn ghost sm" data-qa="clear" ${(v.counts.done || 0) + (v.counts.error || 0) + (v.counts.stopped || 0) ? '' : 'disabled'}>${ic('trash')}Bỏ mục đã xong / lỗi</button>
      <div class="grow"></div>
      <button class="btn primary-alt sm" data-qa="bulk">${ic('list-plus')}Thêm nhiều ${qNoun(kind)}…</button>
    </div>
    ${kind === 'aff' ? `<label class="field q-paste" title="Mỗi lần bấm nút dấu trang “Lấy SP → Muse AI Studio” trên 1 trang sản phẩm rồi dán vào đây (Ctrl+V): video đang chờ đúng sản phẩm đó tự làm tiếp; sản phẩm mới thì tạo video mới vào hàng chờ"><span>Dán dữ liệu sản phẩm (nút Lấy SP) — dán nhiều lần được</span><textarea class="input sm" id="qPaste" rows="2" placeholder="Bấm nút dấu trang trên trang sản phẩm Shopee → Ctrl+V vào đây"></textarea></label>` : ''}
    <p class="hint q-hint">${kind === 'film' ? 'Mỗi phim chạy trọn bộ (kịch bản → ảnh → clip → dựng). Ảnh / clip của các phim vẫn chia đều cho mọi tài khoản Muse; chạy nhiều phim cùng lúc chỉ nhanh hơn khi có nhiều tài khoản / luồng.' : 'Video từ link cần dữ liệu sản phẩm: tool mở trang sản phẩm trong Chrome của bạn rồi làm video tiếp theo; bạn bấm nút “Lấy SP” trên từng trang và dán vào ô trên — video đó tự làm tiếp.'} Phim/video lỗi không chặn hàng chờ.</p>
    <div class="q-list">${rows || `<p class="hint" style="padding:10px">Hàng chờ trống — bấm <b>Thêm nhiều ${qNoun(kind)}…</b></p>`}</div>`;
}

function openQueue(kind) {
  const r = openModal({ title: `Hàng chờ ${kind === 'film' ? 'làm phim' : 'video Aff'}`, icon: 'list-ordered', wide: true, body: '' });
  Q.modal = { kind, el: r.el, close: r.close };
  renderQueueModal();
  loadQueue(kind);
  r.el.addEventListener('click', (e) => {
    const b = e.target.closest('[data-qa]'); if (!b) return;
    const a = b.dataset.qa; const row = b.closest('[data-qid]');
    if (a === 'bulk') { (kind === 'film' ? fmBulkDialog : afBulkDialog)(); return; }
    if (a === 'open') { r.close(); if (kind === 'film') { FM.cur = +row.dataset.sid; FM.creating = false; store.set('filmCur', FM.cur); renderFilmList(); loadFilmDetail(); } else { AF.cur = +row.dataset.sid; AF.creating = false; store.set('affCur', AF.cur); renderAffList(); loadAffDetail(); } return; }
    if (['up', 'down', 'remove'].includes(a)) { queueAct(kind, a, { id: +row.dataset.qid }); return; }
    if (['pause', 'resume', 'clear'].includes(a)) queueAct(kind, a);
  });
  r.el.addEventListener('change', (e) => { if (e.target.id === 'qPar') queueAct(kind, 'parallel', { parallel: +e.target.value }); });
  r.el.addEventListener('paste', (e) => {
    if (e.target.id !== 'qPaste') return;
    const text = (e.clipboardData || window.clipboardData)?.getData('text') || ''; if (!text.trim()) return;
    e.preventDefault(); afQueuePaste(text, e.target);
  });
}

async function afQueuePaste(text, el) {
  try {
    const r = await api('POST', '/api/aff/paste', { text, settings: { ...(store.get('affDraft', {}) || {}), link: '' } });
