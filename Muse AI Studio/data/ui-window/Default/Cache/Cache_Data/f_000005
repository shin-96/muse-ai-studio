    <div class="mk-run-dlg">
      <div class="mk-run-item"><div><b>${esc(file.name)}</b><small>${lines} dòng phụ đề · ${fmtSize(file.size)}</small></div></div>
      <label class="field"><span>Tên video</span><input class="input" id="svNewName" value="${esc(name)}"></label>
      <label class="field"><span>Phong cách hình ảnh</span><select class="input select" id="svNewStyle">${svStyleOptions(store.get('srtStyle', 'co_trang'))}</select></label>
      <div class="sv-row">
        <label class="field"><span>Tỷ lệ</span><div class="seg seg-sm" id="svNewRatio">${['16:9', '9:16', '1:1'].map((r) => `<button type="button" data-r="${r}" class="${r === store.get('srtRatio', '16:9') ? 'on' : ''}">${r}</button>`).join('')}</div></label>
