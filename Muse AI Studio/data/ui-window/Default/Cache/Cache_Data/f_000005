async function addRefFiles(files) {
  files = [...files].filter((f) => /^image\//.test(f.type) || /\.(png|jpe?g|webp|gif|bmp)$/i.test(f.name));
  if (!files.length) return toast('Không có file ảnh hợp lệ', 'warn');
  files.sort((a, b) => (a.webkitRelativePath || a.name).localeCompare(b.webkitRelativePath || b.name, undefined, { numeric: true }));
  const key = (value) => refTokens(value || '');
  const entries = files.map((f) => ({ name: f.name, relativePath: f.webkitRelativePath || f.name, local: URL.createObjectURL(f), file: null, _f: f }));
  // Selecting the same folder/file again replaces its previous upload.  A
  // relative path keeps two same-named files in different subfolders apart.
  const incoming = new Set(entries.map((entry) => key(entry.relativePath)));
  S.refs = S.refs.filter((ref) => !incoming.has(key(ref.relativePath || ref.name)));
  S.refs.push(...entries);
  renderRefs();
  let idx = 0;
  const worker = async () => {
    while (idx < entries.length) {
      const e = entries[idx++];
      try {
        const res = await api('POST', '/api/refs?name=' + encodeURIComponent(e.name), undefined, e._f);
        e.file = res.file; e.url = res.url;
      } catch (err) {
        toast(`${e.name}: ${err.message}`, 'error');
        S.refs = S.refs.filter((x) => x !== e);
      }
      delete e._f;
    }
  };
  await Promise.all([worker(), worker(), worker(), worker()]);
  renderRefs();
  toast(`Đã thêm ${entries.length} ảnh tham chiếu`, 'success', 1800);
}

async function readDropEntries(dt) {
  const out = [];
  const walk = (entry) => new Promise((resolve) => {
    if (entry.isFile) entry.file((f) => { out.push(f); resolve(); }, () => resolve());
    else if (entry.isDirectory) {
      const reader = entry.createReader();
      const all = [];
      const read = () => reader.readEntries(async (ents) => {
        if (!ents.length) { for (const e of all) await walk(e); resolve(); }
        else { all.push(...ents); read(); }
      }, () => resolve());
      read();
    } else resolve();
  });
  const items = [...(dt.items || [])].map((it) => it.webkitGetAsEntry && it.webkitGetAsEntry()).filter(Boolean);
  if (items.length) { for (const e of items) await walk(e); return out; }
  return [...dt.files];
}

async function createTasks(run) {
  if (S.mode === 'image-to-video') return createImageToVideo(run);
  if (run && !canGenerate(S.mode)) { openLicense(); return; }
  const items = buildItems();
  if (!items.length) return toast('Hãy nhập prompt hoặc thêm ảnh tham chiếu', 'warn');
  if (S.refs.some((r) => !r.file)) return toast('Ảnh tham chiếu đang tải lên, đợi chút…', 'warn');
  if (S.pair === 'named') {
    const refs = S.refs.filter((r) => r.file).map((r) => ({ file: r.file, name: r.name }));
    const matched = namedItems(parsePrompts(), refs);
    const missing = [...new Set(matched.flatMap((item) => item.missing))];
    const ambiguous = [...new Set(matched.flatMap((item) => item.ambiguous))];
    if (ambiguous.length) return toast(`Trùng tên ảnh tham chiếu: ${ambiguous.join(', ')}. Đổi tên để mỗi ảnh là duy nhất.`, 'error', 7000);
    const empty = matched.filter((item) => !item.refs.length).length;
    if (missing.length) return toast(`Chưa tìm thấy ảnh: ${missing.join(', ')}`, 'error', 7000);
    if (empty) toast(`${empty} prompt chưa khớp tên ảnh — sẽ chạy không kèm ảnh`, 'warn', 5000);
  }
  if (run && !S.accounts.some((a) => a.enabled)) {
    toast('Chưa có tài khoản nào được bật — vào trang Tài khoản để thêm & đăng nhập', 'warn', 5000);
  }
  try {
    const created = await api('POST', '/api/tasks/bulk', {
      project_id: S.project, type: S.mode, ratio: S.ratio, count: S.count, items, run,
    });
    toast(`Đã ${run ? 'tạo & chạy' : 'thêm'} ${created.length} tác vụ`, 'success');
    $('#promptInput').value = '';
    // Named mode keeps the selected folder as a reusable reference library;
    // pair/shared retain the original clear-after-submit behavior.
    if (S.pair !== 'named') { S.refs = []; renderRefs(); }
    await loadTasks();
  } catch (e) { toast(e.message, 'error'); }
}

function i2vNatural(a, b) {
  return String(a || '').localeCompare(String(b || ''), undefined, { numeric: true, sensitivity: 'base' });
}

