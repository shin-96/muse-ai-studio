async function setI2vFolder(files) {
  const generation = ++S.i2v.generation;
  for (const old of S.i2v.files) if (old.local) URL.revokeObjectURL(old.local);
  const list = [...files].filter((f) => /^image\//.test(f.type) || /\.(png|jpe?g|webp|gif|bmp)$/i.test(f.name));
  list.sort((a, b) => i2vNatural(a.webkitRelativePath || a.name, b.webkitRelativePath || b.name));
  S.i2v.files = list.map((f) => ({ name: f.name, relativePath: f.webkitRelativePath || f.name, local: URL.createObjectURL(f), file: null, _f: f }));
  S.i2v.refs = [];
  S.i2v.pairs = [];
  $('#i2vStatus').textContent = list.length ? 'Đang tải ảnh lên…' : '';
  renderI2vFiles();
  let index = 0;
  const worker = async () => {
    while (index < S.i2v.files.length) {
      const entry = S.i2v.files[index++];
      if (generation !== S.i2v.generation) return;
      try {
        const res = await api('POST', '/api/refs?name=' + encodeURIComponent(entry.name), undefined, entry._f);
        entry.file = res.file; entry.url = res.url;
      } catch (error) { toast(`${entry.name}: ${error.message}`, 'error'); }
      delete entry._f;
    }
  };
  await Promise.all([worker(), worker(), worker(), worker()]);
  if (generation !== S.i2v.generation) return;
  S.i2v.refs = S.i2v.files.filter((x) => x.file).map((x) => ({ file: x.file, name: x.name, relativePath: x.relativePath }));
  renderI2vFiles();
  $('#i2vStatus').textContent = S.i2v.refs.length === list.length ? 'Đã tải xong, hãy kiểm tra ghép cặp' : 'Có ảnh tải lỗi, hãy chọn lại thư mục';
  if (list.length) toast(`Đã tải ${S.i2v.refs.length}/${list.length} ảnh`, S.i2v.refs.length === list.length ? 'success' : 'warn', 2200);
}

async function i2vPreview() {
  if (S.i2v.busy) return null;
  if (!S.i2v.files.length || S.i2v.refs.length !== S.i2v.files.length || S.i2v.files.some((x) => !x.file) || !S.i2v.promptText.trim()) return toast('Hãy chọn thư mục ảnh (tải đủ) và file prompt', 'warn');
  const promptCount = S.i2v.promptText.split(/\r?\n/).map((x) => x.trim()).filter(Boolean).length;
  if (S.i2v.refs.length !== promptCount) return toast(`Số ảnh (${S.i2v.refs.length}) phải bằng số prompt (${promptCount})`, 'error', 5000);
  const payload = { project_id: S.project, refs: S.i2v.refs.map((x) => ({ ...x })), text: S.i2v.promptText, separator: '', ratio: S.ratio };
  S.i2v.busy = true;
  try {
    const data = await api('POST', '/api/tasks/image-to-video/preview', payload);
    S.i2v.pairs = data.pairs || [];
    renderI2vFiles();
    $('#i2vStatus').textContent = `Đã ghép ${data.count} cặp theo thứ tự tên file`;
    toast(`Đã kiểm tra ${data.count} cặp ảnh · prompt`, 'success', 2200);
    return data;
  } catch (error) { $('#i2vStatus').textContent = error.message; toast(error.message, 'error', 5000); return null; }
  finally { S.i2v.busy = false; }
}

async function createImageToVideo(run) {
  if (S.i2v.creating) return;
  if (run && !canGenerate('video')) { openLicense(); return; }
  S.i2v.creating = true;
  const checked = await i2vPreview();
  if (!checked) { S.i2v.creating = false; return; }
  const payload = { project_id: S.project, refs: S.i2v.refs.map((x) => ({ ...x })), text: S.i2v.promptText, separator: '', ratio: S.ratio, run };
  S.i2v.busy = true;
  try {
    const data = await api('POST', '/api/tasks/image-to-video', payload);
    const count = Array.isArray(data) ? data.length : (data.count || (data.tasks || []).length);
    toast(`Đã ${run ? 'tạo & chạy' : 'thêm'} ${count} video`, 'success');
    for (const old of S.i2v.files) if (old.local) URL.revokeObjectURL(old.local);
    S.i2v.pairs = []; S.i2v.files = []; S.i2v.refs = []; S.i2v.promptText = ''; S.i2v.promptName = '';
    renderI2vFiles(); await loadTasks();
  } catch (error) { toast(error.message, 'error'); }
  finally { S.i2v.busy = false; S.i2v.creating = false; }
}

