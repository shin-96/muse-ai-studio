async function loadFilm() {
  try {
    const r = await api('GET', '/api/film');
    FM.list = r.projects || []; FM.styles = r.styles || []; FM.genres = r.genres || []; FM.langs = r.langs || []; FM.accents = r.accents || [];
    if (FM.cur && !FM.list.some((p) => p.id === FM.cur)) FM.cur = FM.list[0]?.id || null;
    if (!FM.cur && FM.list.length && !FM.creating) FM.cur = FM.list[0].id;
  } catch (e) { toast(e.message, 'error'); }
  if (!FM.list.length) FM.creating = true;
  renderFilmList();
  if (!Q.film) loadQueue('film');
  if (FM.cur && !FM.creating) await loadFilmDetail(); else renderFilmMain();
}

async function loadFilmDetail() {
  if (!FM.cur) return;
  try { FM.data = await api('GET', `/api/film/${FM.cur}`); } catch (e) { FM.data = null; toast(e.message, 'error'); }
  renderFilmMain();
}

function onFilmProject(p) {
  if (!p) return;
  const i = FM.list.findIndex((x) => x.id === p.id);
  if (i >= 0) FM.list[i] = p; else FM.list.unshift(p);
  if (S.page !== 'film') return;
  renderFilmList();
  if (p.id === FM.cur && !FM.creating) {
    if (FM.data) { const { characters, ...rest } = p; Object.assign(FM.data, rest); renderFilmHead(); }   // characters = số lượng
    fmReloadSoon(['scripting', 'music', 'images', 'refs', 'clips', 'dubbing'].includes(p.status) ? 1500 : 300);
  }
}

