          <label class="btn ghost xs" title="Dùng ảnh của bạn làm ảnh tham chiếu đạo cụ">${ic('upload')}Ảnh của bạn<input type="file" data-cup accept="image/png,image/jpeg,image/webp" hidden></label>
          ${x.ref_url ? `<button class="btn ghost xs" data-cdel title="Bỏ ảnh tham chiếu">${ic('trash')}</button>` : ''}
        </div>
      </div>
    </div>`).join('');
  return chars + narr + props || '<p class="hint">Bấm <b>Kịch bản</b> (hoặc Làm phim tự động): Muse đặt nhân vật, ngoại hình và giọng nói cố định cho từng người.</p>';
}

/* ---------------- cảnh */
function fmVisibleShots() {
  const list = FM.data?.shot_list || [];
  if (FM.filter === 'missing') return list.filter((s) => !s.image_url);
  if (FM.filter === 'noclip') return list.filter((s) => !s.clip_url || s.stale);
  if (FM.filter === 'error') return list.filter((s) => fmImgBad(s) || fmClipBad(s));
  return list;
}
const fmImgBad = (s) => !s.image_url && !!(s.error || ['error', 'stopped'].includes(s.task_status));
const fmClipBad = (s) => !!s.image_url && (!!s.stale || (!s.clip_url && !!(s.clip_error || ['error', 'stopped'].includes(s.clip_status))));

function renderFmPickBar() {
