function fmSpeedHtml(d) {
  const cap = d.capacity || { accounts: 0, per_account: [], slots: 0, cpu_render: 1 };
  const st = d.settings || {};
  const per = cap.per_account || []; const vper = cap.vid_per_account || [];
  const shots = d.shot_list || [];
  const left = shots.filter((x) => !x.image_url).length || (shots.length ? 0 : fmScenes(st.minutes));
  const cleft = shots.filter((x) => !x.clip_url).length || (shots.length ? 0 : fmScenes(st.minutes));
  const eta = (cap.slots && left ? left * 80 / cap.slots : 0) + (cap.vid_slots && cleft ? cleft * 140 / cap.vid_slots : 0);   // đo thật: ~80 s/ảnh, ~140 s/clip thoại
  const opt = (n, cur) => `<option value="${n}" ${+cur === n ? 'selected' : ''}>${n}</option>`;
  return `<div class="sv-speed">
    <div class="sv-speed-head">${ic('zap')}<b>Tốc độ</b>${eta ? `<small>≈ ${Math.ceil(eta / 60)} phút cho phần còn lại</small>` : ''}</div>
    <div class="sv-speed-now"><b>${cap.slots}</b><span>ảnh cùng lúc<small>${per.length ? `${per.length} tài khoản (${per.join(' + ')} luồng ảnh)` : 'chưa có tài khoản dùng được'}</small></span></div>
    <div class="sv-speed-now"><b>${cap.vid_slots || 0}</b><span>clip cùng lúc<small>${vper.length ? `${vper.length} tài khoản (${vper.join(' + ')} luồng video)` : 'chưa có tài khoản dùng được'}</small></span></div>
    <label class="field inline"><span>Luồng ảnh mỗi tài khoản</span><input class="input xs num" type="number" id="fmImgThreads" min="1" max="50" value="${per.length ? Math.max(...per) : 5}">
      <button class="btn ghost xs" id="fmImgApply">Áp dụng</button></label>
    <label class="field inline"><span>Luồng video mỗi tài khoản</span><input class="input xs num" type="number" id="fmVidThreads" min="1" max="50" value="${vper.length ? Math.max(...vper) : 5}">
      <button class="btn ghost xs" id="fmVidApply">Áp dụng</button></label>
    <label class="field inline"><span>Luồng dựng phim</span><select class="input xs select" id="fmERender">
      <option value="0" ${!st.render_threads ? 'selected' : ''}>Tự động (${cap.cpu_render})</option>${[1, 2, 3, 4].map((n) => opt(n, st.render_threads)).join('')}</select></label>
    <small class="hint">Nhanh nhất là thêm tài khoản Muse (tab Tài khoản). Đặt quá nhiều luồng cho 1 tài khoản, Muse có thể chặn bớt.</small>
  </div>`;
}

/* ---------------- nhạc nền */
