  const file = (kind, url, name, label, icon) => `<div class="sv-audio-row">
      <span class="sv-audio-lbl">${ic(icon)}${label}</span>
      ${url ? `<audio src="${esc(url)}" controls preload="none"></audio><small class="sv-audio-name" title="${esc(name || '')}">${esc(name || '')}</small>
        <button class="btn ghost xs" data-audel="${kind}" title="Bỏ file">${ic('trash')}</button>`
        : `<label class="btn ghost xs">${ic('upload')}Tải ${kind === 'voice' ? 'voice' : 'nhạc'}<input type="file" data-aup="${kind}" accept="${SV_AUDIO}" hidden></label>`}
      ${url ? vol(kind === 'voice' ? 'svVoiceVol' : 'svMusicVol', kind === 'voice' ? st.voice_volume : st.music_volume, kind === 'voice' ? 2 : 1) : ''}
