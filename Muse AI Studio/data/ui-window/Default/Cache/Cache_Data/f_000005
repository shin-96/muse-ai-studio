function afPastePreview(text) {
  try {
    const i = text.indexOf('{'); const o = JSON.parse(text.slice(i, text.lastIndexOf('}') + 1));
    if (o._ !== 'musestudio-shopee') return null;
    const it = o.kind === 'get_pc' ? (o.data?.item || {}) : o;
    const n = o.kind === 'get_pc' ? (o.data?.product_images?.images || []).length : (o.images || []).length;
    return { title: it.title || '', images: n, url: o.url || '', kind: o.kind };
  } catch { return null; }
}

async function afCheckLink() {
  const v = $('#afLink')?.value.trim(); const info = $('#afLinkInfo'); if (!v || !info) return;
  if (v.includes('musestudio-shopee')) {
    const pv = afPastePreview(v);
    if (!pv) { info.textContent = 'Dữ liệu dán bị thiếu — bấm lại nút Lấy SP trên trang sản phẩm rồi dán lại.'; info.classList.add('sv-err'); AF.pasted = ''; return; }
    AF.pasted = v; $('#afLink').value = pv.url || '(dữ liệu từ nút Lấy SP)';
    info.innerHTML = `${ic('check')} Đã nhận dữ liệu sản phẩm: <b>${esc(pv.title)}</b> · ${pv.images} ảnh${pv.kind === 'page' ? ' (đọc trên trang)' : ''}. Bấm <b>Làm video tự động</b>.`;
    info.classList.remove('sv-err'); return;
  }
  if (AF.pasted && v === afPastePreview(AF.pasted)?.url) return;
  AF.pasted = '';
  try {
    const r = await api('POST', '/api/aff/check-link', { link: v });
    AF.linkInfo = r;
    info.innerHTML = `${ic('check')} Link hợp lệ (sản phẩm <b>${r.item_id}</b>). Bấm <b>Mở trong Chrome</b> → trên trang Shopee bấm nút <b>Lấy SP → Muse AI Studio</b> → dán (Ctrl+V) vào ô trên. Hoặc bấm Làm video tự động, tool mở trang và chờ bạn dán. <a href="#" data-afgrab>Cài nút Lấy SP</a>`;
    info.classList.remove('sv-err');
  } catch (e) { info.textContent = e.message; info.classList.add('sv-err'); }
}

async function afCreate(run) {
  const st = afCreateSettings();
  const body = { settings: st };
  if (AF.src === 'manual') {
    const title = $('#afPTitle').value.trim();
    if (!title) { toast('Nhập tên sản phẩm', 'error'); $('#afPTitle').focus(); return; }
    if (!AF.photos.length) { toast('Tải lên ít nhất 1 ảnh thật của sản phẩm', 'error'); return; }
    body.product = { title, description: $('#afPDesc').value.trim(), price: $('#afPPrice').value.trim(), url: $('#afPUrl').value.trim() };
    body.photos = AF.photos.map((p) => p.file);
  } else if (AF.pasted) { body.pasted = AF.pasted;
  } else if (!st.link) { toast('Dán link sản phẩm Shopee (hoặc dữ liệu từ nút Lấy SP)', 'error'); $('#afLink').focus(); return; }
  store.set('affDraft', { ...st, link: '', notes: '' });
  const btns = $$('#afGo, #afCreateOnly'); btns.forEach((b) => { b.disabled = true; });
  try {
    const d = await api('POST', '/api/aff', body);
    AF.cur = d.id; store.set('affCur', d.id); AF.data = d; AF.creating = false; AF.filter = 'all'; AF.limit = 40; AF.picked.clear(); AF.photos = []; AF.pasted = '';
    if (run) await api('POST', `/api/aff/${d.id}/run`, { action: 'all' });
    toast(run ? (d.has_product ? 'Đã bắt đầu — tải ảnh sản phẩm rồi Muse viết kịch bản' : 'Đã mở sản phẩm trong Chrome của bạn — bấm nút “Lấy SP → Muse AI Studio” rồi dán vào khung Sản phẩm') : 'Đã tạo dự án. Bấm từng bước ở thanh trên.', 'success', 6000);
    await loadAff();
  } catch (e) { toast(e.message, 'error', 6000); btns.forEach((b) => { b.disabled = false; }); }
}

/* ---------------- đầu trang: các bước */
function renderAffHead() {
  const d = AF.data; const box = $('#afHead'); if (!d || !box) return;
  const st = d.settings || {};
  const live = !!d.busy;
  const pct = d.status === 'done' ? 100 : Math.round(d.progress || 0);
  const has = d.shots > 0;
  const prod = d.has_product;
  const mm = st.music_mode || 'auto';
  const presenter = st.host === 'presenter';
  const host = (d.characters || []).find((c) => c.id === 'host');
  const steps = [
    ['product', prod ? 'Lấy lại sản phẩm' : 'Sản phẩm', 'bag', prod, st.link ? 'Mở trang sản phẩm trong Chrome của bạn → bấm nút Lấy SP → dán vào khung Sản phẩm' : 'Sản phẩm tự nhập — sửa ở khung Sản phẩm', !!st.link],
    ['script', has ? 'Viết lại kịch bản' : 'Kịch bản', 'sparkles', has, 'Muse viết kịch bản theo phong cách đã chọn', prod && !(d.images > 0)],
    ['music', mm === 'auto' ? (d.music ? 'Tạo lại nhạc' : 'Nhạc nền') : (mm === 'upload' ? 'Nhạc của bạn' : 'Không nhạc'), 'music', !!d.music || mm === 'none', 'Muse sáng tác nhạc nền không lời', mm === 'auto'],
    ...(presenter ? [['refs', 'Ảnh người dẫn', 'user', !!host?.ref_url, 'Chân dung người dẫn cố định cho mọi cảnh', has]] : []),
    ['images', `Ảnh cảnh${has ? ` ${d.images}/${d.shots}` : ''}`, 'images', has && d.images === d.shots, 'Tạo ảnh khung hình (đính kèm ảnh thật sản phẩm)', has],
    ['clips', `Clip${has ? ` ${d.clips}/${d.shots}` : ''}`, 'video', has && d.clips === d.shots, 'Ảnh cảnh → clip Muse có lời nói', d.images > 0],
    ['render', 'Dựng video', 'film', !!d.video_url, 'Nối clip + phụ đề + chữ tiêu đề + khung kết + nhạc', d.images > 0],
  ];
  const step = ([act, label, icon, done, title, enabled], n) => `<button class="btn sm sv-step ${done ? 'fm-done' : ''}" data-afrun="${act}" ${live || !enabled ? 'disabled' : ''} title="${esc(title)}"><b>${done ? ic('check') : n}</b>${ic(icon)}${esc(label)}</button>`;
  const styleLbl = ((AF.opts.aff_styles || []).find((x) => x.id === st.aff_style) || {}).label || '';
  box.innerHTML = `
    <div class="sv-head-top">
      <div class="sv-title"><b>${esc(d.product?.title || d.name)}</b><small>${esc(styleLbl)} · ~${st.seconds || 30} giây · ${st.ratio || '9:16'}${has ? ` · ${d.shots} cảnh · ${d.lines} câu nói` : ''}${d.checks ? ` · <span class="af-warn">${d.checks} cảnh cần kiểm tra lời</span>` : ''}</small></div>
      <span class="sv-st st-${esc(d.status)}">${esc(AF_STATUS[d.status] || d.status)}</span>
    </div>
    <div class="sv-msg ${d.status === 'paste' ? 'af-login-msg' : ''}">${esc(d.message || '')}</div>
    <div class="bar"><i style="width:${Math.max(live ? 3 : 0, pct)}%"></i></div>
    <div class="sv-acts">
      <button class="btn primary-alt sm" data-afrun="${has ? 'continue' : 'all'}" ${live ? 'disabled' : ''} title="Tự chạy hết các bước còn thiếu">${ic('play')}${has ? 'Chạy tiếp tự động' : 'Làm video tự động'}</button>
      <span class="sv-sep"></span>
      ${steps.map((x, i) => step(x, i + 1)).join('')}
      <div class="grow"></div>
      ${live ? `<button class="btn danger sm" id="afStop">${ic('square')}Dừng</button>` : ''}
      ${d.video_url ? `<button class="btn sm" id="afPlay">${ic('play')}Xem video</button><button class="btn ghost sm" id="afReveal" title="Mở thư mục chứa video">${ic('folder-open')}</button>` : ''}
      ${has ? `<a class="btn ghost sm" href="/api/aff/${d.id}/caption.txt" download title="Tải caption + hashtag để đăng">${ic('download')}Caption</a>` : ''}
      <button class="btn ghost sm" id="afDel" title="Xoá dự án (giữ nguyên ảnh/clip/video đã tạo)" ${live ? 'disabled' : ''}>${ic('trash')}</button>
    </div>`;
}

