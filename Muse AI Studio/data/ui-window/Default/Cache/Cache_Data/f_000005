/* ==================================================================== HIỆU ỨNG CHUYỂN ĐỘNG ẢNH (1.7.0) */
// Kiểu chuyển động ảnh tĩnh khi dựng video (khớp MOTION_PRESETS trong slideshow.py) — mỗi kiểu = các động tác luân phiên
const MOTION_OPTS = [
  ['kenburns', 'Tự động xen kẽ (zoom + lia)', ['in', 'right', 'out', 'left', 'in_up']],
  ['zoom', 'Chỉ zoom (vào / ra xen kẽ)', ['in', 'out']],
  ['pan_h', 'Chỉ lia ngang (phải / trái)', ['right', 'left']],
  ['pan_v', 'Chỉ lia dọc (lên / xuống)', ['up', 'down']],
  ['in', 'Zoom vào', ['in']], ['out', 'Zoom ra', ['out']],
  ['right', 'Lia sang phải', ['right']], ['left', 'Lia sang trái', ['left']],
  ['up', 'Lia lên', ['up']], ['down', 'Lia xuống', ['down']],
  ['random', 'Ngẫu nhiên mỗi cảnh', ['in', 'up', 'left', 'out', 'right', 'down']],
  ['static', 'Ảnh đứng yên', ['static']],
];
const MOTION_STRENGTH_OPTS = [['light', 'Nhẹ'], ['medium', 'Vừa'], ['strong', 'Mạnh']];
const SHAKE_OPTS = [['off', 'Tắt'], ['light', 'Nhẹ (cầm tay)'], ['medium', 'Vừa'], ['strong', 'Mạnh']];
const optList = (opts, cur) => opts.map(([v, label]) => `<option value="${v}" ${v === cur ? 'selected' : ''}>${label}</option>`).join('');

/** Khối chọn chuyển động: kiểu + mức + rung, kèm ô xem thử chạy đúng kiểu đã chọn. p = tiền tố id (sv | fmE). */
function motionHtml(p, st, label, img) {
  const motion = MOTION_OPTS.some((o) => o[0] === st.motion) ? st.motion : 'kenburns';
  const still = motion === 'static';
  return `<div class="mv-box">
      <label class="field mv-main"><span>${label} <em>khi dựng video</em></span><select class="input sm select" id="${p}Motion">${optList(MOTION_OPTS, motion)}</select></label>
      <div class="mv-sub">
        <label class="field inline" title="Mức zoom / quãng lia"><span>Mức</span><select class="input xs select" id="${p}MotionStrength" ${still ? 'disabled' : ''}>${optList(MOTION_STRENGTH_OPTS, st.motion_strength || 'medium')}</select></label>
        <label class="field inline" title="Rung lắc như máy quay cầm tay — cộng thêm vào kiểu chuyển động đã chọn (kể cả ảnh đứng yên)"><span>Rung máy quay</span><select class="input xs select" id="${p}Shake">${optList(SHAKE_OPTS, st.shake || 'off')}</select></label>
      </div>
      <div class="mv-prev" title="Xem thử chuyển động" data-motion="${motion}" data-strength="${esc(st.motion_strength || 'medium')}" data-shake="${esc(st.shake || 'off')}">
        <div class="mv-frm"><div class="mv-shk"><div class="mv-img" ${img ? `style="background-image:url('${esc(img)}')"` : ''}></div></div></div><small class="mv-cap"></small></div>
    </div>`;
}

const MV_NAMES = { in: 'zoom vào', out: 'zoom ra', right: 'lia phải', left: 'lia trái', up: 'lia lên', down: 'lia xuống', in_up: 'zoom vào', static: 'đứng yên' };
function mvApply(el, step) {
  const kinds = (MOTION_OPTS.find((o) => o[0] === el.dataset.motion) || MOTION_OPTS[0])[2];
  const k = kinds[step % kinds.length];
  const img = el.querySelector('.mv-img');
  img.className = 'mv-img';
  void img.offsetWidth;                                   // khởi động lại animation
  img.classList.add(`mv-${k}`, `mv-${el.dataset.strength}`);
  el.querySelector('.mv-shk').className = `mv-shk shk-${el.dataset.shake}`;
  el.querySelector('.mv-cap').textContent = MV_NAMES[k] + (el.dataset.shake !== 'off' ? ' + rung' : '');
}
let mvStep = 0;
function mvRefresh(root) { $$('.mv-prev', root || document).forEach((el) => mvApply(el, mvStep)); }
setInterval(() => { mvStep += 1; $$('.mv-prev').forEach((el) => { if (el.offsetParent) mvApply(el, mvStep); }); }, 2800);
/** Đổi kiểu/mức/rung → cập nhật ô xem thử ngay (không chờ server). */
function mvLive(p, t) {
  const box = t.closest('.mv-box'); if (!box) return;
  const prev = $('.mv-prev', box);
  if (t.id === `${p}Motion`) { prev.dataset.motion = t.value; const s2 = $(`#${p}MotionStrength`, box); if (s2) s2.disabled = t.value === 'static'; }
  if (t.id === `${p}MotionStrength`) prev.dataset.strength = t.value;
  if (t.id === `${p}Shake`) prev.dataset.shake = t.value;
  mvApply(prev, mvStep);
}

