}

function fmReloadSoon(ms = 600) {
  if (S.page !== 'film' || !FM.cur || FM.creating) return;
  clearTimeout(fmTimer);
  fmTimer = setTimeout(() => { if (fmEditing()) fmReloadSoon(2000); else loadFilmDetail(); }, ms);   // đang gõ → đợi, không xoá chữ
