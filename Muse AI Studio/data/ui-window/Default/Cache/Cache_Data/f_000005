    : '<span class="muted">Chưa chọn dữ liệu</span>';
  const byRef = new Map((S.i2v.pairs || []).map((pair) => [String(pair.relativePath || pair.refs?.[0]?.name || ''), pair]));
  const rows = files.map((f, i) => {
    const pair = byRef.get(String(f.relativePath || f.name)) || S.i2v.pairs[i];
    return `<div class="i2v-row ${pair ? '' : 'unpaired'}"><b>${i + 1}</b><span title="${esc(f.relativePath || f.name)}">${esc(f.name)}</span><span>${pair ? esc(pair.prompt) : '— chưa ghép —'}</span></div>`;
  });
