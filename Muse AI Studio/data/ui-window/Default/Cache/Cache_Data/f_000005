    $('#createCount').textContent = count ? `(${count})` : '';
    $('#pairHint').textContent = '';
    return;
  }
  const prompts = parsePrompts();
  const nRefs = S.refs.length;
  $('#promptCount').textContent = prompts.length;
  $('#refCount').textContent = nRefs;
  $('#dropzone').classList.toggle('has', nRefs > 0);
  const items = buildItems();
  $('#createCount').textContent = items.length ? `(${items.length})` : '';
  let hint = '';
  if (nRefs) {
    if (S.pair === 'named') {
      const matched = namedItems(prompts, readyRefs());
      const missing = matched.reduce((sum, item) => sum + item.missing.length, 0);
      const empty = matched.filter((item) => !item.refs.length).length;
      const ambiguous = matched.reduce((sum, item) => sum + item.ambiguous.length, 0);
      // ảnh không prompt nào gọi tên → thường do tên file khác chữ trong prompt (vd "lung_mat.png" ↔ "lửng mật")
      const used = new Set(matched.flatMap((item) => item.refs.map((ref) => ref.file)));
      const unused = prompts.length ? readyRefs().filter((ref) => !used.has(ref.file)) : [];
      hint = prompts.length
        ? `${matched.filter((item) => item.refs.length).length}/${prompts.length} prompt đã ghép ảnh theo tên`
        : 'Mỗi prompt sẽ tự chọn ảnh theo tên file';
      if (ambiguous) hint += ` · trùng tên ${ambiguous} mục`;
      else if (missing) hint += ` · thiếu ${missing} tên được đánh dấu`;
      else if (empty) hint += ` · ${empty} prompt chưa khớp ảnh`;
      if (unused.length) hint += ` · ${unused.length} ảnh không prompt nào gọi tên`;
      const preview = $('#namedPreview');
      if (preview) {
        preview.style.display = prompts.length ? '' : 'none';
        const warn = unused.length ? `<div class="named-preview-row warn"><b>!</b><span>Ảnh không prompt nào gọi tên (sẽ KHÔNG được gửi): ${esc(unused.map((ref) => ref.name || ref.file).join(', '))}. Viết đúng tên file (không cần đuôi .png) vào prompt, hoặc đổi tên file cho giống chữ trong prompt.</span></div>` : '';
        preview.innerHTML = warn + matched.map((item, i) => {
          const names = item.refs.map((ref) => ref.name || ref.file).join(', ');
          const issue = item.ambiguous.length ? `Trùng tên: ${item.ambiguous.join(', ')}`
            : item.missing.length ? `Thiếu: ${item.missing.join(', ')}`
              : (!item.refs.length ? 'Không gọi ảnh tham chiếu' : '');
          return `<div class="named-preview-row"><b>P${i + 1}</b><span title="${esc(prompts[i])}">${esc(names || issue)}</span>${issue && names ? `<em>${esc(issue)}</em>` : ''}</div>`;
        }).join('');
      }
    } else if (S.pair !== 'named') {
      const preview = $('#namedPreview');
      if (preview) { preview.style.display = 'none'; preview.innerHTML = ''; }
    }
    if (S.pair === 'shared') hint = `Mỗi prompt dùng chung ${nRefs} ảnh → ${items.length} tác vụ`;
    else if (S.pair === 'pair') {
      if (prompts.length <= 1) hint = `${nRefs} ảnh × ${prompts.length ? '1 prompt chung' : 'không prompt'} → ${items.length} tác vụ`;
      else hint = `Ảnh i ↔ prompt i (${Math.min(nRefs, prompts.length)} cặp${prompts.length > nRefs ? `, ${prompts.length - nRefs} prompt không ảnh` : ''}${nRefs > prompts.length ? `, thừa ${nRefs - prompts.length} ảnh` : ''})`;
    }
  } else {
    hint = S.mode === 'video' ? 'Không có ảnh: tạo video từ chữ. Thêm ảnh để tạo video từ ảnh.' : 'Không bắt buộc. Thêm ảnh để giữ nhân vật / phong cách.';
    const preview = $('#namedPreview');
    if (preview) { preview.style.display = 'none'; preview.innerHTML = ''; }
  }
  $('#pairHint').textContent = hint;
  saveDraft();
}
