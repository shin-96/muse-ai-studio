function svSegBind(bg, sel, key) {
  $(sel, bg).onclick = (e) => { const b = e.target.closest(`[data-${key}]`); if (!b) return; $$(`${sel} button`, bg).forEach((x) => x.classList.toggle('on', x === b)); };
}

function svModeSeg(id, cur) {
