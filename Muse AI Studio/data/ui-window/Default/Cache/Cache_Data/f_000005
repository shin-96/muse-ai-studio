function renderSrtHead() {
  const d = SV.data; const box = $('#svHead'); if (!d || !box) return;
  const st = d.settings || {};
  const film = st.mode === 'film';
  const idea = st.source === 'idea';
  const live = !!d.busy;   // có tiến trình thật đang chạy (không suy từ tên trạng thái — mở lại app vẫn bấm được)
  const pct = d.status === 'done' ? 100 : Math.round(d.progress || 0);
  const step = (n, act, label, icon, title, enabled = true) => `<button class="btn sm sv-step" data-svrun="${act}" ${live || !enabled ? 'disabled' : ''} title="${esc(title)}"><b>${n}</b>${ic(icon)}${label}</button>`;
  const hasCues = d.cues > 0;
  const hasPlan = d.planned > 0;
  const steps = [];
  if (idea) steps.push(['script', hasCues ? 'Viết lại kịch bản' : 'Viết kịch bản', 'sparkles', 'Muse viết lời dẫn theo ý tưởng → tự tạo phụ đề có mốc thời gian', !(d.images > 0)]);
  steps.push(['plan', hasPlan ? 'Phân tích lại' : 'Phân tích kịch bản', 'wand', 'Muse đọc cả kịch bản: nhân vật, bối cảnh, mô tả từng cảnh', hasCues]);
  steps.push(['refs', 'Ảnh nhân vật', 'users', 'Tạo ảnh tham chiếu cho nhân vật chính', hasPlan]);
  steps.push(['images', 'Ảnh cảnh', 'images', 'Tạo ảnh cho các cảnh chưa có ảnh / bị lỗi', hasPlan]);
  if (film) steps.push(['clips', 'Clip động', 'video', 'Mỗi ảnh cảnh → 1 clip Muse ảnh-sang-video (chỉ cảnh chưa có clip / lỗi)', d.images > 0]);
  steps.push(['render', film ? 'Dựng phim' : 'Dựng video', 'film', film ? 'Ghép clip theo đúng mốc phụ đề + phụ đề + âm thanh' : 'Ghép ảnh theo mốc thời gian SRT + phụ đề', d.images > 0]);
  const allAct = hasPlan ? 'continue' : 'all';
  const allTitle = (hasPlan ? '' : (idea && !hasCues ? 'Viết kịch bản → ' : '') + 'Phân tích → ') + 'ảnh nhân vật → ảnh cảnh → ' + (film ? 'clip động → dựng phim' : 'dựng video');
  box.innerHTML = `
    <div class="sv-head-top">
      <div class="sv-title"><b>${film ? '<span class="chip xs film">Phim</span>' : ''}${esc(d.name)}</b><small>${hasCues ? `${esc(d.srt_name || '')} · ${d.cues} dòng thoại · ${d.shots} cảnh · ${svDur(d.duration)} · ${d.images}/${d.shots} ảnh${film ? ` · ${d.clips}/${d.shots} clip` : ''}` : `Phim từ ý tưởng · ~${st.minutes} phút · chưa có kịch bản`}</small></div>
      <span class="sv-st st-${esc(d.status)}">${esc(SV_STATUS[d.status] || d.status)}</span>
    </div>
    <div class="sv-msg">${esc(d.message || '')}</div>
    <div class="bar"><i style="width:${Math.max(live ? 3 : 0, pct)}%"></i></div>
    <div class="sv-acts">
      <button class="btn primary-alt sm" data-svrun="${allAct}" ${live ? 'disabled' : ''} title="${esc(allTitle)}">${ic('play')}${hasPlan ? 'Chạy tiếp tất cả' : 'Chạy tất cả'}</button>
      <span class="sv-sep"></span>
      ${steps.map((x, i) => step(i + 1, ...x)).join('')}
      <div class="grow"></div>
      ${live ? `<button class="btn danger sm" id="svStop">${ic('square')}Dừng</button>` : ''}
      ${hasCues ? `<a class="btn ghost sm" href="/api/srt/${d.id}/srt" download title="Tải file phụ đề .srt (để thu voice / TTS theo đúng mốc)">${ic('download')}Xuất SRT</a>` : ''}
      ${d.video_url ? `<button class="btn sm" id="svPlay">${ic('play')}Xem ${film ? 'phim' : 'video'}</button><button class="btn ghost sm" id="svReveal" title="Mở thư mục chứa video">${ic('folder-open')}</button>` : ''}
      <button class="btn ghost sm" id="svDel" title="Xoá dự án (giữ nguyên ảnh/video đã tạo)" ${live ? 'disabled' : ''}>${ic('trash')}</button>
    </div>`;
}

function svVisibleShots() {
  const list = SV.data?.shot_list || [];
  if (SV.filter === 'missing') return list.filter((s) => !s.image_url);
  if (SV.filter === 'noclip') return list.filter((s) => !s.clip_url);
  if (SV.filter === 'error') return list.filter((s) => (!s.image_url && (s.error || ['error', 'stopped'].includes(s.task_status)))
    || (!s.clip_url && (s.clip_error || ['error', 'stopped'].includes(s.clip_status))));
  return list;
}

const svImgBad = (s) => !s.image_url && !!(s.error || ['error', 'stopped'].includes(s.task_status));
const svClipBad = (s) => SV.data?.settings?.mode === 'film' && !!s.image_url && !s.clip_url && !!(s.clip_error || ['error', 'stopped'].includes(s.clip_status));
function svIsBad(s) { return svImgBad(s) || svClipBad(s); }

function renderSvPickBar() {
  const box = $('#svPickBar'); if (!box || !SV.data) return;
  const film = SV.data.settings?.mode === 'film';
  const ids = new Set((SV.data.shot_list || []).map((s) => s.id));
  [...SV.picked].forEach((id) => { if (!ids.has(id)) SV.picked.delete(id); });
  const n = SV.picked.size;
  const bad = (SV.data.shot_list || []).filter(svImgBad).length;
  const cbad = film ? (SV.data.shot_list || []).filter(svClipBad).length : 0;
  const off = SV.data.busy ? 'disabled' : '';
  box.innerHTML = `
    <button class="btn ghost xs" data-pick-bad="img" ${bad ? '' : 'disabled'} title="Chọn mọi cảnh lỗi ảnh / bị Muse từ chối">${ic('check')}Chọn ảnh lỗi (${bad})</button>
    ${film ? `<button class="btn ghost xs" data-pick-bad="clip" ${cbad ? '' : 'disabled'} title="Chọn mọi cảnh có ảnh nhưng clip lỗi / bị từ chối">${ic('check')}Chọn clip lỗi (${cbad})</button>` : ''}
    ${n ? `<span class="sv-pick-n">Đã chọn ${n}</span>
      <button class="btn ghost xs" data-pick-none>${ic('x')}Bỏ chọn</button>
      <button class="btn xs" data-pick-run="images" ${off} title="Tạo lại ảnh các cảnh đã chọn bằng mô tả hiện tại">${ic('refresh')}Tạo lại ảnh</button>
      <button class="btn primary-alt xs" data-pick-run="fix" ${off} title="Muse viết lại mô tả các cảnh đã chọn cho hợp chính sách (giữ nhân vật, bối cảnh, ý nghĩa) rồi tạo lại ảnh">${ic('wand')}AI sửa prompt + tạo lại</button>
      ${film ? `<button class="btn xs" data-pick-run="clips" ${off} title="Tạo lại clip động các cảnh đã chọn">${ic('video')}Tạo lại clip</button>
      <button class="btn ghost xs" data-pick-run="fixclip" ${off} title="Muse viết lại chuyển động cho hợp chính sách rồi tạo lại clip">${ic('wand')}AI sửa chuyển động + clip</button>` : ''}` : ''}`;
}

function renderSrtShots() {
  const box = $('#svShots'); if (!box || !SV.data) return;
  renderSvPickBar();
  const film = SV.data.settings?.mode === 'film';
  const names = Object.fromEntries((SV.data.characters || []).map((c) => [c.id, c.name]));
  const all = svVisibleShots(); const items = all.slice(0, SV.limit);
  const ratio = (SV.data.settings?.ratio || '16:9').replace(':', ' / ');
  box.innerHTML = items.map((s) => {
    const busy = ['queued', 'running'].includes(s.task_status);
    const cbusy = ['queued', 'running'].includes(s.clip_status);
    const bad = !s.image_url && (s.error || ['error', 'stopped'].includes(s.task_status));
    const cbad = film && s.image_url && !s.clip_url && (s.clip_error || ['error', 'stopped'].includes(s.clip_status));
    const clipTag = !film || !s.image_url ? '' : s.clip_url ? `<button class="sv-clip-tag ok" data-clip="${esc(s.clip_url)}" title="Xem clip động${+s.clip_soft ? ' (bản chuyển động nhẹ do Muse từ chối bản gốc)' : ''}">${ic('play')}clip${+s.clip_soft ? ' · nhẹ' : ''}</button>`
      : cbusy ? `<span class="sv-clip-tag">${s.clip_status === 'running' ? `clip ${Math.round(s.clip_progress || 0)}%` : 'chờ clip'}</span>`
      : cbad ? '<span class="sv-clip-tag bad">clip lỗi</span>' : '';
    return `<div class="sv-shot ${bad || cbad ? 'bad' : ''} ${SV.picked.has(s.id) ? 'picked' : ''}" data-sid="${s.id}">
      <div class="sv-thumb" style="aspect-ratio:${ratio}">${s.image_url ? `<img src="${esc(s.image_url)}" loading="lazy" alt="" data-zoom="${esc(s.image_url)}">`
        : `<span>${busy ? (s.task_status === 'running' ? `Đang tạo ${Math.round(s.task_progress || 0)}%` : 'Chờ tạo') : bad ? 'Lỗi' : 'Chưa có ảnh'}</span>`}${clipTag}${shotTimeTag(s)}</div>
      <div class="sv-shot-body">
        <div class="sv-shot-top"><label class="sv-pick" title="Chọn cảnh này để tạo lại / AI sửa"><input type="checkbox" data-pick ${SV.picked.has(s.id) ? 'checked' : ''}></label><b>#${s.id}</b><span class="mono">${svTime(s.start)} → ${svTime(s.end)}</span><small>${(s.end - s.start).toFixed(1)}s</small>
          ${(s.characters || []).map((c) => `<span class="chip xs">${esc(names[c] || c)}</span>`).join('')}
          ${s.fallback ? '<span class="chip xs warn" title="Muse bỏ sót cảnh này, tool dùng lời thoại làm mô tả">tự động</span>' : ''}
          ${s.fixed ? `<span class="chip xs fix" title="Muse đã viết lại mô tả cho hợp chính sách. Bản gốc: ${esc(s.scene_orig || '')}">AI đã sửa</span><button class="btn ghost xs" data-restore title="Khôi phục mô tả gốc">${ic('rotate')}</button>` : ''}
          ${+s.soft ? `<span class="chip xs warn" title="Muse từ chối mô tả gốc → tool tự thử lại bằng ${+s.soft >= 2 ? 'khoảnh khắc yên bình (giữ nhân vật + bối cảnh)' : 'bản nhẹ nhàng hơn'}. Sửa mô tả để thử lại từ bản gốc.">${+s.soft >= 2 ? 'bản yên bình' : 'bản nhẹ'}</span>` : ''}
          <div class="grow"></div>
          <button class="btn ghost xs" data-regen title="Tạo lại ảnh cảnh này${film ? ' (clip cũ sẽ bỏ, cần tạo lại clip)' : ''}" ${busy || SV.data.busy ? 'disabled' : ''}>${ic('refresh')}Tạo lại${film ? ' ảnh' : ''}</button>
          <button class="btn ghost xs" data-fixone title="Muse viết lại mô tả cảnh này cho hợp chính sách rồi tạo lại ảnh" ${busy || SV.data.busy || !s.scene ? 'disabled' : ''}>${ic('wand')}AI sửa</button>
          ${film ? `<button class="btn ghost xs" data-regclip title="Tạo lại clip động của cảnh này" ${!s.image_url || cbusy || SV.data.busy ? 'disabled' : ''}>${ic('video')}${s.clip_url ? 'Tạo lại clip' : 'Tạo clip'}</button>` : ''}
        </div>
        <div class="sv-lines">${esc(s.text)}</div>
        <textarea class="input xs sv-scene" rows="2" placeholder="Mô tả hình ảnh (Muse viết ở bước Phân tích)">${esc(s.scene || '')}</textarea>
        ${film ? `<textarea class="input xs sv-motion" rows="1" placeholder="Chuyển động trong clip (tiếng Anh) — vd: she slowly turns her head, tears fall; slow push-in">${esc(s.motion || '')}</textarea>` : ''}
        ${bad && s.error ? `<small class="sv-err">${esc(s.error)}</small>` : ''}
        ${cbad && s.clip_error ? `<small class="sv-err">Clip: ${esc(s.clip_error)}</small>` : ''}
      </div>
    </div>`;
  }).join('') || '<p class="hint" style="padding:12px">Không có cảnh nào trong bộ lọc này.</p>';
  $('#svMore').hidden = all.length <= SV.limit;
}

async function svSaveSettings(patch) {
  try { SV.data = await api('POST', `/api/srt/${SV.cur}/settings`, patch); renderSrtMain(); } catch (e) { toast(e.message, 'error', 5000); renderSrtMain(); }
}

async function svUpload(file) {
  const r = await api('POST', '/api/refs?name=' + encodeURIComponent(file.name), undefined, file);
  return r.file;
}

async function svReadFile(file) {
  const buf = new Uint8Array(await file.arrayBuffer());
  if (buf[0] === 0xff && buf[1] === 0xfe) return new TextDecoder('utf-16le').decode(buf);
  if (buf[0] === 0xfe && buf[1] === 0xff) return new TextDecoder('utf-16be').decode(buf);
  try { return new TextDecoder('utf-8', { fatal: true }).decode(buf); } catch { return new TextDecoder('windows-1258').decode(buf); }
}

