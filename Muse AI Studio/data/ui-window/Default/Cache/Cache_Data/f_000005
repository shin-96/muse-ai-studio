/* ==================================================================== GHÉP VIDEO */
const fmtDur = (sec) => { sec = Math.max(0, Math.round(+sec || 0)); const h = Math.floor(sec / 3600), m = Math.floor(sec / 60) % 60, s = sec % 60; return h ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`; };
const mergeRunning = () => S.merge && S.merge.status === 'running';

// clip video đã xong đang được chọn (rỗng = ghép tất cả clip đã xong của dự án)
function mergeSelection() {
  return [...S.selected].map((id) => S.tasks.get(id)).filter((t) => t && t.type === 'video' && t.status === 'done');
}

function renderMergeButton() {
  const btn = $('#btnMerge'); if (!btn) return;
  const label = $('#mergeLabel'), short = $('#mergeShort');
  if (mergeRunning()) {
    label.textContent = `Đang ghép ${S.merge.progress || 0}%`;
    short.textContent = `Ghép ${S.merge.progress || 0}%`;
    btn.classList.add('busy'); btn.disabled = false; return;
  }
  btn.classList.remove('busy');
  const sel = mergeSelection();
  const allDone = [...S.tasks.values()].filter((t) => t.type === 'video' && t.status === 'done').length;
  if (sel.length) { label.textContent = `Ghép ${sel.length} clip đã chọn`; short.textContent = `Ghép ${sel.length} chọn`; btn.disabled = sel.length < 2; }
  else { label.textContent = allDone ? `Ghép tất cả (${allDone} clip)` : 'Ghép video'; short.textContent = allDone ? `Ghép (${allDone})` : 'Ghép'; btn.disabled = allDone < 2; }
  btn.title = sel.length
    ? 'Ghép các clip video đã chọn thành 1 video, theo thứ tự STT (đổi được thứ tự trong hộp ghép).'
    : 'Ghép tất cả clip video đã tạo xong của dự án thành 1 video hoàn chỉnh, theo thứ tự STT (thứ tự prompt). Muốn ghép một số clip: tích chọn clip trước.';
}

// Ước lượng lại cách ghép khi người dùng bỏ bớt clip (server vẫn quyết định cuối cùng)
function localMergePlan(clips, base) {
  if (!base || !clips.length) return base;
  const key = (c) => `${c.w}x${c.h}`;
  const count = {}; clips.forEach((c) => { count[key(c)] = (count[key(c)] || 0) + 1; });
  const top = Object.keys(count).sort((a, b) => count[b] - count[a] || clips.findIndex((c) => key(c) === a) - clips.findIndex((c) => key(c) === b))[0];
  const [w, h] = top.split('x').map(Number);
  const reasons = [];
  if (Object.keys(count).length > 1) reasons.push(`khác kích thước khung hình (${Object.keys(count).map((k) => k.replace('x', '×')).join(', ')})`);
  if (new Set(clips.map((c) => Math.round((+c.fps || 0) * 100))).size > 1) reasons.push('khác số khung hình/giây');
  const anyAudio = clips.some((c) => c.audio);
  if (anyAudio && !clips.every((c) => c.audio)) reasons.push('có clip không có tiếng');
  const mode = reasons.length ? 'reencode' : base.mode === 'copy' || clips.length < base.clipsCount ? 'copy' : base.mode;
  return { ...base, mode, width: w - (w % 2), height: h - (h % 2), reasons: reasons.length ? reasons : (mode === 'reencode' ? base.reasons : []) };
}

function mergeModeText(plan) {
  if (!plan) return '';
  return plan.mode === 'copy'
    ? `<span class="pill accent">Giữ nguyên chất lượng</span> Các clip cùng định dạng — nối thẳng, rất nhanh.`
    : `<span class="pill">Chuẩn hoá ${plan.width}×${plan.height}</span> ${esc((plan.reasons || []).join('; '))} → đưa về cùng khung hình (thêm viền đen nếu khác tỷ lệ, không méo hình).`;
}

async function openMergeDialog() {
  if (mergeRunning()) return showMergeDialog(null);
  const sel = mergeSelection();
  const data = await api('POST', '/api/merge/preview', { project_id: S.project, task_ids: sel.length ? sel.map((t) => t.id) : null });
  showMergeDialog(data, sel.length > 0);
}

function showMergeDialog(data, fromSelection = false) {
  $$('.modal-bg.merge-dlg').forEach((m) => m.remove());
