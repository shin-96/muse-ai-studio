/* ----------------------------------------------------------- tasks */
async function loadTasks() {
  if (!S.project) return;
  const list = await api('GET', '/api/tasks?project_id=' + S.project);
  S.tasks = new Map(list.map((t) => [t.id, t]));
  for (const id of [...S.selected]) if (!S.tasks.has(id)) S.selected.delete(id);
  renderTasks();
}

const statusGroup = (st) => ({ draft: 'wait', queued: 'wait', running: 'running', done: 'done', error: 'error', stopped: 'error' }[st] || 'wait');
const STATUS_LABEL = { draft: 'Mới', queued: 'Chờ chạy', running: 'Đang chạy', done: 'Hoàn thành', error: 'Lỗi', stopped: 'Đã dừng' };

function visibleTasks() {
  const q = S.search.toLowerCase();
  return [...S.tasks.values()]
    .filter((t) => S.filter === 'all' || statusGroup(t.status) === S.filter)
    .filter((t) => !q || (t.name || '').toLowerCase().includes(q) || (t.prompt || '').toLowerCase().includes(q))
    .sort((a, b) => b.stt - a.stt || b.id - a.id);
}

function accName(id) { const a = S.accounts.find((x) => x.id === id); return a ? a.name : (id ? 'TK #' + id : ''); }

function thumbHtml(t) {
  if (t.status === 'running') return `<div class="thumb spin" data-act="view" data-id="${t.id}"></div>`;
  const outs = t.outputs || [];
  if (t.status === 'done' && outs.length) {
    const o = outs[0];
    const multi = outs.length > 1 ? `<span class="multi">+${outs.length - 1}</span>` : '';
    if (o.kind === 'video') return `<div class="thumb" data-act="view" data-id="${t.id}"><video src="${fileUrl(o.path)}#t=0.5" preload="metadata" muted></video><span class="play">${ic('play')}</span></div>`;
    return `<div class="thumb" data-act="view" data-id="${t.id}"><img src="${fileUrl(o.path)}" loading="lazy" alt="">${multi}</div>`;
  }
  const r = (t.refs || [])[0];
  if (r) return `<div class="thumb" style="opacity:.55" title="Ảnh tham chiếu"><img src="${fileUrl(r.file.includes('/') || r.file.includes('\\') ? r.file : (S.refsDir || '') + r.file)}" alt="" onerror="this.remove()"></div>`;
  return `<div class="thumb">${ic(t.type === 'video' ? 'video' : 'image')}</div>`;
}

function rowHtml(t) {
  const sel = S.selected.has(t.id);
  const running = t.status === 'running';
  const isErr = t.status === 'error' || t.status === 'stopped';
  const refs = (t.refs || []).length;
  const ext = t.outputs && t.outputs[0] ? (t.outputs[0].path.match(/\.\w+$/) || [''])[0] : (t.type === 'video' ? '' : '');
  const bar = running ? `<div class="bar"><i style="width:${Math.max(3, t.progress || 0)}%"></i></div>` : '';
  const pct = running ? `${t.progress || 0}% · ` : '';
  const acts = [];
  if (running) acts.push(`<button class="icon-btn sm" data-act="stop" data-id="${t.id}" title="Dừng">${ic('square')}</button>`);
  else acts.push(`<button class="icon-btn sm" data-act="rerun" data-id="${t.id}" title="${t.status === 'done' ? 'Chạy lại' : 'Chạy'}">${ic(t.status === 'done' || isErr ? 'rotate' : 'play')}</button>`);
  acts.push(`<button class="icon-btn sm" data-act="edit" data-id="${t.id}" title="Sửa" ${running ? 'disabled' : ''}>${ic('pencil')}</button>`);
  acts.push(`<button class="icon-btn sm" data-act="view" data-id="${t.id}" title="Xem" ${t.status !== 'done' ? 'disabled style="opacity:.35"' : ''}>${ic('eye')}</button>`);
  acts.push(`<button class="icon-btn sm" data-act="reveal" data-id="${t.id}" title="Mở thư mục chứa file" ${t.status !== 'done' ? 'disabled style="opacity:.35"' : ''}>${ic('folder-open')}</button>`);
  acts.push(`<button class="icon-btn sm danger" data-act="delete" data-id="${t.id}" title="Xoá">${ic('trash')}</button>`);
  return `<div class="trow task-grid ${sel ? 'sel' : ''} ${running ? 'running' : ''}" data-id="${t.id}">
    <label class="check"><input type="checkbox" data-sel="${t.id}" ${sel ? 'checked' : ''}><span></span></label>
    <span class="stt">${pad(t.stt)}</span>
    ${thumbHtml(t)}
    <div class="tmain">
      <div class="tname">${esc(t.name)}${esc(ext)}${refs ? `<span class="refmark" title="${refs} ảnh tham chiếu">${ic('image')}${refs}</span>` : ''}</div>
      <div class="tprompt" title="${esc(t.prompt)}">${esc(t.prompt) || '<i style="opacity:.6">(không prompt — dùng ảnh)</i>'}</div>
    </div>
    <div class="ttype"><span class="k ${t.type}">${ic(t.type === 'video' ? 'video' : 'image')}${t.type === 'video' ? 'Video' : 'Ảnh'}${t.type === 'image' && t.count > 1 ? ' ×' + t.count : ''}</span><small>${esc(t.ratio)}</small></div>
    <div>${t.account_id ? `<span class="acc-chip" title="${esc(accName(t.account_id))}">${ic('user')}${esc(accName(t.account_id))}</span>` : '<span class="acc-none">—</span>'}</div>
    <div class="tstatus">
      <span class="badge ${t.status}">${STATUS_LABEL[t.status] || t.status}</span>
      ${bar}
      <div class="tmsg ${isErr ? 'err' : ''}" title="${esc(t.message || '')}">${pct}${esc(t.message || '')}</div>
    </div>
    <div class="tacts">${acts.join('')}</div>
  </div>`;
}

function renderCounts() {
  const all = [...S.tasks.values()];
  const c = { all: all.length, wait: 0, running: 0, done: 0, error: 0 };
  let img = 0, vid = 0;
  for (const t of all) { c[statusGroup(t.status)]++; if (t.type === 'video') vid++; else img++; }
  $$('#taskFilters button').forEach((b) => { $('b', b).textContent = c[b.dataset.f]; b.classList.toggle('on', b.dataset.f === S.filter); });
  $('#cntImage').textContent = img;
  $('#cntVideo').textContent = vid;
  const imageVideoCount = $('#cntImageVideo');
  if (imageVideoCount) imageVideoCount.textContent = vid;
  const doneOuts = all.reduce((n, t) => n + (t.status === 'done' ? (t.outputs || []).length : 0), 0);
  $('#projectStats').innerHTML = all.length ? `<span><b>${all.length}</b> tác vụ</span><span><b>${doneOuts}</b> file</span>${c.running ? `<span style="color:var(--accent)"><b style="color:inherit">${c.running}</b> đang chạy</span>` : ''}` : '';
  const vis = visibleTasks();
  const nSel = vis.filter((t) => S.selected.has(t.id)).length;
  const chk = $('#chkAll');
  chk.checked = vis.length > 0 && nSel === vis.length;
  chk.indeterminate = nSel > 0 && nSel < vis.length;
  $('#selLabel').textContent = S.selected.size ? `Đã chọn ${S.selected.size}` : 'Chọn tất cả';
  $$('[data-need-sel]').forEach((b) => { b.disabled = !S.selected.size; });
  $('#btnStopSel').disabled = !(c.running || c.wait) && !S.selected.size;
  renderMergeButton();
  renderLicense();
}

function renderTasks() {
  const vis = visibleTasks();
  $('#taskBody').innerHTML = vis.map(rowHtml).join('');
  $('#taskEmpty').classList.toggle('show', S.tasks.size === 0);
  if (S.tasks.size && !vis.length) $('#taskBody').innerHTML = `<div class="empty show" style="padding:50px"><p>Không có tác vụ phù hợp bộ lọc.</p></div>`;
  renderCounts();
}
const scheduleRenderTasks = debounce(renderTasks, 120);
const scheduleCounts = debounce(renderCounts, 150);

function upsertTask(t) {
  if (t.project_id !== S.project) return;
  const prev = S.tasks.get(t.id);
  S.tasks.set(t.id, t);
  const row = $(`.trow[data-id="${t.id}"]`);
  const visible = visibleTasks().some((x) => x.id === t.id);
  if (row && visible) {
    // giữ nguyên thumbnail nếu không đổi trạng thái để tránh nháy
    const tmp = document.createElement('template');
    tmp.innerHTML = rowHtml(t).trim();
    const neu = tmp.content.firstChild;
    if (prev && prev.status === t.status && JSON.stringify(prev.outputs) === JSON.stringify(t.outputs)) {
      neu.replaceChild(row.querySelector('.thumb').cloneNode(true), neu.querySelector('.thumb'));
      // cập nhật tiến độ mượt: tái dùng thanh bar cũ để có transition
      const oldBar = row.querySelector('.bar i'), newBar = neu.querySelector('.bar i');
      if (oldBar && newBar) { const w = newBar.style.width; newBar.replaceWith(oldBar); requestAnimationFrame(() => { oldBar.style.width = w; }); }
    }
    row.replaceWith(neu);
  } else if (row !== null || visible) {
    scheduleRenderTasks();
  }
  scheduleCounts();
  if (prev && prev.status !== 'done' && t.status === 'done' && S.page === 'library') loadLibraryDebounced();
}

async function taskAction(action, ids, extra = {}) {
  try {
    const r = await api('POST', '/api/tasks/action', { action, ids, project_id: S.project, ...extra });
    return r;
  } catch (e) { toast(e.message, 'error'); return null; }
}

function editTask(t) {
  let refs = [...(t.refs || [])];
  let ratio = t.ratio; let type = t.type; let count = t.count || 1;
  const refsHtml = () => refs.length ? refs.map((r, i) => `<div class="ref"><img src="${fileUrl((S.refsDir || '') + r.file)}"><b>${i + 1}</b><button data-rmref="${i}">${ic('x')}</button></div>`).join('') : '';
  openModal({
    title: `Sửa tác vụ ${t.name}`, icon: 'pencil', wide: true,
    body: `
      <div class="row-field"><span>Prompt</span><textarea class="input" id="edPrompt" rows="7">${esc(t.prompt)}</textarea></div>
      <div class="two">
        <div class="row-field"><span>Loại</span><div class="seg seg-sm" id="edType"><button data-v="image">Ảnh</button><button data-v="video">Video</button></div></div>
        <div class="row-field"><span>Số ảnh</span><div class="chips" id="edCount">${[1, 2, 3, 4].map((n) => `<button data-v="${n}">${n}</button>`).join('')}</div></div>
      </div>
      <div class="row-field"><span>Tỷ lệ</span><div class="chips" id="edRatio">${S.ratios.map((r) => `<button data-v="${r}">${r}</button>`).join('')}</div></div>
      <div class="row-field"><span>Ảnh tham chiếu <button class="link-btn" id="edAddRef">${ic('plus')}Thêm ảnh</button><input type="file" id="edRefInput" accept="image/*" multiple hidden></span>
        <div class="ref-grid" id="edRefs" style="grid-template-columns:repeat(8,1fr)"></div></div>
      <label class="check" style="margin-top:6px"><input type="checkbox" id="edRequeue" ${canGenerate(t.type) ? 'checked' : 'disabled'}><span></span><em>Lưu và đưa vào hàng đợi chạy ngay</em></label>`,
    foot: [{ label: 'Huỷ', cls: 'ghost' }, {
      label: 'Lưu', cls: 'primary', icon: 'check', onClick: async (el) => {
        const t2 = await api('PATCH', `/api/tasks/${t.id}`, { prompt: $('#edPrompt', el).value.trim(), ratio, type, count, refs, requeue: $('#edRequeue', el).checked });
        upsertTask(t2); toast('Đã lưu tác vụ', 'success');
      },
    }],
    onOpen: (el) => {
      const sync = () => {
        $$('#edType button', el).forEach((b) => b.classList.toggle('on', b.dataset.v === type));
        $$('#edCount button', el).forEach((b) => b.classList.toggle('on', +b.dataset.v === count));
        $$('#edRatio button', el).forEach((b) => b.classList.toggle('on', b.dataset.v === ratio));
        $('#edCount', el).parentElement.style.opacity = type === 'image' ? 1 : .35;
        $('#edRefs', el).innerHTML = refsHtml();
      };
      $('#edType', el).onclick = (e) => { const b = e.target.closest('button'); if (b) { type = b.dataset.v; sync(); } };
      $('#edCount', el).onclick = (e) => { const b = e.target.closest('button'); if (b) { count = +b.dataset.v; sync(); } };
      $('#edRatio', el).onclick = (e) => { const b = e.target.closest('button'); if (b) { ratio = b.dataset.v; sync(); } };
      $('#edRefs', el).onclick = (e) => { const b = e.target.closest('[data-rmref]'); if (b) { refs.splice(+b.dataset.rmref, 1); sync(); } };
      $('#edAddRef', el).onclick = () => $('#edRefInput', el).click();
      $('#edRefInput', el).onchange = async (e) => {
        for (const f of e.target.files) {
          try { const r = await api('POST', '/api/refs?name=' + encodeURIComponent(f.name), undefined, f); refs.push({ file: r.file, name: r.name }); }
          catch (err) { toast(err.message, 'error'); }
        }
        sync();
      };
      sync();
    },
  });
}

/* ==================================================================== LIGHTBOX */
function openLightbox(items, index = 0) {
  if (!items.length) return;
  let i = index;
  const lb = document.createElement('div');
  lb.className = 'lightbox';
  const render = () => {
    const it = items[i];
    const media = it.kind === 'video'
      ? `<video src="${fileUrl(it.path)}" controls autoplay loop></video>`
      : `<img src="${fileUrl(it.path)}" alt="">`;
    lb.innerHTML = `
      <div class="lb-stage">
        ${media}
        ${items.length > 1 ? `<button class="lb-nav prev">${ic('chevron-left')}</button><button class="lb-nav next">${ic('chevron-right')}</button>` : ''}
        <button class="icon-btn lb-close" title="Đóng (Esc)">${ic('x')}</button>
      </div>
      <aside class="lb-side">
        <h3>${esc(it.name)}</h3>
        <div class="lb-meta">
          <span>Loại</span><b>${it.merged ? `Video ghép (${it.clips} clip)` : it.kind === 'video' ? 'Video' : 'Ảnh'}</b>
          ${it.duration ? `<span>Thời lượng</span><b>${fmtDur(it.duration)}</b>` : ''}
          ${it.w ? `<span>Kích thước</span><b>${it.w}×${it.h}</b>` : ''}
          ${it.size ? `<span>Dung lượng</span><b>${fmtSize(it.size)}</b>` : ''}
          ${it.ratio ? `<span>Tỷ lệ</span><b>${esc(it.ratio)}</b>` : ''}
          ${it.project ? `<span>Dự án</span><b>${esc(it.project)}</b>` : ''}
          ${it.finished_at ? `<span>Hoàn thành</span><b>${fmtTime(it.finished_at)}</b>` : ''}
          <span>Vị trí</span><b>${i + 1} / ${items.length}</b>
        </div>
        ${it.prompt ? `<div class="prompt">${esc(it.prompt)}</div>` : ''}
        <div class="lb-acts">
          <button class="btn sm" data-lb="open">${ic('external')}Mở file</button>
          <button class="btn sm" data-lb="reveal">${ic('folder-open')}Thư mục</button>
          <button class="btn sm" data-lb="copy">${ic('copy')}Copy prompt</button>
          <button class="btn sm" data-lb="reuse">${ic('reuse')}Dùng lại prompt</button>
        </div>
      </aside>`;
  };
  const close = () => { lb.remove(); document.removeEventListener('keydown', onKey); };
  const go = (d) => { i = (i + d + items.length) % items.length; render(); };
  const onKey = (e) => { if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft') go(-1); if (e.key === 'ArrowRight') go(1); };
  lb.addEventListener('click', async (e) => {
    const it = items[i];
    if (e.target === lb.querySelector('.lb-stage')) return close();
    if (e.target.closest('.lb-close')) return close();
    if (e.target.closest('.prev')) return go(-1);
    if (e.target.closest('.next')) return go(1);
    const b = e.target.closest('[data-lb]');
    if (!b) return;
    const a = b.dataset.lb;
    if (a === 'open') openPath(it.path);
    if (a === 'reveal') openPath(it.path, true);
    if (a === 'copy') { await navigator.clipboard.writeText(it.prompt || '').catch(() => {}); toast('Đã copy prompt', 'success', 1500); }
    if (a === 'reuse') {
      close(); showPage('studio'); setMode(it.kind === 'video' ? 'video' : 'image');
      const ta = $('#promptInput'); ta.value = (ta.value.trim() ? ta.value.trim() + '\n' : '') + (it.prompt || ''); updateComposer(); ta.focus();
    }
  });
  document.addEventListener('keydown', onKey);
  render();
  document.body.appendChild(lb);
}

function taskMediaItems(t) {
