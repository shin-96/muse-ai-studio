/* ------------------------------------------------------------------ toast / modal */
function toast(msg, type = 'info', ms = 3200) {
  const icon = { success: 'check-circle', error: 'alert', warn: 'alert', info: 'info' }[type] || 'info';
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `${ic(icon)}<span>${esc(msg)}</span>`;
  $('#toasts').appendChild(el);
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 300); }, ms);
}

function openModal({ title, icon = 'sparkles', body = '', foot = [], wide = false, onOpen }) {
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.innerHTML = `<div class="modal ${wide ? 'wide' : ''}">
      <div class="modal-head"><h3>${ic(icon)}${esc(title)}</h3><button class="icon-btn" data-close>${ic('x')}</button></div>
      <div class="modal-body">${body}</div>
      ${foot.length ? '<div class="modal-foot"></div>' : ''}
    </div>`;
  const close = () => { bg.remove(); document.removeEventListener('keydown', onKey); };
  const onKey = (e) => { if (e.key === 'Escape') close(); };
  document.addEventListener('keydown', onKey);
  bg.addEventListener('mousedown', (e) => { if (e.target === bg) close(); });
  $('[data-close]', bg).onclick = close;
  const footEl = $('.modal-foot', bg);
  foot.forEach((b) => {
    const btn = document.createElement('button');
    btn.className = 'btn ' + (b.cls || '');
    btn.innerHTML = (b.icon ? ic(b.icon) : '') + esc(b.label);
    btn.onclick = async () => {
      if (!b.onClick) return close();
      btn.disabled = true;
      try { const r = await b.onClick(bg); if (r !== false) close(); }
      catch (e) { toast(e.message, 'error'); }
      finally { btn.disabled = false; }
    };
    footEl.appendChild(btn);
  });
  $('#modalRoot').appendChild(bg);
  hydrateIcons(bg);
  if (onOpen) onOpen(bg, close);
  setTimeout(() => { const f = $('input:not([type=hidden]),textarea', $('.modal-body', bg)); if (f) f.focus(); }, 30);
  return { el: bg, close };
}

function confirmDialog(message, { title = 'Xác nhận', ok = 'Đồng ý', danger = false } = {}) {
  return new Promise((resolve) => {
    let done = false;
    const m = openModal({
      title, icon: danger ? 'alert' : 'info', body: `<p style="margin:0;color:var(--text-2)">${message}</p>`,
      foot: [{ label: 'Huỷ', cls: 'ghost' }, { label: ok, cls: danger ? 'danger' : 'primary', onClick: () => { done = true; resolve(true); } }],
    });
    const obs = new MutationObserver(() => { if (!document.body.contains(m.el)) { obs.disconnect(); if (!done) resolve(false); } });
    obs.observe($('#modalRoot'), { childList: true });
  });
}
function promptDialog(title, value = '', { placeholder = '', icon = 'pencil', ok = 'Lưu' } = {}) {
  return new Promise((resolve) => {
    let done = false;
    const m = openModal({
      title, icon, body: `<input class="input" id="pdVal" value="${esc(value)}" placeholder="${esc(placeholder)}">`,
      foot: [{ label: 'Huỷ', cls: 'ghost' }, { label: ok, cls: 'primary', onClick: (el) => { done = true; resolve($('#pdVal', el).value.trim()); } }],
      onOpen: (el, close) => { const i = $('#pdVal', el); i.select(); i.onkeydown = (e) => { if (e.key === 'Enter') { done = true; resolve(i.value.trim()); close(); } }; },
    });
    const obs = new MutationObserver(() => { if (!document.body.contains(m.el)) { obs.disconnect(); if (!done) resolve(null); } });
    obs.observe($('#modalRoot'), { childList: true });
  });
}

